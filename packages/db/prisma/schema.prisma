generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FlightState {
  Planned
  Departed
  Airborne
  Landed
  Cancelled
}

enum NetworkType {
  VATSIM
  IVAO
  Offline
}

enum PirepStatus {
  Submitted
  Approved
  Rejected
}

enum DataSource {
  VATSIM_API
  IVAO_API
  ACARS_CLIENT
  MANUAL
  REPLAY
}

enum BookingState {
  Created
  SimBriefDispatched
  Completed
  Cancelled
  Expired
}

model Airline {
  id          String   @id @default(cuid())
  icao        String   @unique
  iata        String?  @unique
  name        String
  callsign    String?
  logoUrl     String?
  // SimBrief Override-Hierarchie Ebene 1 (lowest precedence). Per-airline
  // defaults für SimBrief-Dispatch (cont_fuel_pct, units, OFP-Layout, etc).
  // Schema: apps/web/lib/simbrief/overlay.ts SimBriefOverlaySchema. Wird
  // beim Dispatch durch Fleet/Aircraft/Route-overlays übersteuert (höhere
  // Specificity gewinnt).
  simBriefOverlay Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  ranks       Rank[]
  aircraft    Aircraft[]
  fleets      Fleet[]
  routes      Route[]
  pireps      Pirep[]
  sceneries   Scenery[]
  featureFlags FeatureFlag[]
  roleMappings DiscordRoleMapping[]
  bookings         Booking[]
  flightPlanCaches FlightPlanCache[]
  invites          Invite[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  discordId      String?  @unique

  vatsimCid              Int?      @unique
  vatsimVerifiedAt       DateTime?
  vatsimAccessToken      String?   @db.Text
  vatsimRefreshToken     String?   @db.Text
  vatsimTokenExpiresAt   DateTime?

  ivaoVid                Int?      @unique
  ivaoVerifiedAt         DateTime?
  ivaoAccessToken        String?   @db.Text
  ivaoRefreshToken       String?   @db.Text
  ivaoTokenExpiresAt     DateTime?

  // SimBrief-Account-Identifier für API-Dispatch. Wenn null, dispatcht User
  // via Browser-Fallback (prefilled URL).
  simBriefUsername       String?

  overlayToken           String?   @unique

  overlayLayout          String    @default("bar")          // "bar" | "card"
  overlayCardPosition    String    @default("top-right")
  overlayPhaseColors     Json?                              // optional override

  image            String?
  totalFlightHours Float    @default(0)
  totalFlights     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  airlineId   String?
  airline     Airline? @relation(fields: [airlineId], references: [id])
  rankId      String?
  rank        Rank?    @relation(fields: [rankId], references: [id])
  roleId      String?
  role        Role?    @relation(fields: [roleId], references: [id])

  liveSessions    LiveSession[]
  pireps          Pirep[]
  approvedPireps  Pirep[]  @relation("PirepApprover")
  awards          UserAward[]
  featureFlags    FeatureFlag[]
  accounts        Account[]
  sessions        Session[]
  emailVerified   DateTime?
  bookings        Booking[]

  invitesCreated  Invite[] @relation("InviteCreator")
  invitesUsed     Invite[] @relation("InviteUser")
}

model LiveSession {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  network              NetworkType
  externalId           Int
  callsign             String

  // ACARS Phase 1: Trennung Network (wo) vs DataSource (wer liefert)
  dataSource           DataSource  @default(VATSIM_API)
  acarsClientVersion   String?
  lastAcarsHeartbeat   DateTime?

  aircraftType         String?
  aircraftRegistration String?

  departureIcao        String?
  arrivalIcao          String?
  alternateIcao        String?
  cruiseAltitude       Int?
  flightRules          String?
  flightRoute          String?     @db.Text
  flightRemarks        String?     @db.Text

  latitude             Float
  longitude            Float
  altitude             Int
  groundSpeed          Int
  heading              Int
  transponder          String?
  onGround             Boolean     @default(false)

  connectedAt          DateTime
  lastUpdatedAt        DateTime
  isActive             Boolean     @default(true)

  positions            LiveSessionPosition[]

  @@unique([network, externalId])
  @@index([userId, isActive])
  @@index([network, isActive])
  @@index([lastUpdatedAt])
}

model LiveSessionPosition {
  id          String      @id @default(cuid())
  sessionId   String
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  latitude    Float
  longitude   Float
  altitude    Int
  groundSpeed Int
  heading     Int
  onGround    Boolean

  recordedAt  DateTime    @default(now())

  @@index([sessionId, recordedAt])
}

model Rank {
  id             String   @id @default(cuid())
  airlineId      String
  airline        Airline  @relation(fields: [airlineId], references: [id])
  name           String
  minFlightHours Float    @default(0)
  order          Int
  createdAt      DateTime @default(now())

  users        User[]
  roleMappings DiscordRoleMapping[]

  @@unique([airlineId, name])
  @@index([airlineId, order])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())

  users       User[]
  invites     Invite[]
}

model Aircraft {
  id           String   @id @default(cuid())
  airlineId    String
  airline      Airline  @relation(fields: [airlineId], references: [id])
  registration String   @unique
  type         String
  homeIcao     String?
  active       Boolean  @default(true)
  // SimBrief Override-Hierarchie Ebene 3 (per individual airframe).
  // z.B. "this specific D-AIBL has reduced MTOW because of MEL". Über-
  // steuert Airline + Fleet defaults.
  simBriefOverlay Json?
  createdAt    DateTime @default(now())

  routes Route[]
  pireps Pirep[]
}

// SimBrief Override-Hierarchie Ebene 2 — Fleet-defaults per (airline, type).
//
// Ein Fleet-row ist (airlineId, type) — z.B. (DLH, "A320") — und hält
// Defaults die für ALLE Aircraft dieses Typs in dieser Airline gelten,
// es sei denn ein einzelnes Aircraft oder ein einzelner Route überschreibt
// das Feld.
//
// Aircraft.fleetId wurde bewusst NICHT eingefügt — die Verbindung passiert
// über (airline.id, aircraft.type) lookup im resolveSimBriefOverlay-Helper.
// Vorteil: keine Migration für existierende Aircraft, keine FK-cascade-
// surprises beim Aircraft.type-rename, Fleet bleibt optional pro Type.
//
// Wenn kein Fleet-row für eine (airlineId, type) Kombination existiert,
// fällt der Helper transparent auf Airline-default zurück — d.h. Fleet
// ist eine optionale Zwischenschicht, kein Pflicht-Feld.
model Fleet {
  id              String   @id @default(cuid())
  airlineId       String
  airline         Airline  @relation(fields: [airlineId], references: [id])
  type            String   // ICAO type designator, e.g. "A320", "B738"
  simBriefOverlay Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([airlineId, type])
}

model Airport {
  id        String  @id @default(cuid())
  icao      String  @unique
  iata      String?
  name      String
  city      String?
  country   String
  latitude  Float
  longitude Float
  elevation Int?

  routesFrom Route[] @relation("RouteDeparture")
  routesTo   Route[] @relation("RouteArrival")
  pirepsFrom Pirep[] @relation("PirepDeparture")
  pirepsTo   Pirep[] @relation("PirepArrival")
}

model Route {
  id               String    @id @default(cuid())
  airlineId        String
  airline          Airline   @relation(fields: [airlineId], references: [id])
  flightNumber     String
  departureId      String
  departure        Airport   @relation("RouteDeparture", fields: [departureId], references: [id])
  arrivalId        String
  arrival          Airport   @relation("RouteArrival", fields: [arrivalId], references: [id])
  aircraftId       String?
  aircraft         Aircraft? @relation(fields: [aircraftId], references: [id])
  estimatedMinutes Int
  distanceNm       Int
  active           Boolean   @default(true)
  // SimBrief Override-Hierarchie Ebene 4 (highest precedence). Per-route
  // overrides — z.B. "the cargo run to LFPG carries 0 pax + extra fuel".
  // Übersteuert alle anderen Ebenen.
  simBriefOverlay Json?
  createdAt        DateTime  @default(now())

  pireps Pirep[]
  bookings         Booking[]

  @@unique([airlineId, flightNumber])
  @@index([departureId])
  @@index([arrivalId])
}

model Pirep {
  id              String      @id @default(cuid())
  airlineId       String
  airline         Airline     @relation(fields: [airlineId], references: [id])
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  routeId         String?
  route           Route?      @relation(fields: [routeId], references: [id])
  aircraftId      String?
  aircraft        Aircraft?   @relation(fields: [aircraftId], references: [id])
  departureId     String
  departure       Airport     @relation("PirepDeparture", fields: [departureId], references: [id])
  arrivalId       String
  arrival         Airport     @relation("PirepArrival", fields: [arrivalId], references: [id])
  state           FlightState @default(Planned)
  network         NetworkType @default(Offline)
  status          PirepStatus @default(Submitted)
  flightTimeMin   Int?
  fuelUsedKg      Int?
  landingRateFpm  Int?
  remarks         String?
  submittedAt     DateTime    @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approvedById    String?
  approver        User?       @relation("PirepApprover", fields: [approvedById], references: [id])
  // 1:1 — eine Booking hat max. einen abschließenden PIREP. DB-level Uniqueness
  // schützt vor Doppel-Submit-Race-Conditions; bei v2 Multi-Leg wird ein eigenes
  // Booking-Parent/Leg-Children-Pattern entstehen, nicht 1:n hier.
  bookingId       String?     @unique
  booking         Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  flightPlanCache FlightPlanCache?

  @@index([userId, submittedAt])
  @@index([airlineId, status])
  @@index([approvedById])
}

model Award {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconUrl     String?
  criteria    Json?
  createdAt   DateTime @default(now())

  userAwards UserAward[]
}

model UserAward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  awardId   String
  award     Award    @relation(fields: [awardId], references: [id])
  awardedAt DateTime @default(now())

  @@unique([userId, awardId])
}

model Scenery {
  id          String   @id @default(cuid())
  airlineId   String?
  airline     Airline? @relation(fields: [airlineId], references: [id])
  name        String
  airportIcao String?
  provider    String?
  url         String?
  free        Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model FeatureFlag {
  id        String   @id @default(cuid())
  airlineId String?
  airline   Airline? @relation(fields: [airlineId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([airlineId, userId, key])
}

model DiscordRoleMapping {
  id             String   @id @default(cuid())
  airlineId      String
  airline        Airline  @relation(fields: [airlineId], references: [id])
  rankId         String?
  rank           Rank?    @relation(fields: [rankId], references: [id])
  discordRoleId  String
  discordGuildId String
  createdAt      DateTime @default(now())

  @@unique([airlineId, discordRoleId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Booking {
  id              String       @id @default(cuid())
  airlineId       String
  airline         Airline      @relation(fields: [airlineId], references: [id])
  userId          String
  user            User         @relation(fields: [userId], references: [id])

  // Required + onDelete: Restrict (default). Booking ohne Route ist Nonsense-State.
  // Hard-Delete einer Route erfordert vorheriges Cancel/Expire aller referenzierenden Bookings
  // — bewusste Operational Hygiene, nicht Bug.
  routeId         String
  route           Route        @relation(fields: [routeId], references: [id])

  state           BookingState @default(Created)

  // Hint für UI/Filter, kein Hard-Lock — actual Network kommt vom PIREP/LiveSession
  intendedNetwork NetworkType?

  // Geplante Abflugzeit (UTC). Optional — wenn null, dispatcht User ohne
  // schedule (SimBrief defaultet auf "next available departure"). Wenn
  // gesetzt, propagieren wir es als deph/depm/date in den Pattern α + Z
  // Dispatch-URLs damit SimBrief mit der richtigen METAR/TAF und Tageszeit
  // plant. v1: immutable nach booking-creation. Edit-flow käme mit dem
  // Booking-Edit-Pattern Phase 2.
  scheduledDeparture DateTime?

  dispatchedAt      DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime  // app-level: createdAt + 7d in v1
  cancelledAt        DateTime?
  cancellationReason String?

  pirep              Pirep?
  flightPlanCache    FlightPlanCache?

  @@index([userId, state])
  @@index([airlineId, state])
  @@index([routeId])
  @@index([expiresAt])
}

// Pattern α Cache-Architecture — per-Booking ownership.
// Each Booking has at most ONE FlightPlanCache (1:0..1 via @unique bookingId).
// Lifecycle-Vorbereitung: bei PIREP-File transferiert sich der Cache vom
// Booking zum Pirep (Phase 2 Implementation). bookingId wird auf null gesetzt,
// pirepId wird gesetzt. Cache überlebt damit Booking-Stornierung wenn ein
// PIREP existiert.
//
// Multi-Tenancy: airlineId bleibt explicit field (nicht via Booking-Join
// derived) für direct queries + index-effizientes Filtering.
//
// SimBrief weather TTL — 6h hardcoded weil physikalisch, nicht airline-policy.
model FlightPlanCache {
  id            String   @id @default(cuid())
  airlineId     String
  airline       Airline  @relation(fields: [airlineId], references: [id])
  bookingId     String?  @unique
  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pirepId       String?  @unique
  pirep         Pirep?   @relation(fields: [pirepId], references: [id], onDelete: SetNull)

  ofpId         String
  rawResponse   Json
  routeString   String?  @db.Text
  fuelKg        Int?
  blockTimeMin  Int?

  generatedAt   DateTime @default(now())
  expiresAt     DateTime

  @@index([airlineId])
  @@index([expiresAt])
}

// Invite-Tokens für User-Onboarding zu einer Airline. Admin generiert ein
// Invite, schickt den Link manuell (Discord-DM, Email) an den potenziellen
// Pilot. Beim Klick:
//   1. Wenn nicht eingeloggt → Discord-OAuth-Login mit callbackUrl=/invite/[token]
//   2. Nach Login: validate token (existiert, nicht expired, nicht used)
//   3. User klickt "Annehmen" → User.airlineId + (optional) User.roleId gesetzt
//   4. Invite.usedAt + usedById gesetzt → Token nicht mehr nutzbar
//
// Lifecycle:
//   - createdAt + 7d default expiry (kann override werden)
//   - usedAt = null → pending; usedAt != null → used (terminal)
//   - admin kann pending-invite revoken via setExpiresAt(now)
//
// Security:
//   - token = cuid(), 25-char unguessable, unique-indexed
//   - email-field optional, only as hint für admin (welcher pilot war
//     gemeint?), wird NICHT validiert beim accept (wir trust den
//     Discord-OAuth-Identity vom session)
//   - Token-Replay: usedAt-Check ist die einzige Defense — first-accept-wins
model Invite {
  id          String    @id @default(cuid())
  token       String    @unique // URL-safe random token (cuid format)

  // Pre-fill / Hint — der Admin trägt ein wer eingeladen wurde, aber das
  // wird beim accept NICHT als gate genutzt. User-Identity kommt aus
  // dem authenticated NextAuth-session.
  email       String?

  airlineId   String
  airline     Airline   @relation(fields: [airlineId], references: [id])

  // Wenn null → User wird nur airline-zugewiesen, role muss admin später
  // manuell setzen (oder der User behält null-role und ist ein "pending pilot").
  roleId      String?
  role        Role?     @relation(fields: [roleId], references: [id])

  expiresAt   DateTime
  usedAt      DateTime? // null = pending; != null = used or revoked

  // Wer hat das Invite erstellt
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])

  // Wer hat das Invite eingelöst (null wenn pending)
  usedById    String?
  usedBy      User?     @relation("InviteUser", fields: [usedById], references: [id])

  createdAt   DateTime  @default(now())

  @@index([airlineId, usedAt])
  @@index([token])
  @@index([expiresAt])
}

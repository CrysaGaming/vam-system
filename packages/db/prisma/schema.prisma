generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FlightState {
  Planned
  Departed
  Airborne
  Landed
  Cancelled
}

enum NetworkType {
  VATSIM
  IVAO
  Offline
}

enum PirepStatus {
  Submitted
  Approved
  Rejected
}

enum DataSource {
  VATSIM_API
  IVAO_API
  ACARS_CLIENT
  MANUAL
  REPLAY
}

enum BookingState {
  Created
  SimBriefDispatched
  Completed
  Cancelled
  Expired
}

model Airline {
  id          String   @id @default(cuid())
  icao        String   @unique
  iata        String?  @unique
  name        String
  callsign    String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  ranks       Rank[]
  aircraft    Aircraft[]
  routes      Route[]
  pireps      Pirep[]
  sceneries   Scenery[]
  featureFlags FeatureFlag[]
  roleMappings DiscordRoleMapping[]
  bookings         Booking[]
  flightPlanCaches FlightPlanCache[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  discordId      String?  @unique

  vatsimCid              Int?      @unique
  vatsimVerifiedAt       DateTime?
  vatsimAccessToken      String?   @db.Text
  vatsimRefreshToken     String?   @db.Text
  vatsimTokenExpiresAt   DateTime?

  ivaoVid                Int?      @unique
  ivaoVerifiedAt         DateTime?
  ivaoAccessToken        String?   @db.Text
  ivaoRefreshToken       String?   @db.Text
  ivaoTokenExpiresAt     DateTime?

  overlayToken           String?   @unique

  overlayLayout          String    @default("bar")          // "bar" | "card"
  overlayCardPosition    String    @default("top-right")
  overlayPhaseColors     Json?                              // optional override

  image            String?
  totalFlightHours Float    @default(0)
  totalFlights     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  airlineId   String?
  airline     Airline? @relation(fields: [airlineId], references: [id])
  rankId      String?
  rank        Rank?    @relation(fields: [rankId], references: [id])
  roleId      String?
  role        Role?    @relation(fields: [roleId], references: [id])

  liveSessions    LiveSession[]
  pireps          Pirep[]
  approvedPireps  Pirep[]  @relation("PirepApprover")
  awards          UserAward[]
  featureFlags    FeatureFlag[]
  accounts        Account[]
  sessions        Session[]
  emailVerified   DateTime?
  bookings        Booking[]
}

model LiveSession {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  network              NetworkType
  externalId           Int
  callsign             String

  // ACARS Phase 1: Trennung Network (wo) vs DataSource (wer liefert)
  dataSource           DataSource  @default(VATSIM_API)
  acarsClientVersion   String?
  lastAcarsHeartbeat   DateTime?

  aircraftType         String?
  aircraftRegistration String?

  departureIcao        String?
  arrivalIcao          String?
  alternateIcao        String?
  cruiseAltitude       Int?
  flightRules          String?
  flightRoute          String?     @db.Text
  flightRemarks        String?     @db.Text

  latitude             Float
  longitude            Float
  altitude             Int
  groundSpeed          Int
  heading              Int
  transponder          String?
  onGround             Boolean     @default(false)

  connectedAt          DateTime
  lastUpdatedAt        DateTime
  isActive             Boolean     @default(true)

  positions            LiveSessionPosition[]

  @@unique([network, externalId])
  @@index([userId, isActive])
  @@index([network, isActive])
  @@index([lastUpdatedAt])
}

model LiveSessionPosition {
  id          String      @id @default(cuid())
  sessionId   String
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  latitude    Float
  longitude   Float
  altitude    Int
  groundSpeed Int
  heading     Int
  onGround    Boolean

  recordedAt  DateTime    @default(now())

  @@index([sessionId, recordedAt])
}

model Rank {
  id             String   @id @default(cuid())
  airlineId      String
  airline        Airline  @relation(fields: [airlineId], references: [id])
  name           String
  minFlightHours Float    @default(0)
  order          Int
  createdAt      DateTime @default(now())

  users        User[]
  roleMappings DiscordRoleMapping[]

  @@unique([airlineId, name])
  @@index([airlineId, order])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())

  users       User[]
}

model Aircraft {
  id           String   @id @default(cuid())
  airlineId    String
  airline      Airline  @relation(fields: [airlineId], references: [id])
  registration String   @unique
  type         String
  homeIcao     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  routes Route[]
  pireps Pirep[]
}

model Airport {
  id        String  @id @default(cuid())
  icao      String  @unique
  iata      String?
  name      String
  city      String?
  country   String
  latitude  Float
  longitude Float
  elevation Int?

  routesFrom Route[] @relation("RouteDeparture")
  routesTo   Route[] @relation("RouteArrival")
  pirepsFrom Pirep[] @relation("PirepDeparture")
  pirepsTo   Pirep[] @relation("PirepArrival")
}

model Route {
  id               String    @id @default(cuid())
  airlineId        String
  airline          Airline   @relation(fields: [airlineId], references: [id])
  flightNumber     String
  departureId      String
  departure        Airport   @relation("RouteDeparture", fields: [departureId], references: [id])
  arrivalId        String
  arrival          Airport   @relation("RouteArrival", fields: [arrivalId], references: [id])
  aircraftId       String?
  aircraft         Aircraft? @relation(fields: [aircraftId], references: [id])
  estimatedMinutes Int
  distanceNm       Int
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  pireps Pirep[]
  bookings         Booking[]
  flightPlanCaches FlightPlanCache[]

  @@unique([airlineId, flightNumber])
  @@index([departureId])
  @@index([arrivalId])
}

model Pirep {
  id              String      @id @default(cuid())
  airlineId       String
  airline         Airline     @relation(fields: [airlineId], references: [id])
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  routeId         String?
  route           Route?      @relation(fields: [routeId], references: [id])
  aircraftId      String?
  aircraft        Aircraft?   @relation(fields: [aircraftId], references: [id])
  departureId     String
  departure       Airport     @relation("PirepDeparture", fields: [departureId], references: [id])
  arrivalId       String
  arrival         Airport     @relation("PirepArrival", fields: [arrivalId], references: [id])
  state           FlightState @default(Planned)
  network         NetworkType @default(Offline)
  status          PirepStatus @default(Submitted)
  flightTimeMin   Int?
  fuelUsedKg      Int?
  landingRateFpm  Int?
  remarks         String?
  submittedAt     DateTime    @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approvedById    String?
  approver        User?       @relation("PirepApprover", fields: [approvedById], references: [id])
  // 1:1 — eine Booking hat max. einen abschließenden PIREP. DB-level Uniqueness
  // schützt vor Doppel-Submit-Race-Conditions; bei v2 Multi-Leg wird ein eigenes
  // Booking-Parent/Leg-Children-Pattern entstehen, nicht 1:n hier.
  bookingId       String?     @unique
  booking         Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, submittedAt])
  @@index([airlineId, status])
  @@index([approvedById])
}

model Award {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconUrl     String?
  criteria    Json?
  createdAt   DateTime @default(now())

  userAwards UserAward[]
}

model UserAward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  awardId   String
  award     Award    @relation(fields: [awardId], references: [id])
  awardedAt DateTime @default(now())

  @@unique([userId, awardId])
}

model Scenery {
  id          String   @id @default(cuid())
  airlineId   String?
  airline     Airline? @relation(fields: [airlineId], references: [id])
  name        String
  airportIcao String?
  provider    String?
  url         String?
  free        Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model FeatureFlag {
  id        String   @id @default(cuid())
  airlineId String?
  airline   Airline? @relation(fields: [airlineId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([airlineId, userId, key])
}

model DiscordRoleMapping {
  id             String   @id @default(cuid())
  airlineId      String
  airline        Airline  @relation(fields: [airlineId], references: [id])
  rankId         String?
  rank           Rank?    @relation(fields: [rankId], references: [id])
  discordRoleId  String
  discordGuildId String
  createdAt      DateTime @default(now())

  @@unique([airlineId, discordRoleId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Booking {
  id              String       @id @default(cuid())
  airlineId       String
  airline         Airline      @relation(fields: [airlineId], references: [id])
  userId          String
  user            User         @relation(fields: [userId], references: [id])

  // Required + onDelete: Restrict (default). Booking ohne Route ist Nonsense-State.
  // Hard-Delete einer Route erfordert vorheriges Cancel/Expire aller referenzierenden Bookings
  // — bewusste Operational Hygiene, nicht Bug.
  routeId         String
  route           Route        @relation(fields: [routeId], references: [id])

  state           BookingState @default(Created)

  // Hint für UI/Filter, kein Hard-Lock — actual Network kommt vom PIREP/LiveSession
  intendedNetwork NetworkType?

  flightPlanCacheId String?
  flightPlanCache   FlightPlanCache? @relation(fields: [flightPlanCacheId], references: [id], onDelete: SetNull)
  simBriefOfpId     String?
  dispatchedAt      DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime  // app-level: createdAt + 7d in v1
  cancelledAt        DateTime?
  cancellationReason String?

  pirep              Pirep?

  @@index([userId, state])
  @@index([airlineId, state])
  @@index([routeId])
  @@index([expiresAt])
}

// v1-Limitation: Cache-Key ist (routeId, aircraftType) — KEINE per-User-SimBrief-Settings.
// Alle User einer Airline kriegen denselben OFP für gleiche Route+Aircraft, unabhängig
// von Fuel-Policy / Units / Layout-Präferenzen. Wenn das in v2 problematisch wird,
// muss der Cache-Key user- bzw. setting-hash-aware werden.
model FlightPlanCache {
  id            String   @id @default(cuid())
  airlineId     String
  airline       Airline  @relation(fields: [airlineId], references: [id])
  routeId       String
  route         Route    @relation(fields: [routeId], references: [id])
  aircraftType  String   // ICAO type code (A320, B738), nicht Aircraft-PK

  ofpId         String
  rawResponse   Json
  routeString   String?  @db.Text
  fuelKg        Int?
  blockTimeMin  Int?

  generatedAt   DateTime @default(now())
  // SimBrief weather TTL — hardcoded weil physikalisch, nicht airline-policy.
  // app-level: generatedAt + 6h in v1.
  expiresAt     DateTime

  bookings      Booking[]

  @@index([routeId, aircraftType, expiresAt])
  @@index([airlineId])
  @@index([expiresAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FlightState {
  Planned
  Departed
  Airborne
  Landed
  Cancelled
}

enum NetworkType {
  VATSIM
  IVAO
  Offline
}

enum PirepStatus {
  Submitted
  Approved
  Rejected
}

enum DataSource {
  VATSIM_API
  IVAO_API
  ACARS_CLIENT
  MANUAL
  REPLAY
}

enum BookingState {
  Created
  SimBriefDispatched
  Completed
  Cancelled
  Expired
}

// State-machine für AirportRequest und AircraftTypeRequest. Mirrors PIREP-
// pattern (Submitted → Approved/Rejected) mit Erweiterung UnderReview.
// Approval ist binär hier, aber via `approvedAsVerified` Boolean auf den
// Request-models in zwei Tiers: verified (system-admin hat daten geprüft)
// vs unverified (provisional, mit warning-badge im UI).
enum RequestStatus {
  Submitted
  UnderReview
  Approved
  Rejected
}

model Airline {
  id              String   @id @default(cuid())
  icao            String   @unique
  iata            String?  @unique
  name            String
  callsign        String?
  logoUrl         String?
  // SimBrief Override-Hierarchie Ebene 1 (lowest precedence). Per-airline
  // defaults für SimBrief-Dispatch (cont_fuel_pct, units, OFP-Layout, etc).
  // Schema: apps/web/lib/simbrief/overlay.ts SimBriefOverlaySchema. Wird
  // beim Dispatch durch Fleet/Aircraft/Route-overlays übersteuert (höhere
  // Specificity gewinnt).
  simBriefOverlay Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users            User[]
  ranks            Rank[]
  aircraft         Aircraft[]
  fleets           Fleet[]
  routes           Route[]
  pireps           Pirep[]
  sceneries        Scenery[]
  featureFlags     FeatureFlag[]
  roleMappings     DiscordRoleMapping[]
  bookings         Booking[]
  flightPlanCaches FlightPlanCache[]
  invites          Invite[]

  // System-Catalog Request-Flow — eine Airline kann mehrere Requests
  // einreichen. Optional FK auf Request damit auch user-ohne-airline
  // (z.B. solo-pilot vor airline-zuweisung) requests stellen können.
  airportRequests      AirportRequest[]      @relation("AirportRequestAirline")
  aircraftTypeRequests AircraftTypeRequest[] @relation("AircraftTypeRequestAirline")
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  name      String?
  discordId String? @unique

  vatsimCid            Int?      @unique
  vatsimVerifiedAt     DateTime?
  vatsimAccessToken    String?   @db.Text
  vatsimRefreshToken   String?   @db.Text
  vatsimTokenExpiresAt DateTime?

  ivaoVid            Int?      @unique
  ivaoVerifiedAt     DateTime?
  ivaoAccessToken    String?   @db.Text
  ivaoRefreshToken   String?   @db.Text
  ivaoTokenExpiresAt DateTime?

  // SimBrief-Account-Identifier für API-Dispatch. Wenn null, dispatcht User
  // via Browser-Fallback (prefilled URL).
  simBriefUsername String?

  overlayToken String? @unique

  overlayLayout       String @default("bar") // "bar" | "card"
  overlayCardPosition String @default("top-right")
  overlayPhaseColors  Json? // optional override

  image            String?
  totalFlightHours Float    @default(0)
  totalFlights     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  airlineId String?
  airline   Airline? @relation(fields: [airlineId], references: [id])
  rankId    String?
  rank      Rank?    @relation(fields: [rankId], references: [id])
  roleId    String?
  role      Role?    @relation(fields: [roleId], references: [id])

  liveSessions   LiveSession[]
  pireps         Pirep[]
  approvedPireps Pirep[]       @relation("PirepApprover")
  awards         UserAward[]
  featureFlags   FeatureFlag[]
  accounts       Account[]
  sessions       Session[]
  emailVerified  DateTime?
  bookings       Booking[]

  invitesCreated Invite[] @relation("InviteCreator")
  invitesUsed    Invite[] @relation("InviteUser")

  // System-Catalog Request-Flow — Audit-Trail Beziehungen.
  // Ein User kann gleichzeitig Submitter (airline-admin) und Reviewer
  // (system-admin) sein wenn er beide Rollen hat. Verifier ist immer
  // system-admin (gate via Role.permissions check).
  airportRequests       AirportRequest[]      @relation("AirportRequester")
  airportReviews        AirportRequest[]      @relation("AirportReviewer")
  verifiedAirports      Airport[]             @relation("AirportVerifier")
  aircraftTypeRequests  AircraftTypeRequest[] @relation("AircraftTypeRequester")
  aircraftTypeReviews   AircraftTypeRequest[] @relation("AircraftTypeReviewer")
  verifiedAircraftTypes AircraftType[]        @relation("AircraftTypeVerifier")
}

model LiveSession {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  network    NetworkType
  externalId Int
  callsign   String

  // ACARS Phase 1: Trennung Network (wo) vs DataSource (wer liefert)
  dataSource         DataSource @default(VATSIM_API)
  acarsClientVersion String?
  lastAcarsHeartbeat DateTime?

  aircraftType         String?
  aircraftRegistration String?

  departureIcao  String?
  arrivalIcao    String?
  alternateIcao  String?
  cruiseAltitude Int?
  flightRules    String?
  flightRoute    String? @db.Text
  flightRemarks  String? @db.Text

  latitude    Float
  longitude   Float
  altitude    Int
  groundSpeed Int
  heading     Int
  transponder String?
  onGround    Boolean @default(false)

  connectedAt   DateTime
  lastUpdatedAt DateTime
  isActive      Boolean  @default(true)

  positions LiveSessionPosition[]

  @@unique([network, externalId])
  @@index([userId, isActive])
  @@index([network, isActive])
  @@index([lastUpdatedAt])
}

model LiveSessionPosition {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  latitude    Float
  longitude   Float
  altitude    Int
  groundSpeed Int
  heading     Int
  onGround    Boolean

  recordedAt DateTime @default(now())

  @@index([sessionId, recordedAt])
}

model Rank {
  id             String   @id @default(cuid())
  airlineId      String
  airline        Airline  @relation(fields: [airlineId], references: [id])
  name           String
  minFlightHours Float    @default(0)
  order          Int
  createdAt      DateTime @default(now())

  users        User[]
  roleMappings DiscordRoleMapping[]

  @@unique([airlineId, name])
  @@index([airlineId, order])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())

  users   User[]
  invites Invite[]
}

model Aircraft {
  id              String        @id @default(cuid())
  airlineId       String
  airline         Airline       @relation(fields: [airlineId], references: [id])
  registration    String        @unique
  type            String
  // FK zu System-curated AircraftType-Catalog. Nullable für 1-Release-
  // Migration: existing airframes haben nur `type: String`, neue Logik
  // resolves via aircraftTypeId mit Fallback auf type-string-match.
  // Backfill-Script in Phase 1 matched bestehende `type` strings gegen
  // AircraftType.icaoType seed.
  aircraftTypeId  String?
  aircraftType    AircraftType? @relation(fields: [aircraftTypeId], references: [id])
  homeIcao        String?
  active          Boolean       @default(true)
  // SimBrief Override-Hierarchie Ebene 3 (per individual airframe).
  // z.B. "this specific D-AIBL has reduced MTOW because of MEL". Über-
  // steuert Airline + Fleet defaults.
  simBriefOverlay Json?
  createdAt       DateTime      @default(now())

  routes Route[]
  pireps Pirep[]
}

// SimBrief Override-Hierarchie Ebene 2 — Fleet-defaults per (airline, type).
//
// Ein Fleet-row ist (airlineId, type) — z.B. (DLH, "A320") — und hält
// Defaults die für ALLE Aircraft dieses Typs in dieser Airline gelten,
// es sei denn ein einzelnes Aircraft oder ein einzelner Route überschreibt
// das Feld.
//
// Aircraft.fleetId wurde bewusst NICHT eingefügt — die Verbindung passiert
// über (airline.id, aircraft.type) lookup im resolveSimBriefOverlay-Helper.
// Vorteil: keine Migration für existierende Aircraft, keine FK-cascade-
// surprises beim Aircraft.type-rename, Fleet bleibt optional pro Type.
//
// Wenn kein Fleet-row für eine (airlineId, type) Kombination existiert,
// fällt der Helper transparent auf Airline-default zurück — d.h. Fleet
// ist eine optionale Zwischenschicht, kein Pflicht-Feld.
model Fleet {
  id              String   @id @default(cuid())
  airlineId       String
  airline         Airline  @relation(fields: [airlineId], references: [id])
  type            String // ICAO type designator, e.g. "A320", "B738"
  simBriefOverlay Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([airlineId, type])
}

model Airport {
  id        String  @id @default(cuid())
  icao      String  @unique
  iata      String?
  name      String
  city      String?
  country   String
  latitude  Float
  longitude Float
  elevation Int?

  // OurAirports.com taxonomy fields. Eingeführt mit dem ~85k-airport-bulk-
  // import. `type` ist eine kontrollierte enum (large_airport | medium_airport
  // | small_airport | heliport | seaplane_base | balloonport | closed) — als
  // String statt enum, damit OurAirports neue typen einführen kann ohne migration.
  // `continent` ist 2-letter ISO continent code (NA/EU/AS/AF/OC/SA/AN).
  // `scheduledService` = ob der airport regelmäßigen kommerziellen flug-
  // verkehr hat — wichtigster filter für virtual-airline-kontext, weil die
  // meisten heliports/balloonports/closed nicht für VAM-routes interessant sind.
  // Alle nullable damit existing rows (vor migration) nicht brechen.
  type             String?
  continent        String?
  scheduledService Boolean @default(false)
  gpsCode          String?
  wikipediaLink    String?

  // System-curated catalog: airline-admins können einzelne airports nicht
  // direkt anlegen; sie reichen einen AirportRequest ein, system-admin
  // approved/rejects. `verified` = system-admin hat die daten geprüft;
  // `false` = provisional (UI zeigt warning-badge). `active=false` ist
  // soft-delete (z.B. flughafen geschlossen) ohne FK-cascades zu brechen.
  active                Boolean         @default(true)
  verified              Boolean         @default(false)
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?           @relation("AirportVerifier", fields: [verifiedById], references: [id])
  // Nullable + unique: 1:1 zu AirportRequest. Null wenn airport direkt von
  // system-admin angelegt wurde (kein request-flow); set wenn aus approve-
  // request-creation. Audit-trail über die request-relation.
  proposedFromRequestId String?         @unique
  proposedFromRequest   AirportRequest? @relation("AirportFromRequest", fields: [proposedFromRequestId], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  routesFrom Route[] @relation("RouteDeparture")
  routesTo   Route[] @relation("RouteArrival")
  pirepsFrom Pirep[] @relation("PirepDeparture")
  pirepsTo   Pirep[] @relation("PirepArrival")

  // Detail-tabellen aus OurAirports.com — runways/frequencies/navaids als
  // separate models statt JSON-blobs damit sie indexierbar/durchsuchbar
  // sind (z.B. "alle airports mit ILS auf einer 3000m+ runway"). Cascade
  // delete: wenn ein airport gelöscht wird, gehen seine runways/freqs mit.
  // Navaids haben optional FK weil manche standalone-stations sind.
  runways     Runway[]
  frequencies AirportFrequency[]
  navaids     Navaid[]           @relation("NavaidAssociatedAirport")

  // Indexes für die /airports filter-UI: type/continent/country erlauben
  // schnelle multi-faceted queries auf 85k entries; scheduledService trennt
  // commercial- von hobby-airports.
  @@index([type])
  @@index([continent])
  @@index([country])
  @@index([scheduledService])
}

model Route {
  id               String    @id @default(cuid())
  airlineId        String
  airline          Airline   @relation(fields: [airlineId], references: [id])
  flightNumber     String
  departureId      String
  departure        Airport   @relation("RouteDeparture", fields: [departureId], references: [id])
  arrivalId        String
  arrival          Airport   @relation("RouteArrival", fields: [arrivalId], references: [id])
  aircraftId       String?
  aircraft         Aircraft? @relation(fields: [aircraftId], references: [id])
  estimatedMinutes Int
  distanceNm       Int
  active           Boolean   @default(true)
  // SimBrief Override-Hierarchie Ebene 4 (highest precedence). Per-route
  // overrides — z.B. "the cargo run to LFPG carries 0 pax + extra fuel".
  // Übersteuert alle anderen Ebenen.
  simBriefOverlay  Json?
  createdAt        DateTime  @default(now())

  pireps   Pirep[]
  bookings Booking[]

  @@unique([airlineId, flightNumber])
  @@index([departureId])
  @@index([arrivalId])
}

model Pirep {
  id              String           @id @default(cuid())
  airlineId       String
  airline         Airline          @relation(fields: [airlineId], references: [id])
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  routeId         String?
  route           Route?           @relation(fields: [routeId], references: [id])
  aircraftId      String?
  aircraft        Aircraft?        @relation(fields: [aircraftId], references: [id])
  departureId     String
  departure       Airport          @relation("PirepDeparture", fields: [departureId], references: [id])
  arrivalId       String
  arrival         Airport          @relation("PirepArrival", fields: [arrivalId], references: [id])
  state           FlightState      @default(Planned)
  network         NetworkType      @default(Offline)
  status          PirepStatus      @default(Submitted)
  flightTimeMin   Int?
  fuelUsedKg      Int?
  landingRateFpm  Int?
  remarks         String?
  submittedAt     DateTime         @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approvedById    String?
  approver        User?            @relation("PirepApprover", fields: [approvedById], references: [id])
  // 1:1 — eine Booking hat max. einen abschließenden PIREP. DB-level Uniqueness
  // schützt vor Doppel-Submit-Race-Conditions; bei v2 Multi-Leg wird ein eigenes
  // Booking-Parent/Leg-Children-Pattern entstehen, nicht 1:n hier.
  bookingId       String?          @unique
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  flightPlanCache FlightPlanCache?

  @@index([userId, submittedAt])
  @@index([airlineId, status])
  @@index([approvedById])
}

model Award {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconUrl     String?
  criteria    Json?
  createdAt   DateTime @default(now())

  userAwards UserAward[]
}

model UserAward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  awardId   String
  award     Award    @relation(fields: [awardId], references: [id])
  awardedAt DateTime @default(now())

  @@unique([userId, awardId])
}

model Scenery {
  id          String   @id @default(cuid())
  airlineId   String?
  airline     Airline? @relation(fields: [airlineId], references: [id])
  name        String
  airportIcao String?
  provider    String?
  url         String?
  free        Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model FeatureFlag {
  id        String   @id @default(cuid())
  airlineId String?
  airline   Airline? @relation(fields: [airlineId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([airlineId, userId, key])
}

model DiscordRoleMapping {
  id             String   @id @default(cuid())
  airlineId      String
  airline        Airline  @relation(fields: [airlineId], references: [id])
  rankId         String?
  rank           Rank?    @relation(fields: [rankId], references: [id])
  discordRoleId  String
  discordGuildId String
  createdAt      DateTime @default(now())

  @@unique([airlineId, discordRoleId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Booking {
  id        String  @id @default(cuid())
  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  // Required + onDelete: Restrict (default). Booking ohne Route ist Nonsense-State.
  // Hard-Delete einer Route erfordert vorheriges Cancel/Expire aller referenzierenden Bookings
  // — bewusste Operational Hygiene, nicht Bug.
  routeId String
  route   Route  @relation(fields: [routeId], references: [id])

  state BookingState @default(Created)

  // Hint für UI/Filter, kein Hard-Lock — actual Network kommt vom PIREP/LiveSession
  intendedNetwork NetworkType?

  // Geplante Abflugzeit (UTC). Optional — wenn null, dispatcht User ohne
  // schedule (SimBrief defaultet auf "next available departure"). Wenn
  // gesetzt, propagieren wir es als deph/depm/date in den Pattern α + Z
  // Dispatch-URLs damit SimBrief mit der richtigen METAR/TAF und Tageszeit
  // plant. v1: immutable nach booking-creation. Edit-flow käme mit dem
  // Booking-Edit-Pattern Phase 2.
  scheduledDeparture DateTime?

  dispatchedAt DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime // app-level: createdAt + 7d in v1
  cancelledAt        DateTime?
  cancellationReason String?

  pirep           Pirep?
  flightPlanCache FlightPlanCache?

  @@index([userId, state])
  @@index([airlineId, state])
  @@index([routeId])
  @@index([expiresAt])
}

// Pattern α Cache-Architecture — per-Booking ownership.
// Each Booking has at most ONE FlightPlanCache (1:0..1 via @unique bookingId).
// Lifecycle-Vorbereitung: bei PIREP-File transferiert sich der Cache vom
// Booking zum Pirep (Phase 2 Implementation). bookingId wird auf null gesetzt,
// pirepId wird gesetzt. Cache überlebt damit Booking-Stornierung wenn ein
// PIREP existiert.
//
// Multi-Tenancy: airlineId bleibt explicit field (nicht via Booking-Join
// derived) für direct queries + index-effizientes Filtering.
//
// SimBrief weather TTL — 6h hardcoded weil physikalisch, nicht airline-policy.
model FlightPlanCache {
  id        String   @id @default(cuid())
  airlineId String
  airline   Airline  @relation(fields: [airlineId], references: [id])
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pirepId   String?  @unique
  pirep     Pirep?   @relation(fields: [pirepId], references: [id], onDelete: SetNull)

  ofpId        String
  rawResponse  Json
  routeString  String? @db.Text
  fuelKg       Int?
  blockTimeMin Int?

  generatedAt DateTime @default(now())
  expiresAt   DateTime

  @@index([airlineId])
  @@index([expiresAt])
}

// Invite-Tokens für User-Onboarding zu einer Airline. Admin generiert ein
// Invite, schickt den Link manuell (Discord-DM, Email) an den potenziellen
// Pilot. Beim Klick:
//   1. Wenn nicht eingeloggt → Discord-OAuth-Login mit callbackUrl=/invite/[token]
//   2. Nach Login: validate token (existiert, nicht expired, nicht used)
//   3. User klickt "Annehmen" → User.airlineId + (optional) User.roleId gesetzt
//   4. Invite.usedAt + usedById gesetzt → Token nicht mehr nutzbar
//
// Lifecycle:
//   - createdAt + 7d default expiry (kann override werden)
//   - usedAt = null → pending; usedAt != null → used (terminal)
//   - admin kann pending-invite revoken via setExpiresAt(now)
//
// Security:
//   - token = cuid(), 25-char unguessable, unique-indexed
//   - email-field optional, only as hint für admin (welcher pilot war
//     gemeint?), wird NICHT validiert beim accept (wir trust den
//     Discord-OAuth-Identity vom session)
//   - Token-Replay: usedAt-Check ist die einzige Defense — first-accept-wins
model Invite {
  id    String @id @default(cuid())
  token String @unique // URL-safe random token (cuid format)

  // Pre-fill / Hint — der Admin trägt ein wer eingeladen wurde, aber das
  // wird beim accept NICHT als gate genutzt. User-Identity kommt aus
  // dem authenticated NextAuth-session.
  email String?

  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id])

  // Wenn null → User wird nur airline-zugewiesen, role muss admin später
  // manuell setzen (oder der User behält null-role und ist ein "pending pilot").
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  expiresAt DateTime
  usedAt    DateTime? // null = pending; != null = used or revoked

  // Wer hat das Invite erstellt
  createdById String
  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id])

  // Wer hat das Invite eingelöst (null wenn pending)
  usedById String?
  usedBy   User?   @relation("InviteUser", fields: [usedById], references: [id])

  createdAt DateTime @default(now())

  @@index([airlineId, usedAt])
  @@index([token])
  @@index([expiresAt])
}

// ============================================================================
// SYSTEM-CURATED CATALOGS — Airport, AircraftType
//
// Phase 1 Architektur:
// - Airline-admins können nicht direkt anlegen — sie reichen einen Request ein.
// - System-admin sieht queue (/admin/requests), approves oder rejects.
// - Approve mit `asVerified=true` → catalog-entry mit verified-badge.
// - Approve mit `asVerified=false` → unverified entry (UI warning + edit-flag).
// - Subsequent verify-action: system-admin kann unverified entry später
//   verified machen (Airport.verified true setzen) wenn daten geprüft.
// - Airline-admins können trotzdem unverified entries nutzen — sie sehen
//   nur das warning-badge im picker.
//
// Audit-Trail: Catalog-entry → proposedFromRequest → request.requestedBy
// (proposer) + request.reviewer (approver). verifiedBy ist separater field
// für späteren verify-step (kann anderer system-admin sein als approver).
// ============================================================================

// AircraftType — system-curated aircraft type designations (B738, A20N, etc.).
// Initial seed: ~150 ICAO doc-8643 entries (manuell kurated TS array, alle
// verified=true). Spätere additions kommen via AircraftTypeRequest-flow.
//
// Beziehung zu Aircraft: Aircraft.aircraftTypeId optional FK. Während Phase 1
// koexistieren Aircraft.type:String und Aircraft.aircraftTypeId:String — neue
// resolver-logik bevorzugt aircraftTypeId, fällt zurück auf type-string-match
// gegen AircraftType.icaoType. Phase 2 backfill setzt aircraftTypeId für alle
// existing airframes; Phase 3 deprecated Aircraft.type field.
//
// Fleet[] relation deferred zu Phase 2 — derzeit Fleet.type:String, refactor
// auf FK braucht eigenes migration window.
// AircraftTypeRating[] deferred zu Phase 5 (Pilot-Type-Ratings feature).
model AircraftType {
  id                    String               @id @default(cuid())
  icaoType              String               @unique // ICAO doc-8643 designator: "B738", "A20N", "A359"
  name                  String // "Boeing 737-800", "Airbus A320neo"
  manufacturer          String // "Boeing", "Airbus", "Embraer"
  category              String // "narrow_body" | "wide_body" | "regional" | "cargo" | "ga"
  rangeNm               Int // Maximum range in nautical miles
  capacityPax           Int // Typical 2-class passenger capacity
  cruiseSpeedKt         Int // Cruise speed in knots
  fuelBurnKgH           Int // Approximate fuel burn kg/hour
  imageUrl              String? // Optional reference image (CC-licensed or owned)
  active                Boolean              @default(true)
  verified              Boolean              @default(false)
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?                @relation("AircraftTypeVerifier", fields: [verifiedById], references: [id])
  proposedFromRequestId String?              @unique
  proposedFromRequest   AircraftTypeRequest? @relation("AircraftTypeFromRequest", fields: [proposedFromRequestId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  aircraft Aircraft[]
}

// AirportRequest — proposal von airline-admin für catalog-erweiterung.
// State-machine: Submitted → UnderReview → (Approved | Rejected).
// Rate-limit: max 10 open (status != terminal) per user (enforced in
// server-action). Bei Approval mit `approvedAsVerified` Boolean wird:
//   1. Airport-row erstellt (proposedFromRequestId = this.id)
//   2. status = Approved, reviewedAt set, reviewer set
//   3. Wenn approvedAsVerified=true → Airport.verified=true, verifiedById=reviewer
//   4. Wenn approvedAsVerified=false → Airport.verified=false (provisional)
model AirportRequest {
  id                 String        @id @default(cuid())
  // Proposed airport data (mirrors Airport schema, except no FK fields)
  icao               String
  iata               String?
  name               String
  city               String?
  country            String
  latitude           Float
  longitude          Float
  elevation          Int?
  // Request meta
  status             RequestStatus @default(Submitted)
  reason             String? // Optional: "needed for new charter route to Greenland"
  // Submitter
  requestedById      String
  requestedBy        User          @relation("AirportRequester", fields: [requestedById], references: [id])
  // Optional airline-context — null wenn user solo (kein airline-admin)
  requestedAirlineId String?
  requestedAirline   Airline?      @relation("AirportRequestAirline", fields: [requestedAirlineId], references: [id])
  submittedAt        DateTime      @default(now())
  // Reviewer
  reviewedById       String?
  reviewer           User?         @relation("AirportReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  rejectionReason    String? // Set wenn status=Rejected
  reviewerNotes      String? // Optional internal notes (not shown to requester)
  // Set wenn status=Approved: war approve-as-verified oder approve-as-unverified?
  approvedAsVerified Boolean?
  // Back-relation 1:1: ein approved request creates max einen Airport
  createdAirport     Airport?      @relation("AirportFromRequest")

  @@index([status, submittedAt])
  @@index([requestedById, submittedAt])
  @@index([icao])
}

// AircraftTypeRequest — analog zu AirportRequest. State-machine identisch.
model AircraftTypeRequest {
  id                  String        @id @default(cuid())
  // Proposed aircraft type data
  icaoType            String
  name                String
  manufacturer        String
  category            String
  rangeNm             Int
  capacityPax         Int
  cruiseSpeedKt       Int
  fuelBurnKgH         Int
  imageUrl            String?
  // Request meta (analog AirportRequest)
  status              RequestStatus @default(Submitted)
  reason              String?
  requestedById       String
  requestedBy         User          @relation("AircraftTypeRequester", fields: [requestedById], references: [id])
  requestedAirlineId  String?
  requestedAirline    Airline?      @relation("AircraftTypeRequestAirline", fields: [requestedAirlineId], references: [id])
  submittedAt         DateTime      @default(now())
  reviewedById        String?
  reviewer            User?         @relation("AircraftTypeReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  rejectionReason     String?
  reviewerNotes       String?
  approvedAsVerified  Boolean?
  createdAircraftType AircraftType? @relation("AircraftTypeFromRequest")

  @@index([status, submittedAt])
  @@index([requestedById, submittedAt])
  @@index([icaoType])
}

// ============================================================================
// AIRPORT DETAIL DATA (Runways, Frequencies, Navaids)
//
// Importiert aus OurAirports.com CSVs (runways.csv, airport-frequencies.csv,
// navaids.csv). Source-of-truth ist `ourAirportsId` (Int) damit re-imports
// idempotent sind — wenn OurAirports einen entry updated, finden wir ihn
// per source-id wieder und updaten in-place statt einen duplikat-row zu
// erstellen.
//
// FK-strategie: Über `airportIcao` (String) statt `airportId` (cuid). Das
// CSV bringt `airport_ident` mit, was identisch zu Airport.icao ist (selber
// import-source). Cascade-delete: wenn ein Airport gelöscht wird, gehen
// seine runways/frequencies mit. Navaids haben optional FK weil manche
// navaids "associated" mit einem airport sind (e.g. FRA VOR), andere
// standalone (en-route navaids).
//
// Verifications-policy: Im gegensatz zu Airport.verified gibt es hier kein
// verified-flag — die daten sind aus OurAirports und werden 1:1 übernommen.
// Falls airline-admins eine korrektur brauchen, geht das über einen edit-
// flow auf den Airport selbst (zukünftig), nicht per request-flow auf die
// detail-tabellen.
// ============================================================================

// Runway — physische landebahn an einem airport. Jede runway hat zwei
// "ends" (low end + high end), z.B. RWY 09/27 hat le_ident=09 + he_ident=27.
// Heading in degrees true (degT), nicht magnetic.
model Runway {
  id            String  @id @default(cuid())
  ourAirportsId Int     @unique
  airportIcao   String
  airport       Airport @relation(fields: [airportIcao], references: [icao], onDelete: Cascade)

  // Physische dimensionen
  lengthFt Int? // Runway length in feet (e.g. 11000 = ~3350m)
  widthFt  Int? // Runway width in feet (e.g. 200 = ~60m)
  surface  String? // ASPH, CONC, GRASS, GRAVEL, WATER, etc — kontrolliertes vocab aus OurAirports
  lighted  Boolean @default(false) // Hat runway lights?
  closed   Boolean @default(false) // Permanent closed runway

  // Low-end (numerisch niedrigere kennung, z.B. "09" für 09/27 paar)
  leIdent       String? // "09", "13L", "32R"
  leLatitude    Float?
  leLongitude   Float?
  leElevationFt Int?
  leHeadingDegT Float? // True heading 0-359
  leDisplacedFt Int? // Displaced threshold offset

  // High-end (z.B. "27" für 09/27 paar)
  heIdent       String?
  heLatitude    Float?
  heLongitude   Float?
  heElevationFt Int?
  heHeadingDegT Float?
  heDisplacedFt Int?

  // Indizes für: per-airport-lookup (häufigster query), filter "alle airports
  // mit closed=false runways" für route-planning, surface-filter (z.B. "nur
  // hartbahnen für jets").
  @@index([airportIcao])
  @@index([surface])
  @@index([closed])
}

// AirportFrequency — radio-frequenzen pro airport (TWR, GND, APP, ATIS, etc).
// Ein airport hat typisch 3-15 frequencies. `type` ist OurAirports-vocab
// (TWR, GND, APP, DEP, ATIS, AWOS, ASOS, CTAF, ARCAL, MULTICOM, UNICOM, etc).
model AirportFrequency {
  id            String  @id @default(cuid())
  ourAirportsId Int     @unique
  airportIcao   String
  airport       Airport @relation(fields: [airportIcao], references: [icao], onDelete: Cascade)

  type         String // TWR, GND, APP, ATIS, etc
  description  String? // Optional human-readable, z.B. "Tower South"
  frequencyMhz Float // Civilian VHF aviation band 118-137 MHz

  @@index([airportIcao])
  @@index([type])
}

// Navaid — VOR/NDB/DME/ILS/etc stations. Manche sind "associated" mit einem
// airport (e.g. ILS approach für RWY 25R), manche standalone (en-route VOR).
// `ident` ist der callsign der station (3-5 chars, z.B. "FRA" für Frankfurt VOR).
model Navaid {
  id            String @id @default(cuid())
  ourAirportsId Int    @unique

  ident        String // Callsign, z.B. "FRA", "TGO", "WUR"
  name         String // Voll-name, z.B. "Frankfurt VOR-DME"
  type         String // VOR, VOR-DME, VORTAC, NDB, NDB-DME, DME, TACAN, ILS, GS, MARKER, OM, MM, IM
  frequencyKhz Int? // Frequency in kHz (VOR/ILS sind MHz aber gespeichert *100, NDB ist kHz)
  latitude     Float
  longitude    Float
  elevationFt  Int?
  isoCountry   String // ISO 2-letter

  // Optional DME-component für VOR-DME, VORTAC pairs
  dmeFrequencyKhz Int?
  dmeChannel      String?
  dmeLatitude     Float?
  dmeLongitude    Float?
  dmeElevationFt  Int?

  slavedVariationDeg   Float? // Magnetic variation slaved into the station
  magneticVariationDeg Float?
  usageType            String? // HI (high-altitude airway), LO (low), BOTH, TERM (terminal), RNAV
  power                String? // LOW, MEDIUM, HIGH

  // Optional FK zu Airport (manche navaids sind "owned by" einem airport,
  // andere standalone). Cascade SetNull statt Cascade-Delete, damit ein
  // navaid überlebt wenn der zugeordnete airport mal entfernt wird.
  associatedAirportIcao String?
  associatedAirport     Airport? @relation("NavaidAssociatedAirport", fields: [associatedAirportIcao], references: [icao], onDelete: SetNull)

  @@index([associatedAirportIcao])
  @@index([type])
  @@index([ident])
}

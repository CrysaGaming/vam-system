generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FlightState {
  Planned
  Departed
  Airborne
  Landed
  Cancelled
}

enum NetworkType {
  VATSIM
  IVAO
  Offline
}

enum PirepStatus {
  /// Auto-PIREP intermediate state (option #19 — Edit-Before-Submit).
  /// The auto-PIREP path (BLOCK_ON → triggerAutoPirep → generatePirepFromSession)
  /// lands every flight as Draft so the pilot can review/edit remarks
  /// before the PIREP is broadcast to Discord and reaches the admin
  /// approval-queue. Manual /pireps/new submissions skip Draft entirely
  /// and land as Submitted (the pilot has already typed the remarks
  /// themselves — no review-step needed).
  ///
  /// Side-channels (Discord embed, rank-promotion check) only fire on
  /// the Draft → Submitted transition, NOT on initial Draft creation.
  /// This prevents the bot from broadcasting half-cooked auto-PIREPs
  /// while the pilot is still editing them.
  ///
  /// A Draft can be: (a) edited by the pilot, (b) submitted by the
  /// pilot (→ Submitted), or (c) cancelled by the pilot/admin. There
  /// is no auto-promotion from Draft to Submitted; the pilot must
  /// explicitly submit. (Future v2 could add a TTL — auto-submit after
  /// 24h to keep abandoned drafts from clogging the queue — but for v1
  /// pilots are responsible for completing their drafts.)
  Draft
  Submitted
  Approved
  Rejected
}

enum DataSource {
  VATSIM_API
  IVAO_API
  ACARS_CLIENT
  MANUAL
  REPLAY
}

enum BookingState {
  Created
  SimBriefDispatched
  // Multi-leg tour-state (option #12). Used when a Booking has
  // legCount > 1 and at least one but not all legs have a filed
  // PIREP. The auto-PIREP path bumps `legsCompleted` and flips
  // the booking to InProgress; only the final leg flips it back
  // to Completed. Single-leg bookings (legCount=1) skip this
  // state entirely — the manual flow and ACARS auto-flow both
  // go Created/SimBriefDispatched → Completed in one step.
  InProgress
  Completed
  Cancelled
  Expired
}

// Welle 4: Flight-Type-Klassifizierung. Default SCHEDULED für alle existing
// PIREPs/Bookings (additive migration). FREE = pilot fliegt frei ohne
// route-restriction (free-flight tab). POSITIONING = ferry/repositioning
// flug zwischen hubs (typisch leer, no revenue). TRAINING = sim-checkride,
// type-rating-flight, exam (kommt mit Welle 13 career-system). CHARTER =
// einmal-flug außerhalb scheduled-network (kommt mit Welle 7 schedule-gen).
enum FlightType {
  SCHEDULED
  CHARTER
  POSITIONING
  TRAINING
  FREE
}

// Welle 4: Quelle des Position-Updates für User.currentLocationIcao.
// Tracking: woher wissen wir wo der pilot grade ist? MANUAL = airline-admin
// hat manuell gesetzt (z.B. seed). PIREP = letzter approved-PIREP arrival.
// ACARS = ACARS-client heartbeat (kommt Welle 9). VATSIM/IVAO = network-
// session position-snap (live-tracking aus bot). JUMPSEAT = pilot ist via
// jumpseat-transfer umgezogen (no-flight, audit-trail in JumpseatTransfer).
// Source-precedence wird in der app-logik definiert (ACARS > VATSIM/IVAO
// live > PIREP > JUMPSEAT > MANUAL als fallback).
enum LocationSource {
  MANUAL
  PIREP
  ACARS
  VATSIM
  IVAO
  JUMPSEAT
}

// Welle 4: Grund für Jumpseat-Transfer. Audit-trail damit airline-admin
// nachvollziehen kann warum ein pilot umgezogen ist ohne-flug. RETURN_TO_HUB
// = häufigster fall (pilot ist nach flug irgendwo gestrandet, will zurück
// zum hub). HUB_TO_HUB = multi-hub-airline, pilot wechselt zwischen FRA/MUC.
// POSITIONING = admin-driven, flotten-positionierung (z.B. neuer pilot wird
// an seinen base-airport verschoben). ADMIN_TRANSFER = generic admin-action
// (z.B. correction nach falscher PIREP-arrival).
enum JumpseatReason {
  RETURN_TO_HUB
  HUB_TO_HUB
  POSITIONING
  ADMIN_TRANSFER
}

// Welle 5: Aircraft-Lifecycle-States. Replaces (und ergänzt) das einfache
// Aircraft.active boolean. Mit dem booking-flow + maintenance-management
// brauchen wir mehr granularität als nur on/off:
//
// - ACTIVE: voll verfügbar, buchbar, fliegt
// - MAINTENANCE: aktuell in der werkstatt — nicht buchbar, aber inventory-
//   sichtbar. Roleplay-flag, ist nicht (yet) mit cost/time-system verknüpft.
//   Manueller status, airline-admin setzt + un-setzt.
// - STORED: long-term parking (z.B. winter-storage, fleet-rotation pause).
//   Nicht buchbar, aber leichter zu reaktivieren als RETIRED. Andere
//   semantik für UI-filter ("show stored aircraft" vs "show retired").
// - RETIRED: dauerhaft außer dienst. Nicht buchbar, aber historische
//   PIREPs/routes referenzieren das aircraft weiter (FK-integrity). Zeigt
//   in der liste mit "retired"-badge + opacity. Reaktivierung via admin-
//   action möglich, aber typisch ein "soft-delete-with-history" replacement
//   für hard-delete.
//
// Migration-strategie: das alte Aircraft.active boolean bleibt ZUNÄCHST
// erhalten (additive), wird beim app-layer mit `status==ACTIVE` synchron
// gehalten. Welle 5 phase 2 deprecated `active`, dann ist status der
// single-source-of-truth.
enum AircraftStatus {
  ACTIVE
  MAINTENANCE
  STORED
  RETIRED
}

// Welle 6B (commit 6B-2): Employment-Status für piloten. Ergänzt rankId/roleId
// um eine orthogonale dimension: ist dieser pilot operativ aktiv? Kann airline
// ihn für scheduled-flights einplanen?
//
// - ACTIVE: normal, fliegt regulär. Default für alle existing user (additive
//   migration), für alle neuen user via @default(ACTIVE).
// - LEAVE: vorübergehend nicht verfügbar. Urlaub, sabbatical, prüfungs-
//   vorbereitung, krankschreibung. Pilot bleibt member der airline, behält
//   rank, aber wird in personnel-reports/leaderboards nicht als "aktiver
//   roster" mitgezählt. Roleplay-flag, kein hard-gate auf bookings (pilot
//   kann immer noch fliegen wenn er will — die status-info ist nur für
//   roster-planung).
// - INACTIVE: long-term nicht aktiv. Discord-acc verloren, hat lange nicht
//   geflogen, will pause aber nicht ganz raus. Auch kein hard-gate aber
//   stärkerer signal an admins für cleanup-decisions ("entferne nach 90d
//   inactive?").
//
// Bewusst nur 3 states (nicht TERMINATED/SUSPENDED/etc.) — termination
// wird durch removeMemberFromAirline gehandhabt (User.airlineId=null), nicht
// als status. Suspended/disciplinary ist out-of-scope für VA-context.
//
// Migration-strategie: additive, alle existing users bekommen ACTIVE als
// default. Kein backfill-script nötig (default greift auf existing rows).
enum EmploymentStatus {
  ACTIVE
  LEAVE
  INACTIVE
}

// State-machine für AirportRequest und AircraftTypeRequest. Mirrors PIREP-
// pattern (Submitted → Approved/Rejected) mit Erweiterung UnderReview.
// Approval ist binär hier, aber via `approvedAsVerified` Boolean auf den
// Request-models in zwei Tiers: verified (system-admin hat daten geprüft)
// vs unverified (provisional, mit warning-badge im UI).
enum RequestStatus {
  Submitted
  UnderReview
  Approved
  Rejected
}

// Welle 7: State einer konkreten ScheduledFlight-instanz. Orthogonal zur
// FlightState (Pirep-runtime) und PirepStatus (approval-workflow):
//
// - Planned: generator hat slot erstellt, noch unbooked. Sichtbar in pilot-
//   booking-UI als "available scheduled flight". Häufigster initial-state.
// - Booked: ein pilot hat den slot via createBookingFromScheduledFlight
//   gepickt. ScheduledFlight.bookingId ist set, Booking.state ist Created
//   (oder weiter im booking-lifecycle). Slot ist nicht mehr verfügbar für
//   andere piloten.
// - Completed: PIREP wurde gefiled UND approved. Terminal-state — slot ist
//   "history". Wird aus pilot-UI rausgefiltert, bleibt in admin-grid für
//   reporting/leaderboards sichtbar.
// - Cancelled: admin oder pilot hat den slot abgesagt. Terminal aber nicht-
//   completed. Wenn pilot canceled → Booking.state=Cancelled triggert
//   ScheduledFlight back zu... hmm, eigentlich Cancelled (slot ist tot —
//   admin kann manuell neuen für gleichen zeit-slot generieren wenn ge-
//   wünscht). Bewusst NICHT zurück zu Planned, weil das booking-cancellation
//   eines piloten nicht impliziert dass der slot wieder offen sein soll —
//   der admin entscheidet das per re-generation.
//
// Bewusst KEIN "InProgress"/"Departed"/"Airborne" — das ist die domäne von
// FlightState am Pirep, nicht des schedule-records. Hier interessiert nur:
// ist dieser slot offen, hat ihn jemand, ist er fertig, oder ist er tot?
enum ScheduledFlightStatus {
  Planned
  Booked
  Completed
  Cancelled
}

// Welle 13 (Economy MVP): Wer kann VAM$ besitzen und Transactions sehen?
// Aktiviert nur wenn airline.economyEnabled UND user.economyEnabled — sonst
// ist das schema dormant (additive migration, kein impact für non-economy-
// airlines). Dual-flag-gate ist welle-4-foundation, hier consumed.
//
// USER = pilot's persönliches wallet (salary in, ticket-purchases out).
// AIRLINE = operating-account (passenger/cargo-revenue in, fuel/landing/
//   ground-handling/catering-expenses out).
// AIRLINE_PAYROLL = separate für salary-runs. Best-practice accounting:
//   trennung von operating-cash und payroll-reserve. Salary-payments
//   transfern zuerst von AIRLINE → AIRLINE_PAYROLL (monthly payroll-batch),
//   dann von AIRLINE_PAYROLL → USER. Macht audit + cashflow-analyse leichter.
// AIRLINE_MAINTENANCE = reserve für scheduled-checks (kommt Welle 15+ aircraft-
//   economy). Im MVP existiert der enum-wert für forward-compat, wird aber
//   nicht aktiv genutzt — kein code-pfad erzeugt MAINTENANCE-wallets.
// SYSTEM = VAM-system-treasury. Endpunkt für sinks: taxes, broker-fees,
//   bankruptcy-liquidations. Im MVP existiert genau ein system-wallet
//   (auto-bootstrap), für catering-fees etc. die nicht an reale airlines
//   gehen sollen (sonst hätten airlines net-positive cashflow allein durch
//   eigenes catering-recycling).
enum WalletOwnerType {
  USER
  AIRLINE
  AIRLINE_PAYROLL
  AIRLINE_MAINTENANCE
  SYSTEM
}

// Welle 13: Transaction-typen für audit-log + filter. Die liste ist
// finite-but-extensible — neue typen addieren wir später für loans,
// stocks, bonds etc. (Wellen 15+). Schema-format: VERB_OBJECT bei
// transfers (TRANSFER_OUT/IN) oder DOMAIN_TYPE bei spezifischen flows
// (REVENUE_PASSENGER, EXPENSE_FUEL).
//
// Sign-convention: amount auf Transaction ist signed. + = inflow zum
// wallet, - = outflow. Bei TRANSFER_OUT ist amount negativ und
// counterpartyWalletId zeigt aufs ziel-wallet; gepaart mit einem
// TRANSFER_IN auf dem ziel-wallet (positives amount). Beide werden
// atomic in einem prisma.$transaction erzeugt (siehe wallet-helper
// in 13B).
//
// REVENUE_*: airline bekommt geld (passenger-tickets, cargo-fracht,
// twitch-subscriber-tickets in Welle 14).
// EXPENSE_*: airline gibt geld aus (fuel an SYSTEM, landing-fees an
// SYSTEM für non-airline-airports).
// SALARY_PAID: outflow auf AIRLINE_PAYROLL (per-PIREP, basiert auf
// flight-time × rank-rate).
// SALARY_RECEIVED: inflow auf USER, gegenstück zu SALARY_PAID.
// TRANSFER_*: generic inter-wallet-bewegung (z.B. airline-funding,
// hub-balance-redistribution).
// ADJUSTMENT_ADMIN: manueller eingriff durch system-admin (corrections,
// disputes). Bewusst eigener typ damit man im audit-log ungewöhnliche
// einträge schnell findet.
// ECONOMY_RESET: bulk-event wenn ein admin economy für eine airline
// resetted (z.B. nach beta-test). Audit-trail bleibt sichtbar — wir
// löschen nichts, sondern markieren.
enum TransactionType {
  REVENUE_PASSENGER
  REVENUE_CARGO
  REVENUE_TICKET_TWITCH
  // Welle 14F: Stream-rewards für streamer-pilots. Subscribers/cheerers/
  // gifters auf twitch (oder youtube etc.) führen zu wallet-credits beim
  // streamer. Ein typ für alle stream-quellen — kind (subscribe/cheer/
  // gift/hype_train) wird per category-string + metadata-JSON differenziert.
  // Beispiel categories: "twitch-sub-tier1", "twitch-cheer", "twitch-gift",
  // "twitch-hype-train-l3". Audit-view kann per category-prefix
  // ("twitch-*", "youtube-*") platform-filter machen ohne weitere enums.
  REVENUE_STREAM_REWARD
  EXPENSE_FUEL
  EXPENSE_LANDING_FEE
  EXPENSE_GROUND_HANDLING
  EXPENSE_CATERING
  EXPENSE_MAINTENANCE
  EXPENSE_FLIGHT_SCHOOL
  SALARY_PAID
  SALARY_RECEIVED
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_ADMIN
  ECONOMY_RESET
}

// Welle 13E (Career-System): ICAO-realistic license-hierarchy. Pilot startet
// als SPL (Student Pilot License), arbeitet sich hoch zu PPL (Private Pilot,
// VFR/single-engine/day), kann optional NIGHT_RATING + INSTRUMENT_RATING
// (IR) + MULTI_ENGINE_RATING (ME) draufsetzen, dann CPL (Commercial Pilot
// License — kann für money fliegen, single-pilot ops). Mit MCC (Multi-Crew
// Cooperation) + Type Ratings (separate model) ist man qualifiziert für
// commercial-airline-jobs als FO. ATPL (Airline Transport Pilot License)
// = captain für commercial-airlines. TRI (Type Rating Instructor) +
// TRE (Type Rating Examiner) sind ausbildungs-licenses für Senior-Captains.
//
// Pilot kann mehrere licenses gleichzeitig haben (eine pro type). Foreign-
// keys: PilotLicense.@@unique([userId, type]) verhindert doppelte gleicher
// type. Welche aircraft welche licenses brauchen kommt im aircraft-
// requirements-mapping (apps/web — kein DB-table sondern lookup-funktion
// in 13E-7). Beispiel-mapping:
//   - C172 (GA single-engine) → PPL
//   - PA34 (GA twin) → PPL + ME
//   - A320 → CPL + ME + IR + Type Rating A320 + (MCC für FO/ATPL für CAP)
//   - A35K → ATPL + ME + IR + Type Rating A35K + MCC
enum LicenseType {
  SPL // Student Pilot — solo-flight permit, in-training-only
  PPL // Private Pilot — VFR, single-engine, day, no commercial
  NIGHT_RATING // Night-flying VFR-extension
  INSTRUMENT_RATING // IR — IFR-flying
  MULTI_ENGINE_RATING // ME — multi-engine class rating
  CPL // Commercial Pilot — can fly for money, single-pilot ops
  MCC // Multi-Crew Cooperation — required für two-pilot type-ratings
  ATPL // Airline Transport Pilot — captain für commercial-airlines
  TRI // Type Rating Instructor — kann andere TR-piloten ausbilden
  TRE // Type Rating Examiner — kann TR-checks abnehmen
}

// Welle 13E: License-state für validity-tracking. ACTIVE ist der normal-zustand.
// EXPIRED triggert wenn expiresAt überschritten und nicht erneuert (medical
// lapsed, recurrent-training missed). REVOKED ist disciplinary (cheating,
// dangerous-flying) — admin-action only. SUSPENDED ist temporary-suspension
// (e.g. ongoing investigation). Status-transitions:
//   ACTIVE → EXPIRED:    automatisch wenn expiresAt < now() (cron-job 13E-2)
//   ACTIVE → REVOKED:    admin-action mit reason
//   ACTIVE → SUSPENDED:  admin-action mit dauer
//   SUSPENDED → ACTIVE:  admin-action wenn investigation cleared
//   EXPIRED → ACTIVE:    nach renewal (admin-action oder enrollment-completion)
//
// Welle 13E-7 booking-gate prüft canPilotFlyAircraft() = pilot hat ALLE
// requirements UND alle sind ACTIVE. EXPIRED/REVOKED/SUSPENDED zählen alle
// als "not valid" für den booking-block.
enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SUSPENDED
}

// Welle 13E (Flight-School Enrollment-Lifecycle): pilot meldet sich an
// einer flight-school an, durchläuft theory-stunden + practical-stunden
// + sim-stunden, schreibt theory-exam, schreibt practical-exam (specific
// PIREP-route mit pass/fail-criteria), bekommt nach beidem-passed die
// license ausgestellt.
//
// Status-transitions:
//   IN_PROGRESS → EXAM_SCHEDULED:  pilot hat genug stunden, bucht exam-slot
//   EXAM_SCHEDULED → IN_PROGRESS:  exam abgesagt, zurück ins training
//   EXAM_SCHEDULED → PASSED:       theory + practical bestanden,
//                                  PilotLicense wird automatisch erstellt
//   IN_PROGRESS → FAILED:          3+ exam-fails OR pilot gibt auf
//   IN_PROGRESS → WITHDRAWN:       pilot canceled enrollment (wallet-
//                                  refund partial möglich, app-policy)
//
// PASSED + WITHDRAWN + FAILED sind terminal-states. Neue enrollment kann
// erstellt werden für gleiche license (re-train z.B. nach FAILED).
enum EnrollmentStatus {
  IN_PROGRESS
  EXAM_SCHEDULED
  PASSED
  FAILED
  WITHDRAWN
}

model Airline {
  id       String  @id @default(cuid())
  icao     String  @unique
  iata     String? @unique
  name     String
  callsign String?
  logoUrl  String?

  // Welle 8: Branding-fields für public airline-pages (/a/[icao]).
  // Alle nullable — airline ist auch ohne branding-content nutzbar.
  // Hex-color-format (#RRGGBB) wird app-layer-validated, nicht im schema.
  tagline        String?
  description    String?
  websiteUrl     String?
  primaryColor   String?
  secondaryColor String?
  // Opt-out: airline ist per default public sichtbar unter /a/[icao] und
  // im /airlines directory. Admin kann auf false setzen für staging-airlines
  // oder private-roleplay-groups (UI sichtbar nur für eingeloggte members).
  publicVisible  Boolean @default(true)

  // SimBrief Override-Hierarchie Ebene 1 (lowest precedence). Per-airline
  // defaults für SimBrief-Dispatch (cont_fuel_pct, units, OFP-Layout, etc).
  // Schema: apps/web/lib/simbrief/overlay.ts SimBriefOverlaySchema. Wird
  // beim Dispatch durch Fleet/Aircraft/Route-overlays übersteuert (höhere
  // Specificity gewinnt).
  simBriefOverlay Json?

  // Welle 4: Economy-Foundation-Flag. False-default — wenn eine Airline
  // economy/cargo/passenger-revenue features aktiviert (kommt Welle 12+),
  // wird das hier auf true gesetzt. Steuert UI-Sichtbarkeit von Cargo-/
  // Passenger-Booking-Tabs, Revenue-Reports, etc. Per-airline opt-in
  // damit reine roleplay-airlines kein "money game" UI sehen.
  economyEnabled Boolean @default(false)

  // ─── ACARS simRate enforcement (option #19) ────────────────────────
  // Per-airline opt-in for hard-rejecting heartbeats from clients that
  // report simRate > 1.0 (sim-time-acceleration). When false (default),
  // simRate-cheats are merely flagged in the PIREP remarks via the
  // existing [ACARS-flag: sim-rate Nx] prefix — admin sees them at
  // approval time. When true, the heartbeat-route returns 422 the
  // moment the client reports simRate > 1.01 and the client surfaces
  // the rejection to the user.
  //
  // Why per-airline rather than global: VAs vary in their realism
  // tolerance. A casual roleplay airline may accept 4x-cruise-skip as
  // legitimate ("I had to AFK for dinner"); a strict simulation-focused
  // airline wants the hard line. Default false keeps existing behaviour
  // for everyone — admin opts in explicitly.
  enforceSimRate Boolean @default(false)

  // Welle 13E (Career-System): Career-Foundation-Flag. Analog zu
  // economyEnabled — per-airline opt-in (default false). Aktiviert wenn
  // die airline mit license-system, type-rating-restrictions und auto-
  // rank-progression arbeiten will. Roleplay-airlines die nur "fly for
  // fun" wollen, lassen das auf false und sehen keine career-features
  // (kein /licenses-link, keine booking-blocks).
  //
  // Beide flags (user.careerEnabled UND airline.careerEnabled) müssen
  // true sein damit pilot career-features sieht — gleiche dual-gate
  // logik wie economy. Im hardcore-mode wird hier später ein realismus-
  // level dazukommen ("relaxed" vs "strict" enforcement, kommt mit
  // section 4 realism-spectrum).
  careerEnabled Boolean @default(false)

  // Track 4 #83 (Section P): Per-airline Discord-template overrides.
  // Json-shape (see apps/web/lib/discord-templates.ts für TypeScript-
  // types + render-engine):
  //
  //   {
  //     pirepSubmitted?: { title?: string; description?: string };
  //     pirepApproved?:  { title?: string; description?: string };
  //     pirepRejected?:  { title?: string; description?: string };
  //     rankUpgraded?:   { title?: string; description?: string };
  //     awardEarned?:    { title?: string; description?: string };
  //     eventPublished?: { title?: string; description?: string };
  //   }
  //
  // Variablen werden über {placeholder}-syntax aufgelöst (z.B.
  // {pilot}, {flightNumber}, {route}, {approver}, {reason}). Liste der
  // verfügbaren placeholder pro category steht in der lib/discord-
  // templates.ts dokumentation.
  //
  // Wenn null oder eine category fehlt → bot rendert den default-embed
  // wie immer. Mit override wird der entsprechende title/description-
  // text ersetzt; restliche embed-elemente (color, fields, button) bleiben.
  // Damit kann ein admin den ton anpassen ("LEAV begrüßt {pilot} im
  // approved-club" statt "{pilot} flight was approved by {approver}")
  // ohne den ganzen embed-builder neu schreiben zu müssen.
  discordTemplates Json?

  // ─── TypeRating-Currency-Enforcement (option #29) ──────────────────
  // Per-airline opt-in für hard-blocking von buchungen wenn pilot's
  // type-rating zwar exists aber recency-lapsed ist (lastFlownAt < 90d
  // ago, regulatory norm "3 takeoffs/landings in 90 days for PAX-ops").
  //
  // Default false → existing behaviour: nur expired type-ratings
  // (expiresAt < now) blocken bookings, recency-lapsed wird nur in der
  // /licenses currency-warning sichtbar gemacht aber nicht enforced.
  //
  // Bei true → zusätzlicher hard-block in canPilotFlyAircraft: pilot
  // muss type-rating sowohl gültig (expiresAt > now) als auch current
  // (lastFlownAt > now-90d ODER never-flown=baseline-fresh) haben.
  // Pilots sehen das als "Type Rating B738 (recency lapsed)" in der
  // booking-error message und müssen erst eine runde fliegen oder
  // einen recurrent-check machen.
  //
  // Why per-airline (not global): VAs vary in realism level. A
  // training-school enforcing strict currency is one thing; a casual
  // hobby-airline where pilots fly when they have time would block
  // most of their members at random. Default-off keeps the realism
  // optional opt-in, mirror der enforceSimRate-pattern.
  //
  // Greift nur wenn careerEnabled=true (sonst kein gate überhaupt).
  enforceTypeRatingCurrency Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  ranks            Rank[]
  aircraft         Aircraft[]
  fleets           Fleet[]
  routes           Route[]
  pireps           Pirep[]
  /// Track 4 #91 (Section R): TypeRating-Exams gehören zur airline für
  /// multi-tenant-isolation. Cascade-delete wenn airline gelöscht wird
  /// (history-cleanup).
  typeRatingExams  TypeRatingExam[]
  /// Track 4 #93 (Section R): Mentorships gehören zur airline (mentor+mentee
  /// müssen beide in der airline sein). History bleibt erhalten beim
  /// airline-delete? — kein cascade, aber Mentorship.airline relation ist
  /// pflicht, also würde delete tatsächlich fehlen-mit-fk-error wenn
  /// historische records vorhanden sind. Akzeptabel weil airline-delete
  /// extrem selten ist und vorher manuelles cleanup verlangt.
  mentorships      Mentorship[]
  /// Track 4 #98 (Section S): Event-Templates der airline. Cascade-delete
  /// via EventTemplate.airline — airline-delete räumt templates mit auf
  /// (sind nicht wertvoller als die airline selbst, schließlich kann
  /// admin sie jederzeit neu erstellen).
  eventTemplates   EventTemplate[]
  sceneries        Scenery[]
  featureFlags     FeatureFlag[]
  roleMappings     DiscordRoleMapping[]
  bookings         Booking[]
  flightPlanCaches FlightPlanCache[]
  invites          Invite[]

  // Welle 4: Multi-Hub-System. Eine Airline kann 1..N hubs haben (FRA+MUC
  // style). Genau ein hub hat isPrimary=true (CHECK-constraint via partial
  // unique-index in app-logik enforced). Pilot.baseIcao kann jeden hub-icao
  // referenzieren, default = primary-hub. Hubs sind die orte an denen
  // jumpseat-transfers günstig/free sind und scheduling beginnt.
  hubs AirlineHub[]

  // Welle 7: Schedule-System. Templates definieren wiederkehrende muster
  // (Mo+Mi+Fr 14:30 UTC), scheduledFlights sind die generierten konkreten
  // instanzen. Cascade-on-delete via the relation definition (Airline-
  // löschung räumt schedule-data mit auf).
  scheduleTemplates ScheduleTemplate[]
  scheduledFlights  ScheduledFlight[]

  // System-Catalog Request-Flow — eine Airline kann mehrere Requests
  // einreichen. Optional FK auf Request damit auch user-ohne-airline
  // (z.B. solo-pilot vor airline-zuweisung) requests stellen können.
  airportRequests      AirportRequest[]      @relation("AirportRequestAirline")
  aircraftTypeRequests AircraftTypeRequest[] @relation("AircraftTypeRequestAirline")

  // Welle 13: Economy-MVP Wallet-back-relation. Eine airline kann mehrere
  // wallets haben (operating, payroll, maintenance) — siehe WalletOwnerType
  // enum-docstring. Cascade-delete via Wallet.ownerAirline relation:
  // airline-löschung räumt zugehörige wallets+transactions mit auf (audit-
  // trail im SYSTEM-wallet bleibt erhalten via counterpartyWalletId-strings,
  // die referenziert werden aber nicht FK-enforced sind).
  wallets Wallet[] @relation("AirlineWallets")

  // Track 1 #7 (Events / Flight-Tours, 9.2.8): Event-back-relation.
  // Cascade-delete via Event.airline relation: airline-löschung räumt
  // events der airline mit auf (deren participants wiederum cascade-
  // gelöscht werden via EventParticipant.event). VA-wide-events
  // (airlineId=null) sind hier nicht enthalten — sie haben keinen
  // airline-owner.
  events Event[]

  // Track 4 #67 (Section M): Booking-templates dieser airline (alle pilots
  // dieser airline). Cascade-delete via BookingTemplate.airline.
  bookingTemplates BookingTemplate[]

  // Track 5 #26 (Section F): Roster-assignments dieser airline. Cascade-
  // delete via RosterAssignment.airline — wenn die airline weg ist, sind
  // alle assignments orphans und sollten mit weg.
  rosterAssignments RosterAssignment[]

  // Track 5 #29: swap-requests gehören zur airline (für admin-overview
  // und cascade-cleanup wenn airline gelöscht wird).
  rosterSwapRequests RosterSwapRequest[]

  // Welle F / F1 — Audit-log entries scoped to this airline. Used by
  // /airline/admin/audit-log for airline-admin-visible action history.
  auditLogEntries AdminAuditLog[] @relation("AdminAuditAirline")
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  name      String?
  discordId String? @unique

  vatsimCid            Int?      @unique
  vatsimVerifiedAt     DateTime?
  vatsimAccessToken    String?   @db.Text
  vatsimRefreshToken   String?   @db.Text
  vatsimTokenExpiresAt DateTime?

  ivaoVid            Int?      @unique
  ivaoVerifiedAt     DateTime?
  ivaoAccessToken    String?   @db.Text
  ivaoRefreshToken   String?   @db.Text
  ivaoTokenExpiresAt DateTime?

  // Welle 11 (Twitch-OAuth Foundation): Twitch-Account-Linking. Pattern
  // mirrors VATSIM/IVAO above — same OAuth-2.0-Authorization-Code-flow,
  // same refresh-token-handling. Twitch-IDs sind strings (nicht ints
  // wie VATSIM/IVAO), so twitchUserId ist String. twitchUsername ist
  // der mutable display-name (twitch erlaubt rename) — wird beim
  // OAuth-callback via /helix/users gefetched und beim refresh-flow
  // re-synchronisiert.
  //
  // Scopes (siehe lib/twitch-oauth.ts): bits:read, channel:read:subscriptions,
  // channel:read:hype_train, channel:read:redemptions — die minimum-set
  // für unsere geplanten EventSub-subscriptions in 11D. Wenn Welle 14
  // (Twitch Channel-Points → Tickets) kommt, müssen wir scopes
  // erweitern und re-authentifizierung anstoßen (fresh-grant flow).
  //
  // Token-lifetime: twitch user-access-tokens leben ~4h, refresh-tokens
  // sind langlebig. Refresh passiert lazy beim nächsten API-call wenn
  // tokenExpiresAt < now() + 60s buffer. Bot-side EventSub-websocket
  // erkennt token-expire via 401-revocation und triggert refresh.
  twitchUserId         String?   @unique
  twitchUsername       String?
  twitchVerifiedAt     DateTime?
  twitchAccessToken    String?   @db.Text
  twitchRefreshToken   String?   @db.Text
  twitchTokenExpiresAt DateTime?

  // Welle 14A (Twitch-Activation): Live-stream-status. Werden vom bot
  // (apps/bot/src/services/twitch-eventsub.ts) bei stream.online und
  // stream.offline events gesetzt. Foundation für UI-badges
  // (Profile/Live-Map/Header) und den #livestreams discord-embed.
  //
  // twitchIsLive: aktueller status. Bei stream.online → true, bei
  //   stream.offline → false. Idempotency: doppelte online-events
  //   posten keinen zweiten discord-embed (siehe markPilotLive-helper:
  //   skip wenn already live).
  //
  // twitchStreamTitle/GameName/ThumbnailUrl: aktueller stream-context.
  //   stream.online-event-payload enthält nur user-IDs, daher fetcht
  //   der bot den vollen kontext via Helix /streams API beim go-live.
  //   Bei stream.offline cleared. Thumbnail-URL ist die {width}x{height}-
  //   template-form von twitch — UI ersetzt placeholder bei display.
  //
  // twitchLastWentLiveAt: persistent für "online seit X"-anzeige + 
  //   history. Wird bei stream.offline NICHT cleared, damit das
  //   profile zeigen kann "zuletzt gestern live".
  twitchIsLive             Boolean   @default(false)
  twitchStreamTitle        String?
  twitchStreamGameName     String?
  twitchStreamThumbnailUrl String?
  twitchLastWentLiveAt     DateTime?

  // SimBrief-Account-Identifier für API-Dispatch. Wenn null, dispatcht User
  // via Browser-Fallback (prefilled URL).
  simBriefUsername String?

  overlayToken String? @unique

  overlayLayout       String @default("bar") // "bar" | "card"
  overlayCardPosition String @default("top-right")
  overlayPhaseColors  Json? // optional override

  // Welle 10 commit 10D: Custom-Branding für streamer-overlay. Alle drei
  // optional — wenn null/missing, fallback auf default cyan/green theme.
  // Validation passiert app-layer:
  //   - overlayLogoUrl: muss valide https-URL sein, max 500 chars,
  //     darf nur auf bilder verweisen (image/png|jpeg|webp|svg). Server-
  //     action checkt content-type bevor sie speichert.
  //   - overlayPrimaryColor / overlayAccentColor: hex-strings #RGB oder
  //     #RRGGBB, regex-validated.
  // Logo wird vom client direkt geladen (browser-side fetch), kein
  // proxying durch unsere domain — keep public-overlay frei von
  // image-bandwidth-overhead. CSP des overlay-pages erlaubt img-src *
  // damit beliebige logo-hosts funktionieren (imgur, github, eigene
  // CDNs etc.).
  overlayLogoUrl      String?
  overlayPrimaryColor String?
  overlayAccentColor  String?

  image            String?
  totalFlightHours Float    @default(0)
  totalFlights     Int      @default(0)

  // Track 4 #59 (Section K): Optional annual hour-goal. NULL = pilot hat
  // noch nichts gesetzt → UI zeigt einen "Setze dein ziel"-CTA. Int weil
  // wir in stunden (nicht minuten) speichern; reasonable range 10..2000
  // pro jahr (10h = casual, 2000h = berufsmäßig). Persistiert nicht
  // PRO jahr (kein year-spezifisches feld), sondern wirkt für das CURRENT
  // year — bei jahreswechsel re-evaluiert sich der progress automatisch.
  // Wenn pilot in 2027 sein 2026-ziel ändert, ist die "history" verloren —
  // bewusst, weil annual-goals nicht historisierbar sein müssen.
  annualHourGoal   Int?

  // Track 4 #61 (Section L): Free-form pilot bio.
  //
  // Optional self-description sichtbar auf /pilots/[id] für andere piloten +
  // airline-public-page. NULL = nicht gesetzt (default; legacy + neue user).
  //
  // Length-cap: 500 chars im server-action (nicht im DB-schema, weil
  // String? ohne @db.Text limit auf ~191 chars im default-mysql geht,
  // aber wir nutzen postgres + @db.Text — also DB-seitig kein cap.
  // App-seitig 500 als sinnvoller balance: lang genug für 2-3 sätze
  // pilot-bio ("Heimatbase EDDF, fliege A320-family und 737, hobby seit
  // 2018"), kurz genug dass keine wall-of-text entsteht.
  //
  // Sanitize im action: trim, strip control-chars, kollabiere multi-newlines.
  // Kein markdown-rendering — plain-text-display preserves newlines.
  //
  // Public-by-default (kein "bioPublic"-flag wie bei birthday) — bio ist
  // selbst-geschrieben, pilot weiß was er postet. Falls später privacy
  // gewünscht: additive migration für bioPublic Boolean @default(true).
  bio              String?   @db.Text

  // Track 3 #11.2.5 v1-Full Item 2/10 — Pilot-Birthday-Calendar (vision-doc §9.1.14).
  // Geburtstag des piloten. NULL = nicht gesetzt (default für legacy-users).
  // Speichert nur monat+tag-relevante teile als ganzes datum (jahr ist auch
  // OK gesetzt — wird im widget aber ignoriert; wir matchen auf MM-DD).
  // Privacy: birthdayPublic=false (default) → nur self + admin sehen es,
  // widget filtert. Pilot setzt das selbst im profile-edit.
  birthday        DateTime? @db.Date
  birthdayPublic  Boolean   @default(false)

  // Track 5 #11 (Section C): Public-Profile opt-in.
  //
  // Wenn true: Profile-page /p/[id] ist öffentlich zugänglich (kein
  // login nötig) und zeigt einen scrubbed-public-view (name, image,
  // bio, tagline, rank-name, airline-icao, total-flights/hours,
  // letzte 5 approved PIREPs). KEINE economy-daten, KEINE booking-
  // history, KEINE email, KEINE notification-prefs.
  //
  // Wenn false (default): /p/[id] returnt 404. Die internal-page
  // /pilots/[id] (same-airline OR admin) bleibt unverändert.
  //
  // Opt-in (default false) statt opt-out: privacy-first. Pilot
  // muss aktiv entscheiden seine carrier mit anderen zu teilen.
  //
  // V2 könnte custom-slug einführen (`/p/captain-yoda` statt
  // `/p/clx123abc`), ist aber V1 nicht nötig.
  isProfilePublic Boolean   @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  airlineId       String?
  airline         Airline?  @relation(fields: [airlineId], references: [id])
  // Wann der user der airline beigetreten ist. Wird vom auth.ts
  // createUser-event auf NOW() gesetzt sobald airlineId zugewiesen
  // wird. Bei späterem invite-accept-flow analog. NULL für user die
  // (noch) keiner airline angehören oder vor 2026-05-02 erstellt
  // wurden — die migration backfilled NICHT, weil createdAt für
  // bestehende users der echte beitritts-zeitpunkt war (auto-join
  // bei registrierung).
  joinedAirlineAt DateTime?
  // Welle F / F4: Member-onboarding-wizard completion timestamp.
  // NULL = wizard noch nicht durchlaufen → /airline/onboarding redirect
  // greift bei nächstem dashboard-besuch. Gesetzt = wizard abgeschlossen
  // (oder vom user explizit übersprungen). Mit completeOnboarding-action
  // gesetzt; kann admin später resetten falls pilot den wizard erneut
  // sehen soll (z.B. nach airline-wechsel). Bewusst kein step-tracking-
  // field — der wizard ist idempotent, jeder step macht eigene DB-writes
  // (baseIcao, economyEnabled, etc.), bei page-reload startet er wieder
  // ab dem ersten unkomplettierten step (oder von vorn wenn user
  // backtracken will).
  onboardingCompletedAt DateTime?
  rankId          String?
  rank            Rank?     @relation(fields: [rankId], references: [id])
  roleId          String?
  role            Role?     @relation(fields: [roleId], references: [id])

  liveSessions   LiveSession[]
  pireps         Pirep[]
  approvedPireps Pirep[]       @relation("PirepApprover")
  awards         UserAward[]
  userSceneries  UserScenery[]
  featureFlags   FeatureFlag[]
  accounts       Account[]
  sessions       Session[]
  emailVerified  DateTime?
  bookings       Booking[]

  invitesCreated Invite[] @relation("InviteCreator")
  invitesUsed    Invite[] @relation("InviteUser")

  // Welle 4: Pilot-Position-Tracking & Hub-Assignment.
  //
  // baseIcao = hub des piloten innerhalb der airline (FRA, MUC). Default
  // beim airline-join = airline.primaryHub.icao. Pilot kann später wechseln
  // (admin-action). String-only (kein FK), spiegelt Aircraft.homeIcao-pattern.
  // Validation in app-layer: muss matching airline.hubs entry haben.
  //
  // currentLocationIcao = wo der pilot grade ist. Updated nach PIREP-approval
  // auf arrival.icao, oder nach jumpseat-transfer auf target. NULL = nie
  // geflogen (neuer pilot — UI zeigt "ready at base" als fallback).
  //
  // currentLocationSource = audit-trail woher der position-update kam
  // (siehe LocationSource enum-docstring). Default MANUAL für seed-data.
  //
  // currentLocationAt = wann letzter update. Mit Source kombinierbar für
  // staleness-detection (z.B. "VATSIM-position älter als 24h → fall back
  // to last PIREP arrival").
  baseIcao              String?
  // Welle F / F5: Multi-base support. Zusätzliche bases neben baseIcao
  // damit pilots die in mehreren cities ansässig sind (z.B. wohnt EDDF,
  // pendelt EDDM) keine ferry-flights brauchen wenn sie aus dem zweiten
  // hub starten wollen. String[] mit ICAO-codes; postgres-array damit
  // wir kein extra join-tabelle anlegen müssen für eine selten
  // mutierende whitelist. Validation in app-layer: jedes element muss
  // ein matching airline.hubs entry sein (analog zu baseIcao). baseIcao
  // bleibt der "primary" base für display-priorität — secondaryBaseIcaos
  // ist additive. Leeres array = nur primary-base (default-state).
  secondaryBaseIcaos    String[]      @default([])
  currentLocationIcao   String?
  currentLocationSource LocationSource @default(MANUAL)
  currentLocationAt     DateTime?

  // Welle 4: Economy-Foundation-Flag. Per-pilot opt-in (default false) —
  // selbst wenn airline.economyEnabled=true, kann pilot persönlich auf
  // "purist mode" bleiben (no money UI). Beide flags müssen true sein
  // damit ein pilot economy-features sieht.
  economyEnabled Boolean @default(false)

  // Welle 13E (Career-System): Career-Foundation-Flag. Per-pilot opt-in
  // (default false) — analog zu economyEnabled. Selbst wenn airline.
  // careerEnabled=true, kann pilot persönlich auf "non-career mode"
  // bleiben (kein license-blocking, keine type-rating-checks beim
  // booken, keine auto-rank-promotion). Beide flags müssen true sein
  // damit ein pilot career-features sieht (UI: /licenses-page,
  // sidebar-link "📜 Lizenzen", booking-gate für unlicensed aircraft,
  // auto-promotion-notifications).
  //
  // Bewusst getrennt von economyEnabled weil die concerns orthogonal
  // sind: ein pilot könnte VAM$ verdienen wollen ohne die license-
  // rigorosität, oder umgekehrt licenses sammeln ohne wallet-system.
  // Forward-compat: weitere foundation-flags wie acarsEnabled,
  // simulatorEnabled könnten später dazukommen wenn opt-in-features
  // entstehen.
  careerEnabled Boolean @default(false)

  // Track 4 #81 (Section P): Per-user notification preferences.
  //
  // Json-shape: { [category: string]: { inApp?: boolean; email?: boolean } }
  // Categories (initial set, additive):
  //   - pirepDecision    — own PIREP approved/rejected
  //   - pirepKudos       — someone gave kudos to own PIREP
  //   - bookingReminder  — 24h before scheduled departure
  //   - eventReminder    — event-day reminder
  //   - promotion        — career rank-up notification
  //   - adminBroadcast   — system-wide announcements
  //
  // Channels:
  //   - inApp: rendered into the AdminNotification model (in-app drawer).
  //     Honored TODAY by die notification-creation paths.
  //   - email: dispatched via die email-infrastructure built in #82+.
  //     Honored once that ships; until then ist der toggle ein no-op gate.
  //
  // Defaults (when field is null OR category-key is missing):
  //   - inApp: true (opt-out)
  //   - email: false (opt-in)
  //
  // Why Json statt eigenes NotificationPreference-model: die struktur ist
  // klein (~6 categories × 2 channels), read-pattern ist immer "alle prefs
  // für einen user" (kein cross-query), writes sind nur via settings-page.
  // Json hält die migration leichtgewichtig — neue categories/channels
  // ohne schema-changes.
  //
  // Forward-compat: discord-channel könnte später dazukommen (DM-via-bot
  // oder personal-webhook). Schema-shape muss dann nicht ändern, nur
  // die UI + dispatch-logik.
  notificationPrefs Json?

  // Welle 6B (commit 6B-2): Employment-Status — ist dieser pilot operativ
  // aktiv? Default ACTIVE für alle (additive migration). Siehe enum-
  // docstring oben für die semantik der drei states. Status-changes
  // erfolgen via /airline/pilots personnel-management UI (Welle 6B-4).
  // Bewusst kein separater `employmentStatusUpdatedAt` field — wenn audit-
  // tracking gebraucht wird, kommt das mit einem dediziertem PersonnelEvent
  // log-table (out-of-scope für 6B). updatedAt am User-record reicht erstmal.
  employmentStatus EmploymentStatus @default(ACTIVE)

  // Welle 9: ACARS-Client-Pairing. Token wird einmalig beim pairing
  // generiert (siehe AcarsPairingCode redeem-flow), bleibt valid bis
  // der user manuell disconnected oder neu paired (rotation überschreibt).
  // Bearer-token im /api/acars/heartbeat header. NULL = nicht paired.
  // acarsLastSeen wird bei jedem heartbeat upgedated — UI nutzt das für
  // online/offline-state ("paired aber nicht aktiv" vs "live").
  acarsToken       String?     @unique
  acarsPairedAt    DateTime?
  acarsLastSeen    DateTime?
  // User-wahl welches network der ACARS-client per default annoncen soll.
  // VATSIM/IVAO sind erst sinnvoll wenn user die jeweilige account-
  // verknüpfung gemacht hat (vatsimCid / ivaoVid gesetzt) — sonst ist
  // Offline der einzige sinnvolle wert. Validation app-layer, kein
  // schema-constraint.
  preferredNetwork NetworkType @default(Offline)

  // Welle 4: Audit-trail für jumpseat-transfers (no-flight position-changes).
  jumpseatTransfers JumpseatTransfer[]

  // Welle 9: ACARS pairing-codes (1:N for code-history, but only one
  // code is unconsumed-and-unexpired at a time per requestPairingCode
  // logic — older unconsumed codes are force-expired by the request).
  acarsPairingCodes AcarsPairingCode[]

  // System-Catalog Request-Flow — Audit-Trail Beziehungen.
  // Ein User kann gleichzeitig Submitter (airline-admin) und Reviewer
  // (system-admin) sein wenn er beide Rollen hat. Verifier ist immer
  // system-admin (gate via Role.permissions check).
  airportRequests       AirportRequest[]      @relation("AirportRequester")
  airportReviews        AirportRequest[]      @relation("AirportReviewer")
  verifiedAirports      Airport[]             @relation("AirportVerifier")
  aircraftTypeRequests  AircraftTypeRequest[] @relation("AircraftTypeRequester")
  aircraftTypeReviews   AircraftTypeRequest[] @relation("AircraftTypeReviewer")
  verifiedAircraftTypes AircraftType[]        @relation("AircraftTypeVerifier")

  // Welle 13: Economy-MVP Wallet-back-relation. Ein user kann mehrere
  // wallets haben — im MVP genau eines (walletType=primary), aber forward-
  // compat für späteres trading-account/savings-split (Welle 16+ stocks).
  // Cascade-delete: user-löschung räumt wallets+transactions mit (analog
  // zur Airline-relation oben).
  wallets Wallet[] @relation("UserWallets")

  // Welle 13E: Career-System back-relations.
  //
  // licenses = die licenses die DIESEM user gehören (PPL, ATPL, etc).
  //   Cascade-delete: user-löschung räumt seine licenses mit auf. Pro
  //   user max eine license pro type (siehe @@unique auf PilotLicense).
  //
  // licensesIssued = die licenses die dieser user als admin AUSGESTELLT
  //   hat (audit-trail für /airline/pilots grant-license-action). SetNull
  //   beim user-delete damit historische licenses ihre kette nicht
  //   verlieren — admin-id wird einfach null wenn der admin-account
  //   gelöscht wird, license existiert weiter.
  //
  // typeRatings = die type-ratings die dieser user hat (A320, B738, etc).
  //   Pro user max eines pro aircraftType (siehe @@unique).
  //
  // typeRatingsIssued = analog licensesIssued — admin-audit-trail.
  //
  // flightSchoolEnrollments = aktive + historische enrollments dieses
  //   piloten an flight-schools. Cascade-delete: user-löschung räumt
  //   seine enrollments mit (refunded-status wäre app-layer wenn nötig,
  //   aber bei user-delete ist das ohnehin moot — das wallet ist auch
  //   weg).
  licenses                PilotLicense[]           @relation("UserLicenses")
  licensesIssued          PilotLicense[]           @relation("LicensesIssued")
  typeRatings             TypeRating[]
  typeRatingsIssued       TypeRating[]             @relation("TypeRatingsIssued")
  /// Track 4 #91 (Section R): TypeRating-Exam back-relations.
  ///   typeRatingExamsAsPilot    = exams die DIESER user ablegt
  ///   typeRatingExamsAsExaminer = exams die DIESER user als examiner
  ///                                durchführt (für workload-views)
  typeRatingExamsAsPilot    TypeRatingExam[]       @relation("TypeRatingExamPilot")
  typeRatingExamsAsExaminer TypeRatingExam[]       @relation("TypeRatingExamExaminer")
  /// Track 4 #93 (Section R): Mentorship back-relations.
  ///   mentorshipsAsMentor = mentorships wo DIESER user als mentor agiert
  ///   mentorshipsAsMentee = mentorships wo DIESER user mentee ist
  mentorshipsAsMentor       Mentorship[]           @relation("MentorshipMentor")
  mentorshipsAsMentee       Mentorship[]           @relation("MentorshipMentee")
  /// Track 4 #98 (Section S): EventTemplate-back-relation. Templates die
  /// dieser user erstellt hat. SetNull beim user-delete um historische
  /// templates nicht zu verlieren — wäre möglich aber MVP nutzt cascade
  /// nicht weil templates eh airline-scoped sind (airline-delete räumt
  /// templates auf, user-delete würde sie verwaisen).
  eventTemplatesCreated     EventTemplate[]        @relation("EventTemplateCreatedBy")
  /// Track 4 #99 (Section S): Event-comments die dieser user verfasst hat.
  /// Cascade-delete via EventComment.user — wenn user account-deleted wird,
  /// verschwinden seine comments mit (alternativ: anonymisieren, V2-ticket).
  eventCommentsAuthored     EventComment[]         @relation("EventCommentsAuthored")
  /// Track 4 #101 (Section T): AdminAuditLog-back-relation. Audit-entries
  /// die dieser user als actor getriggert hat. SetNull beim user-delete:
  /// audit-history bleibt erhalten, nur der name verschwindet (anonyme
  /// audit-entries sind besser als gar keine).
  adminAuditActions         AdminAuditLog[]        @relation("AdminAuditActor")
  /// Track 4 #103 (Section T): ClientErrorLog-back-relation. Browser-errors
  /// die mit diesem user-account in zusammenhang stehen. SetNull beim
  /// user-delete (analog zu audit — forensik erhalten, link aufgelöst).
  clientErrorsReported      ClientErrorLog[]       @relation("ClientErrorUser")
  flightSchoolEnrollments FlightSchoolEnrollment[]

  // Track 1 #7 (Events / Flight-Tours, 9.2.8): Event-system back-relations.
  //   eventsCreated         = events die dieser user als admin erstellt
  //                           hat. Restrict-on-delete (kein cascade) —
  //                           wenn admin-account gelöscht wird, blockiert
  //                           das die user-löschung bis events transferred
  //                           oder deleted sind. Bewusst konservativ weil
  //                           events historisch wichtig sind (audit-trail).
  //   eventsParticipated    = signup-records dieses pilots an events.
  //                           Cascade-delete: pilot-löschung räumt seine
  //                           signups mit auf (event-row bleibt unberührt).
  //   eventsCompletedAsAdmin = audit-trail für admin der completion-flag
  //                            gesetzt hat (siehe EventParticipant.
  //                            completedById). SetNull beim admin-delete
  //                            damit completion-records ihre kette nicht
  //                            verlieren.
  eventsCreated          Event[]            @relation("EventCreatedBy")
  eventsParticipated     EventParticipant[] @relation("EventParticipations")
  eventsCompletedAsAdmin EventParticipant[] @relation("EventParticipantsCompletedBy")

  // Track 3 #11.2.5 v1-Full Item 8/10 (Notification-Center, 9.3.10):
  // Admin → Pilot in-app messaging. Author = admin der die nachricht
  // verfasst (audit-trail wer kommuniziert). Received = pilot, der die
  // nachricht erhält. Beide back-relations sind cascade-tolerant —
  // notifications werden nicht hard-deleted bei user-delete (siehe
  // model AdminNotification für die rules), wir referenzieren nur per
  // ID damit ein gelöschter user dem admin zeigt "(gelöschter pilot)"
  // statt das record-recovery zu blockieren.
  notificationsAuthored AdminNotification[] @relation("AdminNotificationAuthor")
  notificationsReceived AdminNotification[] @relation("AdminNotificationRecipient")

  // Track 4 #60 (Section L): Kudos die DIESER user anderen piloten gegeben
  // hat. Pro PIREP kann ein user max einen kudos vergeben (@@unique auf
  // PirepKudos). Cascade-delete via PirepKudos.user — user-löschung räumt
  // seine vergebenen kudos mit auf.
  pirepKudosGiven PirepKudos[]

  // Track 4 #67 (Section M): Booking-templates dieses pilots. Cascade-
  // delete via BookingTemplate.user — pilot-löschung räumt seine vorlagen
  // mit auf. Siehe BookingTemplate-docstring für scope/limits.
  bookingTemplates BookingTemplate[]

  // Track 5 #3 (PIREP-Annotations): Annotations die DIESER user (als
  // approver) an PIREPs anderer piloten geschrieben hat. Cascade-delete
  // via PirepAnnotation.author — wenn der approver-user gelöscht wird,
  // verschwinden seine annotations (statt orphan mit author=NULL — eine
  // anonymous annotation ist semantisch sinnlos in einem instructor-
  // feedback-context).
  pirepAnnotationsAuthored PirepAnnotation[] @relation("PirepAnnotationAuthor")

  // Track 5 #14 (Section C): PIREP-Comments authored by this user.
  // Cascade-delete via PirepComment.author — orphan comments sind
  // sinnlos sobald der author weg ist (selber pattern wie annotations).
  pirepCommentsAuthored PirepComment[] @relation("PirepCommentAuthor")

  // Track 5 #15 (Section C): PIREP-Photos posted by this user.
  // Cascade-delete via PirepPhoto.author — wenn user weg, photos weg.
  pirepPhotosAuthored PirepPhoto[] @relation("PirepPhotoAuthor")
  // Welle K / K3 — Photos this admin has featured as Photo-of-the-Week.
  pirepPhotosFeatured PirepPhoto[] @relation("PirepPhotoFeaturedBy")

  // Track 5 #10 (Flight Streaks & Goals): Selbst gesetzte ziele des pilots
  // (weekly flights, monthly hours, etc.). Cascade-delete via PilotGoal.user
  // — bei user-löschung verschwinden die goals mit. Pro user max 1 goal
  // pro kind (via @@unique constraint in PilotGoal).
  pilotGoals PilotGoal[]

  // Track 5 #13 (Section C): Follow-system. Asymmetric (twitter-style):
  // following = wem DIESER user folgt (outgoing edges, follower=self),
  // followers = wer DIESEM user folgt (incoming edges, followee=self).
  // Cascade-delete via Follow.follower/followee — wenn ein user gelöscht
  // wird, verschwinden alle seine follow-edges in beide richtungen.
  following Follow[] @relation("FollowFollower")
  followers Follow[] @relation("FollowFollowee")

  // Welle K / K2 — Pilot-Blog posts authored by this user.
  blogPosts BlogPost[] @relation("BlogPostAuthor")

  // Track 5 #24 (Section E): Web Push subscriptions. Ein user kann mehrere
  // devices/browsers haben (laptop chrome, mobile safari, tablet edge),
  // daher ist die relation 1:N. Bei user-löschung cascade-delete alle
  // subscriptions (sonst zeigen orphan-endpoints auf nicht-existente user).
  pushSubscriptions PushSubscription[]

  // Track 5 #26 (Section F): Roster-assignments. Zwei separate relations
  // weil ein user sowohl assignee (pilot) ALS auch assigner (admin) sein
  // kann — wir wollen beide tracken. RosterAssignment.pilot = wem ist's
  // zugewiesen (cascade-delete), RosterAssignment.assignedBy = wer hat's
  // erstellt (SetNull damit assignments überleben wenn der admin gelöscht
  // wird; die assignment selbst ist ja immer noch valid).
  rosterAssignments         RosterAssignment[] @relation("RosterAssignmentPilot")
  rosterAssignmentsAssigned RosterAssignment[] @relation("RosterAssignmentAssignedBy")

  // Track 5 #29: swap-request back-relations für die zwei pilot-roles
  // (requester = ich schicke einen swap raus, target = jemand will mit
  // mir tauschen). Cascade-delete: wenn der user gelöscht wird, sind
  // seine swap-requests irrelevant.
  swapRequestsSent     RosterSwapRequest[] @relation("SwapRequestRequester")
  swapRequestsReceived RosterSwapRequest[] @relation("SwapRequestTarget")

  // Welle E / E4 — multi-pilot cockpit-rooms. Two relations: rooms
  // I own (created/captain'd) vs rooms I'm a member of (joined as
  // FO / Relief / Observer). Both are array-relations because v1
  // allows multiple historical rooms per user; the "currently
  // active" filter is done at query-time via status='ACTIVE' /
  // status='OPEN'.
  cockpitRoomsOwned   CockpitRoom[]   @relation("CockpitRoomOwner")
  cockpitMemberships  CockpitMember[] @relation("CockpitMemberPilot")
}

// Track 5 #24 (Section E) — Web Push Subscription
//
// Eine row pro browser-installation eines users. Browser generiert beim
// PushManager.subscribe() ein endpoint (URL zum push-service: FCM für
// chrome/edge, Mozilla Autopush für firefox, Apple's APN für safari) plus
// ein keypair (p256dh public key + auth secret) für ECE-encryption der
// payload.
//
// # Endpoint als unique key
//
// Der endpoint-URL ist global eindeutig pro browser-installation, daher
// @unique. Re-subscribe vom selben browser (z.B. nach permission-revoke
// und neuem opt-in) gibt manchmal das selbe endpoint zurück — dann
// upsert statt insert. Wenn der user permission widerruft, sollte der
// next push-attempt einen 410 Gone zurückkriegen → cleanup-job löscht
// die row (siehe sendPushToUser im push helper module).
//
// # userAgent
//
// Optional debug-info beim subscribe-zeitpunkt. Hilft dem user später in
// einer "deine devices"-UI seine eigenen subscriptions zu identifizieren
// ("MacBook Chrome 130", "iPhone Safari"). Truncate auf 500 chars damit
// keine pathologisch-langen UAs die row sprengen.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Track 5 #26 (Section F) — Roster / Schedule Assignments
// ─────────────────────────────────────────────────────────────────────────

/// Lifecycle einer roster-assignment. Bewusst SCREAMING_SNAKE_CASE wie auch
/// ScheduledFlightStatus (existing convention im schema, anders als manche
/// Track-4-enums die PascalCase nutzen — wir matchen den nachbarn).
///
/// State transitions:
///
///   ASSIGNED ──pilot-ack──► ACCEPTED ──pirep-approved──► COMPLETED
///       │                       │
///       │                       └──pilot-no-pirep-by-deadline──► NO_SHOW
///       │
///       ├──admin-cancel──► CANCELLED
///       └──pilot-swap──► SWAPPED (sister-assignment created for other pilot)
///
/// COMPLETED setzt der approve-PIREP-flow automatisch (PIREP.rosterAssignment
/// back-relation). NO_SHOW wird durch einen cron-job oder check-on-load
/// gesetzt (#30). Andere transitions sind manuell vom user oder admin.
enum RosterAssignmentStatus {
  ASSIGNED
  ACCEPTED
  COMPLETED
  SWAPPED
  CANCELLED
  NO_SHOW
}

/// Roster-assignment: airline weist einen pilot einer scheduled-flight zu.
/// Unterscheidet sich vom Booking-model (existing): Booking = pilot-self-
/// service-pick, RosterAssignment = airline-pushes-to-pilot. NO_SHOW-
/// tracking + swap-flow + auto-rotation gibt's nur für rostered flights,
/// nicht für voluntary bookings.
///
/// # Lifecycle relations zu Pirep
///
/// Der pilot fliegt die assignment normal (creates Pirep). Beim PIREP-
/// approve setzt der flow `pirepId` hier auf den approved PIREP und
/// transitions status → COMPLETED. Das gibt uns auch das umgekehrte
/// statement: "wenn ein PIREP eine rosterAssignment hat → war rostered".
///
/// # @@unique([pilotId, scheduledFlightId])
///
/// Ein pilot kann nur EINE assignment per scheduled-flight haben. Verhindert
/// doppelt-roster bei admin-fehlern + macht das "swap"-pattern sauber
/// (alte assignment status=SWAPPED, neue assignment für anderen pilot).
/// Auch verhindert dass dieselbe pilot+flight-kombo zweimal in der queue
/// vom auto-rostering landet (#28).
model RosterAssignment {
  id        String  @id @default(cuid())
  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  pilotId String
  pilot   User   @relation("RosterAssignmentPilot", fields: [pilotId], references: [id], onDelete: Cascade)

  scheduledFlightId String
  scheduledFlight   ScheduledFlight @relation(fields: [scheduledFlightId], references: [id], onDelete: Cascade)

  status RosterAssignmentStatus @default(ASSIGNED)

  /// Optional override des ScheduledFlight.preferredAircraft. Wenn der
  /// admin will dass der pilot ein spezifisches airframe fliegt (z.B.
  /// weil das training-aircraft den senior-captains zugewiesen ist),
  /// kann er das hier festschreiben. NULL = pilot wählt selbst.
  assignedAircraftId String?
  assignedAircraft   Aircraft? @relation("RosterAssignmentAssignedAircraft", fields: [assignedAircraftId], references: [id], onDelete: SetNull)

  /// Wer hat die assignment erstellt (admin, instructor, oder auto-roster-
  /// job=NULL). SetNull-cascade damit assignments überleben wenn der admin
  /// gelöscht wird (would-be-orphan ist nicht das problem der assignment).
  assignedById String?
  assignedBy   User?   @relation("RosterAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  /// Optional admin-notiz (warum diese assignment, special-instructions).
  /// 500 chars cap — wenn länger nötig, geht's ins notification-system.
  note String? @db.VarChar(500)

  /// 1:0..1 zur PIREP. Set wenn pilot die assignment erfüllt + PIREP approved.
  /// Triggers status→COMPLETED. SetNull damit assignment überlebt wenn der
  /// PIREP nachträglich gelöscht wird (rare, aber soll keine FK-violation
  /// machen).
  pirepId String? @unique
  pirep   Pirep?  @relation(fields: [pirepId], references: [id], onDelete: SetNull)

  /// Wann pilot accepted hat (NULL bis transition ASSIGNED→ACCEPTED).
  acceptedAt DateTime?

  /// Wann die assignment COMPLETED wurde (PIREP-approve-zeitpunkt). NULL
  /// für non-completed assignments.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Pilot kann nicht zwei-mal zur selben scheduled-flight gerostert sein
  /// (siehe model-docstring).
  @@unique([pilotId, scheduledFlightId])

  /// Häufige queries:
  /// - "alle aktiven assignments meiner airline" (admin overview)
  /// - "meine assignments als pilot" (dashboard widget)
  /// - "alle assignments für diesen flight" (admin flight-detail)
  /// - "wann wurde das geroster" (audit-log + recency sortierung)
  @@index([airlineId, status])
  @@index([pilotId, status])
  @@index([scheduledFlightId])
  @@index([airlineId, createdAt])

  /// Track 5 #29: swap-request back-relations.
  swapRequestsAsRequester RosterSwapRequest[] @relation("SwapRequestRequesterAssignment")
  swapRequestsAsTarget    RosterSwapRequest[] @relation("SwapRequestTargetAssignment")
}

/// Track 5 #29 (Section F) — Swap-Request Lifecycle
///
/// Ein RosterSwapRequest repräsentiert "Pilot A will assignment X von
/// Pilot B übernehmen, im austausch für seine eigene assignment Y".
/// Default-direction: requester gibt SEINE assignment ab, kriegt die
/// TARGET-assignment. Klassisches gegenseitiges-tauschen.
///
/// Status-lifecycle:
///   PENDING ──pilot-B-akzeptiert──► ACCEPTED
///       │                             │
///       │                             └─(in DB-tx: beide RosterAssignment.pilotId getauscht)
///       │
///       ├──pilot-B-lehnt-ab──► REJECTED
///       ├──requester-cancelt──► CANCELLED
///       └──expiresAt-abgelaufen──► EXPIRED  (set durch periodic-job oder lazy bei read)
///
/// # Warum nicht eine "transaction"-table mit pirep-style status-history?
///
/// Wir hätten ein RosterSwapRequestEvent-table für jede status-transition
/// machen können — gibt schöne audit-trails. Aber für #29 ist das overkill:
/// die transitionen sind enum-werte mit timestamps (createdAt/respondedAt),
/// die admin-history kann jeder request einzeln zeigen. Falls später
/// reporting "wer rejected wie oft" gebraucht wird, mit @vam/db audit-log
/// nachrüsten (analog #28 source='swap-accept').
///
/// # Doppelte pending-swaps verhindern
///
/// Es darf nicht zwei PENDING swaps für die selbe assignment geben (sonst
/// race-condition wenn beide accepted werden). Wir erzwingen das NICHT
/// per @@unique constraint (das wäre auf [requesterAssignmentId, status]
/// = composite-partial, prisma unterstützt das nicht clean). Stattdessen
/// checkt der createSwapRequest-helper bei jedem create ob für die selbe
/// requesterAssignment schon ein PENDING swap existiert und wirft.
model RosterSwapRequest {
  id        String  @id @default(cuid())
  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  /// Die assignment die der requester abgeben will. Cascade-delete:
  /// wenn die assignment selbst gelöscht wird (z.B. weil flight cancelled),
  /// wird der swap-request auch obsolet.
  requesterAssignmentId String
  requesterAssignment   RosterAssignment @relation("SwapRequestRequesterAssignment", fields: [requesterAssignmentId], references: [id], onDelete: Cascade)

  /// Die assignment die der requester gerne hätte. Auch Cascade-delete.
  targetAssignmentId String
  targetAssignment   RosterAssignment @relation("SwapRequestTargetAssignment", fields: [targetAssignmentId], references: [id], onDelete: Cascade)

  /// Denormalisierter pilotId des requesters — vermeidet join über
  /// requesterAssignment.pilotId für inbox-queries.
  requesterId String
  requester   User   @relation("SwapRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  /// Denormalisierter pilotId des targets — vermeidet join über
  /// targetAssignment.pilotId für inbox-queries.
  targetPilotId String
  targetPilot   User   @relation("SwapRequestTarget", fields: [targetPilotId], references: [id], onDelete: Cascade)

  status RosterSwapRequestStatus @default(PENDING)

  /// Optional message vom requester an den target ("kann diesen flug nicht,
  /// muss zum kind"). 500 chars cap.
  message String? @db.VarChar(500)

  /// Optional response vom target ("klar, alles gut") oder reject-grund
  /// ("nö, hab schon plans"). 500 chars cap.
  responseMessage String? @db.VarChar(500)

  /// Wann der target geantwortet hat (ACCEPTED oder REJECTED gesetzt). NULL
  /// für PENDING/CANCELLED/EXPIRED.
  respondedAt DateTime?

  /// Wann der swap-request automatisch expired. Default = jetzt + 48h.
  /// Bei PENDING-requests deren expiresAt < jetzt, treat-as-expired in den
  /// list-helpers. Eine separate cleanup-job sollte sie auf EXPIRED setzen
  /// — wir lassen das aber lazy, kein cron im MVP.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Häufige queries:
  /// - "meine eingehenden swap-anfragen" (pilot inbox, PENDING)
  /// - "meine ausgehenden swap-anfragen" (pilot outbox, all statuses)
  /// - "alle swap-anfragen meiner airline" (admin overview)
  @@index([targetPilotId, status])
  @@index([requesterId, status])
  @@index([airlineId, status])
  @@index([airlineId, createdAt])
}

enum RosterSwapRequestStatus {
  /// Vom requester erstellt, target hat noch nicht reagiert.
  PENDING
  /// Target hat zugestimmt — beide RosterAssignment.pilotId wurden in
  /// einer transaction getauscht, beide assignments stehen jetzt auf
  /// status=SWAPPED.
  ACCEPTED
  /// Target hat abgelehnt. Beide assignments bleiben unverändert.
  REJECTED
  /// Requester hat den swap zurückgezogen bevor target geantwortet hat.
  CANCELLED
  /// 48h-window verstrichen ohne response. Lazy-set wenn jemand die
  /// inbox liest, oder durch cleanup-job. Behandelt wie REJECTED für UX.
  EXPIRED
}

model LiveSession {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  network    NetworkType
  externalId Int
  callsign   String

  // ACARS Phase 1: Trennung Network (wo) vs DataSource (wer liefert)
  dataSource         DataSource @default(VATSIM_API)
  acarsClientVersion String?
  lastAcarsHeartbeat DateTime?

  // Welle 9 (ACARS Phase 2-5): Extended telemetry from ACARS-client.
  // Alle nullable additive — VATSIM/IVAO-tracker fill nur die basics
  // weiter, nur ACARS_CLIENT füllt diese. UI muss null-tolerant sein.
  flightNumber   String?
  aircraftTitle  String? // ACARS only, e.g. "Asobo A320 Lufthansa"
  acarsSimulator Simulator?

  // Position-extension (über die basics altitude/groundSpeed/heading hinaus)
  altitudeAglFt     Int?
  indicatedAirspeed Int?
  trueAirspeed      Int?
  mach              Float?
  verticalSpeedFpm  Int?
  pitch             Float?
  bank              Float?

  // Engine — averaged over engines (client computes; server doesn't average)
  engineN1Avg Float?
  engineN2Avg Float?
  fuelFlowPph Int?
  fuelTotalKg Int?

  // State — surface + control settings
  flapsPercent     Int?
  gearDown         Boolean?
  spoilersDeployed Boolean?
  parkingBrake     Boolean?
  autopilotMaster  Boolean?

  // Forces + environment + phase
  gForce        Float?
  windSpeedKts  Int?
  windDirection Int?
  oatCelsius    Int?
  // Welle B — B1. Sea-level QNH from sim's BAROMETER PRESSURE simvar
  // (already in mb, no conversion needed). Float to preserve 1-decimal
  // precision (sim reports 1013.2, METAR's Q-group same) — Int would
  // round to 1013 and hide meaningful 0.8 mb deltas in the PIREP
  // weather-comparison UI. Nullable for pre-B1 sessions and for
  // heartbeats from clients that haven't shipped phase 1 yet.
  ambientPressureMb Float?

  // ─── Welle B — B2 phase 2A. Radio frequencies ────────────────────
  // COM1 + NAV1 frequency snapshot in MHz. Updated by every heartbeat;
  // the values reflect what the pilot's radio panel currently shows.
  // The downstream ATC-session-tracker (phase 2B) reads these and
  // matches them against the VATSIM ATC datafeed (controller online +
  // frequency + position) to populate a separate AtcSession table —
  // we deliberately don't try to derive sessions from heartbeat history
  // alone because the matching needs the VATSIM controller list which
  // isn't available at heartbeat-handler time (it's polled by the bot
  // separately and exposed via /atc/online).
  //
  // Float (not Int) because aviation radios use 8.33-kHz spacing in
  // European airspace (118.005, 118.010, …) — int would lose the
  // last two decimal digits and treat 118.005 as 118 MHz, matching
  // the wrong controller in the datafeed.
  //
  // Nullable for: (a) pre-B2 sessions, (b) heartbeats from pre-2-1
  // clients, (c) aircraft with no radio loaded (gliders, sailplanes
  // with no avionics), (d) cockpits with COM1 powered off.
  com1ActiveMhz  Float?
  com1StandbyMhz Float?
  nav1ActiveMhz  Float?

  // Welle B — B4 phase 1. Aircraft-substitution disposition recorded by
  // the pre-flight checklist when the booking-aircraft and the sim-loaded
  // aircraft disagree (e.g. pilot books A320 but loads B737 because of
  // livery issues). The ACARS-client's pre-connect dialog asks the pilot
  // which of three intents applies, and the choice is persisted here so
  // it travels through to the PIREP for admin review.
  //
  // Shape (when not null):
  //   {
  //     "intent": "intentional" | "wrongBooking",
  //     "bookedAircraftType": "A20N",    // ICAO from Booking.route.aircraft
  //     "flownAircraftType":  "B738",    // ICAO resolved by M3.8 resolver
  //     "reason": "livery not loaded"    // optional, only for "intentional"
  //   }
  //
  // We deliberately do NOT track the "wrongLoaded — sim schließen und
  // neu starten" option here because in that path the pilot aborts
  // before any heartbeat is sent. The dialog terminates the connect-
  // flow client-side; no session exists for this user yet, so there's
  // nothing to persist.
  //
  // Json over a dedicated table because: (a) one-shot per-session
  // disposition with no need for history, (b) two enum values + two
  // strings + optional reason is small enough that a relational table
  // would just be ceremony, (c) admin review reads it once via
  // PIREP-page join and doesn't need indexed queries on the fields.
  //
  // Why on LiveSession rather than Pirep: the choice is made BEFORE
  // any PIREP exists (pre-flight, before BLOCK_OFF). It rides on
  // LiveSession through the flight and the auto-PIREP path can read
  // it at PIREP-creation time to decide whether to flag the row.
  // If we attached it to Pirep directly, we'd need to either delay
  // the decision until BLOCK_ON or buffer it somewhere else in the
  // interim — extra moving parts for no benefit.
  aircraftSubstitution Json?

  currentPhase  String? // 'PreFlight'|'Pushback'|'Taxi'|'Takeoff'|'Climb'|'Cruise'|'Descent'|'Approach'|'Landing'|'TaxiIn'|'BlockOn'
  // Welle 9 Phase 5 (server-side phase-detection): timestamp when we entered
  // currentPhase. Used for hysteresis (must hold a phase ≥3s before transition,
  // ≥30s for TaxiIn→BlockOn). Updated by the heartbeat-handler and bot-trackers
  // when phase changes; left untouched when phase is stable.
  currentPhaseEnteredAt DateTime?

  // Anti-cheat: simRate >1.0 bedeutet sim-time-acceleration; totalPause-
  // Seconds aggregiert pause-zeit über die session. Beides wird in
  // PIREP-validation berücksichtigt (out-of-scope für 9A schema, das
  // ist 9F territory).
  //
  // simRate holds the LATEST value reported by the client; useful for
  // the live-display surface ("pilot is currently at 2.0x") but not
  // for retrospective audit. The Welle-C / C1 counters below cover
  // the audit dimension.
  simRate           Float?
  totalPauseSeconds Int    @default(0)

  // Welle C / C1 — time-acceleration detection (anti-cheat).
  //
  // The roadmap spec is "3 aufeinanderfolgende heartbeats mit
  // simRate > 1.0 → flag TIME_ACCELERATION_DETECTED". That requires
  // per-heartbeat history, which we'd otherwise have to reconstruct
  // by walking LiveSessionPosition rows at PIREP-creation. Instead
  // we maintain the running counters inline during heartbeat
  // processing:
  //
  //   - simRate > 1.0:   timeAccelConsecutive += 1
  //                      timeAccelMaxRun = max(timeAccelMaxRun, timeAccelConsecutive)
  //                      simRateMax      = max(simRateMax, simRate)
  //   - simRate <= 1.0:  timeAccelConsecutive = 0
  //
  // At PIREP-creation, buildPirepFlags reads timeAccelMaxRun and
  // simRateMax. If maxRun >= 3, the flag fires with the max-rate
  // observed. The same logic is intentionally separate from the
  // existing "session.simRate > 1.01" instant-rejection enforced by
  // Airline.enforceSimRate — that gate is real-time and hard-rejects;
  // this flag is post-hoc and surfaces to admin review.
  //
  // Why on LiveSession rather than per-LiveSessionPosition: position
  // rows are written every 1-2 sec during a flight (~3600+ rows for
  // a 90-min flight). Adding a column to that hot path for the sole
  // benefit of one detection at PIREP-creation would bloat the trail
  // table for no other consumer; the running-counter pattern keeps
  // the per-heartbeat write footprint stable.
  simRateMax           Float?
  timeAccelConsecutive Int    @default(0)
  timeAccelMaxRun      Int    @default(0)

  aircraftType         String?
  aircraftRegistration String?

  departureIcao  String?
  arrivalIcao    String?
  alternateIcao  String?
  cruiseAltitude Int?
  flightRules    String?
  flightRoute    String? @db.Text
  flightRemarks  String? @db.Text

  latitude    Float
  longitude   Float
  altitude    Int
  groundSpeed Int
  heading     Int
  transponder String?
  onGround    Boolean @default(false)

  connectedAt   DateTime
  lastUpdatedAt DateTime
  isActive      Boolean  @default(true)

  positions   LiveSessionPosition[]
  events      AcarsEvent[]
  // Welle B — B2 phase 2B. ATC controller-sessions attributed to this
  // flight via the freq+position matcher. One row per
  // (station-callsign, contiguous time-window); see AtcSession model
  // docstring for lifecycle.
  atcSessions AtcSession[]

  @@unique([network, externalId])
  @@index([userId, isActive])
  @@index([network, isActive])
  @@index([lastUpdatedAt])
}

model LiveSessionPosition {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  latitude    Float
  longitude   Float
  altitude    Int
  groundSpeed Int
  heading     Int
  onGround    Boolean

  // Welle 9 (ACARS Phase 2-5): per-frame telemetry extensions for
  // PIREP-replay and chart-rendering. All nullable — VATSIM/IVAO
  // tracker writes only the basics above.
  altitudeAglFt     Int?
  indicatedAirspeed Int?
  verticalSpeedFpm  Int?
  pitch             Float?
  bank              Float?
  flapsPercent      Int?
  gearDown          Boolean?
  phase             String?

  recordedAt DateTime @default(now())

  @@index([sessionId, recordedAt])
}

model Rank {
  id             String   @id @default(cuid())
  airlineId      String
  airline        Airline  @relation(fields: [airlineId], references: [id])
  name           String
  minFlightHours Float    @default(0)
  order          Int
  createdAt      DateTime @default(now())

  /// Welle 13E-8: Career-System integration.
  ///
  /// Required licenses für rank-eligibility. Wenn career-mode aktiv und
  /// requiredLicenses nicht-leer ist, kann ein pilot DIESEN rank nur
  /// erreichen wenn ALLE darin gelisteten licenses status=ACTIVE hat.
  /// Reine flight-hour-thresholds (minFlightHours) reichen dann NICHT
  /// alleine aus.
  ///
  /// Default empty-array für additive migration: alle existing ranks
  /// behalten ihre hours-only-promotion-policy bis der admin licenses
  /// als requirement einträgt.
  ///
  /// Reihenfolge irrelevant — wir checken unordered (jeder license-type
  /// muss vorhanden sein, aber egal in welcher reihenfolge).
  ///
  /// Beispiele:
  ///   - "First Officer (Narrowbody)": [ATPL, MULTI_ENGINE_RATING,
  ///     INSTRUMENT_RATING, MCC]
  ///   - "Captain (Widebody)": [ATPL, MULTI_ENGINE_RATING,
  ///     INSTRUMENT_RATING, MCC] + zusätzlich command-time-thresholds
  ///     die wir noch nicht modellieren
  ///   - "Trainee": [] (keine licenses required, nur first PIREP-tracking)
  requiredLicenses LicenseType[] @default([])

  /// Welle 13E-10: Salary-multiplier für economy-system.
  ///
  /// Faktor mit dem das base-salary pro PIREP multipliziert wird wenn
  /// der pilot diesen rank hat. Default 1.0 (= unchanged), typische
  /// werte:
  ///   - Trainee:        0.5  (training-rate)
  ///   - First Officer:  1.0  (baseline)
  ///   - Senior FO:      1.25
  ///   - Captain:        1.5
  ///   - Senior Captain: 2.0
  ///
  /// Decimal(4,2): max 99.99, min 0.01. Sinnvoller bereich: 0.25–3.00.
  /// Wert wird in calc.ts via `multiplier * baseSalary` angewandt nach
  /// der bisherigen RANK_PROGRESSION_PER_ORDER-skalierung. 13E-10 macht
  /// das einbau in calc.ts und ersetzt die order-basierte progression
  /// durch diese explizite multiplier-policy.
  ///
  /// Default 1.0 für additive migration: existing ranks zahlen weiter
  /// genau wie bisher. Admin kann die multiplier later in der ranks-
  /// admin-page setzen.
  salaryMultiplier Decimal @default(1.00) @db.Decimal(4, 2)

  users        User[]
  roleMappings DiscordRoleMapping[]

  @@unique([airlineId, name])
  @@index([airlineId, order])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())

  users   User[]
  invites Invite[]
}

model Aircraft {
  id             String         @id @default(cuid())
  airlineId      String
  airline        Airline        @relation(fields: [airlineId], references: [id])
  registration   String         @unique
  type           String
  // FK zu System-curated AircraftType-Catalog. Nullable für 1-Release-
  // Migration: existing airframes haben nur `type: String`, neue Logik
  // resolves via aircraftTypeId mit Fallback auf type-string-match.
  // Backfill-Script in Phase 1 matched bestehende `type` strings gegen
  // AircraftType.icaoType seed.
  aircraftTypeId String?
  aircraftType   AircraftType?  @relation(fields: [aircraftTypeId], references: [id])
  homeIcao       String?
  // Welle 5: Aircraft-Lifecycle-Status. Default ACTIVE für additive
  // migration — alle existing airframes mit active=true bekommen
  // status=ACTIVE, alle mit active=false bekommen status=RETIRED (im
  // backfill-step der migration). Siehe AircraftStatus-enum-docstring
  // für die semantik der einzelnen states.
  status         AircraftStatus @default(ACTIVE)
  // Legacy boolean — bleibt für app-compatibility erhalten, wird im
  // app-layer synchron mit status gehalten (status==ACTIVE → active=true).
  // Phase 2 (Welle 6+) deprecated dieses field nach UI-rollout.
  active         Boolean        @default(true)

  // Welle 5: Aircraft-Position-Tracking. Mirrors User.currentLocation*-
  // pattern (Welle 4). Wird beim PIREP-approval auf arrival.icao gesetzt
  // wenn der PIREP an dieses aircraft gebunden ist (Pirep.aircraftId).
  // Wenn null = aircraft ist an seinem homeIcao (default-fallback in der
  // UI). currentLocationAt für staleness-checks.
  //
  // Bewusst KEIN currentLocationSource hier (anders als User) — aircraft-
  // movements kommen aktuell NUR aus PIREPs. Bei späterer ferry-flight-
  // logik (Welle 7+) würde das wieder relevant.
  currentLocationIcao String?
  currentLocationAt   DateTime?

  // SimBrief Override-Hierarchie Ebene 3 (per individual airframe).
  // z.B. "this specific D-AIBL has reduced MTOW because of MEL". Über-
  // steuert Airline + Fleet defaults.
  simBriefOverlay Json?

  // Track 4 #85 (Section Q) — Aircraft-Photo. URL-basierte "uploads"
  // analog zum Airline.logoUrl-pattern: der admin trägt eine URL ein
  // (z.B. von einem repaint-shot auf flickr/imgur/eigenem CDN), wir
  // speichern den string + zeigen das image inline. Kein file-upload
  // weil im codebase keine blob-storage-infrastruktur (S3/R2) existiert
  // — URL-only ist konsistent mit allen anderen image-features.
  //
  // Wird gerendert auf der edit-page (preview oberhalb des forms) und
  // als thumbnail in der /airline/aircraft-listing. Bei null fällt das
  // UI auf ein generic ICAO-monogram-block zurück (analog logo-fallback).
  //
  // @db.Text weil image-URLs (besonders signed-S3-URLs) oft über
  // 255 chars gehen.
  photoUrl        String?  @db.Text

  // Track 4 #86 (Section Q) — Maintenance-Notes. Freier text in dem
  // der admin wartungs-relevante info notieren kann:
  //   - "Linkes Fahrwerk wackelt, prüfung 2026-06"
  //   - "Avionics-update FMS v3.2 fällig 2026-Q3"
  //   - "Cabin-refurbishment im plan für 2027"
  //
  // Bewusst KEIN strukturiertes maintenance-log mit dates/categories
  // (das käme in Welle 7+ als operational depth). Hier nur ein freies
  // text-feld als minimum-viable das den admin dazu zwingt, sich an
  // open-issues per-aircraft zu erinnern. @db.Text damit auch längere
  // notizen reinpassen (50+ zeilen wenn nötig).
  //
  // Wird gerendert:
  //   - Im edit-form als <textarea> (admin kann editieren)
  //   - In der listing als amber-highlight wenn status=MAINTENANCE
  //     UND notes gesetzt (visuell prominent damit der admin sieht
  //     warum das aircraft in wartung ist)
  //   - In der listing als subtle hint (📝) für andere status wenn
  //     notes existieren (z.B. ACTIVE + "MEL: weather-radar reduced"
  //     ist informativ aber blockt nicht)
  maintenanceNotes String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  routes Route[]
  pireps Pirep[]

  // Welle 7: Schedule-System back-relations. Beide named-relations weil
  // sowohl ScheduleTemplate als auch ScheduledFlight ein optionales
  // preferredAircraftId-FK haben (informational, keine hard-block in 7A).
  scheduleTemplatePreferences ScheduleTemplate[] @relation("ScheduleTemplatePreferredAircraft")
  scheduledFlightPreferences  ScheduledFlight[]  @relation("ScheduledFlightPreferredAircraft")

  // Track 5 #26 (Section F): Roster-assignments mit explizit zugewiesenem
  // airframe (override des ScheduledFlight.preferredAircraft). SetNull-
  // cascade damit assignment überlebt wenn das aircraft gelöscht wird —
  // admin kann dann ein neues airframe nachreichen.
  rosterAssignmentsAircraft RosterAssignment[] @relation("RosterAssignmentAssignedAircraft")

  // Welle 5: Indexes für die /airline/aircraft filter-UI.
  // - (airlineId, status): "alle aktiven aircraft meiner airline" (häufigster query)
  // - (airlineId, homeIcao): "aircraft basiert in EDDF" (hub-specific list)
  // - (currentLocationIcao): "welche aircraft sind grade in EDDF?" (booking-availability)
  @@index([airlineId, status])
  @@index([airlineId, homeIcao])
  @@index([currentLocationIcao])
}

// SimBrief Override-Hierarchie Ebene 2 — Fleet-defaults per (airline, type).
//
// Ein Fleet-row ist (airlineId, type) — z.B. (DLH, "A320") — und hält
// Defaults die für ALLE Aircraft dieses Typs in dieser Airline gelten,
// es sei denn ein einzelnes Aircraft oder ein einzelner Route überschreibt
// das Feld.
//
// Aircraft.fleetId wurde bewusst NICHT eingefügt — die Verbindung passiert
// über (airline.id, aircraft.type) lookup im resolveSimBriefOverlay-Helper.
// Vorteil: keine Migration für existierende Aircraft, keine FK-cascade-
// surprises beim Aircraft.type-rename, Fleet bleibt optional pro Type.
//
// Wenn kein Fleet-row für eine (airlineId, type) Kombination existiert,
// fällt der Helper transparent auf Airline-default zurück — d.h. Fleet
// ist eine optionale Zwischenschicht, kein Pflicht-Feld.
model Fleet {
  id              String   @id @default(cuid())
  airlineId       String
  airline         Airline  @relation(fields: [airlineId], references: [id])
  type            String // ICAO type designator, e.g. "A320", "B738"
  simBriefOverlay Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([airlineId, type])
}

model Airport {
  id        String  @id @default(cuid())
  icao      String  @unique
  iata      String?
  name      String
  city      String?
  country   String
  latitude  Float
  longitude Float
  elevation Int?

  // OurAirports.com taxonomy fields. Eingeführt mit dem ~85k-airport-bulk-
  // import. `type` ist eine kontrollierte enum (large_airport | medium_airport
  // | small_airport | heliport | seaplane_base | balloonport | closed) — als
  // String statt enum, damit OurAirports neue typen einführen kann ohne migration.
  // `continent` ist 2-letter ISO continent code (NA/EU/AS/AF/OC/SA/AN).
  // `scheduledService` = ob der airport regelmäßigen kommerziellen flug-
  // verkehr hat — wichtigster filter für virtual-airline-kontext, weil die
  // meisten heliports/balloonports/closed nicht für VAM-routes interessant sind.
  // Alle nullable damit existing rows (vor migration) nicht brechen.
  type             String?
  continent        String?
  scheduledService Boolean @default(false)
  gpsCode          String?
  wikipediaLink    String?

  // System-curated catalog: airline-admins können einzelne airports nicht
  // direkt anlegen; sie reichen einen AirportRequest ein, system-admin
  // approved/rejects. `verified` = system-admin hat die daten geprüft;
  // `false` = provisional (UI zeigt warning-badge). `active=false` ist
  // soft-delete (z.B. flughafen geschlossen) ohne FK-cascades zu brechen.
  active                Boolean         @default(true)
  verified              Boolean         @default(false)
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?           @relation("AirportVerifier", fields: [verifiedById], references: [id])
  // Nullable + unique: 1:1 zu AirportRequest. Null wenn airport direkt von
  // system-admin angelegt wurde (kein request-flow); set wenn aus approve-
  // request-creation. Audit-trail über die request-relation.
  proposedFromRequestId String?         @unique
  proposedFromRequest   AirportRequest? @relation("AirportFromRequest", fields: [proposedFromRequestId], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  routesFrom Route[] @relation("RouteDeparture")
  routesTo   Route[] @relation("RouteArrival")
  pirepsFrom Pirep[] @relation("PirepDeparture")
  pirepsTo   Pirep[] @relation("PirepArrival")

  // Detail-tabellen aus OurAirports.com — runways/frequencies/navaids als
  // separate models statt JSON-blobs damit sie indexierbar/durchsuchbar
  // sind (z.B. "alle airports mit ILS auf einer 3000m+ runway"). Cascade
  // delete: wenn ein airport gelöscht wird, gehen seine runways/freqs mit.
  // Navaids haben optional FK weil manche standalone-stations sind.
  runways     Runway[]
  frequencies AirportFrequency[]
  navaids     Navaid[]           @relation("NavaidAssociatedAirport")

  // Welle 4: Multi-Hub-System — back-relations für AirlineHub. Eine Airline
  // kann diesen airport als hub nutzen (e.g. EDDF ist hub für mehrere VAs).
  airlineHubs AirlineHub[]

  // Welle 4: Jumpseat-Audit-Trail — back-relations für JumpseatTransfer.
  // Named relations weil zwei FK-felder auf icao verweisen (from/to).
  jumpseatsFrom JumpseatTransfer[] @relation("JumpseatFrom")
  jumpseatsTo   JumpseatTransfer[] @relation("JumpseatTo")

  // Welle 13E: Flight-Schools-back-relation. Ein airport kann mehrere
  // flight-schools beherbergen (z.B. EGGD/Bristol hat mehrere training-
  // organizations). FK auf airportIcao (string), siehe FlightSchool model.
  flightSchools FlightSchool[]

  // Indexes für die /airports filter-UI: type/continent/country erlauben
  // schnelle multi-faceted queries auf 85k entries; scheduledService trennt
  // commercial- von hobby-airports.
  @@index([type])
  @@index([continent])
  @@index([country])
  @@index([scheduledService])
}

model Route {
  id               String    @id @default(cuid())
  airlineId        String
  airline          Airline   @relation(fields: [airlineId], references: [id])
  flightNumber     String
  departureId      String
  departure        Airport   @relation("RouteDeparture", fields: [departureId], references: [id])
  arrivalId        String
  arrival          Airport   @relation("RouteArrival", fields: [arrivalId], references: [id])
  aircraftId       String?
  aircraft         Aircraft? @relation(fields: [aircraftId], references: [id])
  // Required aircraft type für die route, ICAO-designator (B738, A20N, A359).
  // Bewusst String statt FK zu AircraftType-catalog: airline-admins sollen
  // im CSV-import nicht durch den AircraftTypeRequest-flow gezwungen werden
  // wenn ein type fehlt. UI kann optional gegen catalog matchen für badge/
  // verlinkung, aber persistence akzeptiert auch unkatalogisierte typen.
  // Pilot-flexibilität: route definiert _kompatiblen_ type, nicht specific
  // airframe — pilot kann jede livery fliegen die zum type passt (siehe
  // ADR Routes-Phase-1).
  aircraftTypeIcao String?
  estimatedMinutes Int
  distanceNm       Int
  active           Boolean   @default(true)
  // SimBrief Override-Hierarchie Ebene 4 (highest precedence). Per-route
  // overrides — z.B. "the cargo run to LFPG carries 0 pax + extra fuel".
  // Übersteuert alle anderen Ebenen.
  simBriefOverlay  Json?
  createdAt        DateTime  @default(now())

  pireps   Pirep[]
  bookings Booking[]

  // Welle 7: Schedule-System back-relations. Routes können mehrere
  // ScheduleTemplate-rows referenzieren (z.B. selber flightNumber zu
  // verschiedenen tageszeiten) und entsprechend viele ScheduledFlight-
  // instanzen produzieren. Cascade beim Route-delete: zugehörige
  // templates+instances werden mit aufgeräumt (Routes ohne schedules
  // sind weiter möglich).
  scheduleTemplates ScheduleTemplate[]
  scheduledFlights  ScheduledFlight[]

  // Track 4 #67 (Section M): Booking-templates die diese route nutzen.
  // Cascade-delete via BookingTemplate.route — route-löschung räumt
  // templates auf damit keine dangling vorlagen entstehen.
  bookingTemplates BookingTemplate[]

  @@unique([airlineId, flightNumber])
  @@index([departureId])
  @@index([arrivalId])
}

model Pirep {
  id          String      @id @default(cuid())
  airlineId   String
  airline     Airline     @relation(fields: [airlineId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  routeId     String?
  route       Route?      @relation(fields: [routeId], references: [id])
  aircraftId  String?
  aircraft    Aircraft?   @relation(fields: [aircraftId], references: [id])
  departureId String
  departure   Airport     @relation("PirepDeparture", fields: [departureId], references: [id])
  arrivalId   String
  arrival     Airport     @relation("PirepArrival", fields: [arrivalId], references: [id])
  state       FlightState @default(Planned)
  network     NetworkType @default(Offline)
  status      PirepStatus @default(Submitted)

  // Welle 4: Flight-Type. Default SCHEDULED, mirrors Booking.flightType bei
  // booking-linked PIREPs. Standalone-PIREPs (ohne booking, z.B. legacy-
  // import) defaulten ebenfalls auf SCHEDULED. FREE-flight-PIREPs setzen
  // das auf FREE bei file-time. Wird in stats/leaderboards für filter
  // "scheduled hours only" vs "all flight time" benutzt.
  flightType FlightType @default(SCHEDULED)

  // Welle 4: Economy-Foundation. Optional ints für passenger/cargo loads.
  // NULL = "nicht erfasst" (default für Welle 4-PIREPs ohne economy aktiv).
  // Werden ab Welle 12 (economy-launch) automatisch beim file-time gesetzt
  // wenn airline.economyEnabled. Manuelle eingabe schon ab Welle 4 möglich
  // wenn user.economyEnabled (für early-adopters/private-economy-mode).
  passengerCount Int?
  cargoKg        Int?

  flightTimeMin   Int?
  fuelUsedKg      Int?
  landingRateFpm  Int?
  remarks         String?
  submittedAt     DateTime         @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approvedById    String?
  approver        User?            @relation("PirepApprover", fields: [approvedById], references: [id])
  // 1:1 — eine Booking hat max. einen abschließenden PIREP. DB-level Uniqueness
  // schützt vor Doppel-Submit-Race-Conditions; bei v2 Multi-Leg wird ein eigenes
  // Booking-Parent/Leg-Children-Pattern entstehen, nicht 1:n hier.
  bookingId       String?          @unique
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  flightPlanCache FlightPlanCache?

  // Welle 9 (ACARS Phase 2-5): wenn dieser PIREP von einem auto-trigger
  // (BLOCK_ON event vom ACARS-client) erzeugt wurde, points back to
  // the source-event for audit-trail. NULL für manuelle PIREPs (default).
  triggeringEvent AcarsEvent? @relation("PirepTriggeringEvent")

  /// Anti-Cheat structured field (option #20).
  ///
  /// Machine-readable mirror of the [ACARS-flag: …] / [Replay-flag: …]
  /// remarks-prefix splicing that the auto-PIREP path (option #11/#19)
  /// embeds in the human-readable remarks string. Both surfaces co-exist:
  /// the remarks-prefix is what pilots see on the detail page, the
  /// structured field is what queries reach for.
  ///
  /// Shape (TypeScript: `PirepFlags` in apps/web/lib/acars/pirep-flags.ts):
  ///   {
  ///     simRate?: number;                 // > 1.01 if flagged; absent if normal
  ///     pauseSec?: number;                // > 60 if flagged; absent if normal
  ///     replayFlags?: string[];           // verifyReplay heuristic findings
  ///     hardLanding?: { severity, vsFpm } // option #7 hard-landing INCIDENT
  ///   }
  ///
  /// NULL = no flags fired (the PIREP is "clean"). An empty `{}` would
  /// mean "we evaluated and nothing fired" but we use NULL for that
  /// instead — saves a few bytes per row and matches the manual /pireps/new
  /// flow where flags-evaluation never runs (and shouldn't write `{}`).
  ///
  /// Why JSON over dedicated columns: the field-set evolves. simRate +
  /// pauseSec + replayFlags + hardLanding is the v1 shape; future heuristics
  /// (route-deviation, callsign-mismatch, fuel-overflow) would need yet
  /// more migrations as columns. JSON keeps the schema stable and lets us
  /// version the shape at the app-layer via the PirepFlags TS type.
  ///
  /// Indexed querying: postgres JSONB supports `flags->>'simRate'` style
  /// access in raw SQL. Prisma exposes `flags: { path: ['simRate'], gt: 1.01 }`
  /// which compiles to the same operator. We don't pre-index any path —
  /// the per-pilot dataset is small enough that sequential scans are fine,
  /// and the admin queue's filter-by-flag will use a `not: null` check
  /// which Prisma handles via `flags IS NOT NULL` — no path-index needed.
  ///
  /// Forward-compat: when option #1's flag-filter (PIREP-list page) is
  /// upgraded to use this column directly, the substring-match fallback
  /// remains for legacy pre-#20 rows that have flags in remarks but
  /// nothing in flags-JSON. Once a backfill-script populates structured
  /// flags for old rows, the substring fallback can be removed.
  flags Json?

  // Welle 13 (Economy MVP): Idempotency-flag für economy-processing.
  // Beim PIREP-approval-flow (apps/web/src/lib/pireps/approve.ts) prüfen
  // wir VOR dem economy-helper-call ob revenueProcessed=false. Wenn true
  // wurde der PIREP schon verarbeitet (revenue gebucht, expenses gebucht,
  // salary ausgezahlt) — re-running ist no-op. Wichtig damit:
  //   - admin re-approving einen rejected-then-fixed PIREP keine doppel-
  //     buchung verursacht
  //   - retry-on-error idempotent ist (wenn der wallet-helper crashed
  //     mid-transaction, transaction-rollback macht state konsistent;
  //     wenn nur die flag-update fehlt, processFlightEconomy retry'd)
  //   - manuelle re-evaluation (admin: "economy für PIREP X neu rechnen")
  //     explizit erst flag→false setzen muss
  //
  // revenueProcessedAt = wann wurde verarbeitet, NULL solange unprocessed.
  // Ist redundant zu approvedAt für approved-PIREPs, aber unabhängig vom
  // approval-timestamp damit re-processing-runs sichtbar sind.
  //
  // Bewusst Pirep-felder statt eigene economy-tabelle: 1:1, immer da, will
  // ohne join queryable sein ("alle pireps die noch verarbeitet werden
  // müssen"). Die transactions-back-relation gibt zugriff auf die ein-
  // zelnen entries die für diesen PIREP gebucht wurden.
  revenueProcessed   Boolean   @default(false)
  revenueProcessedAt DateTime?

  // Welle 13: alle transactions die diesem PIREP zugeordnet sind. Typisch
  // 4-6 entries (revenue passenger + revenue cargo + expense fuel + expense
  // landing + expense ground-handling + expense catering + salary-paid +
  // salary-received). SetNull-cascade via Transaction.pirep relation: wenn
  // PIREP gelöscht wird (sollte praktisch nie passieren), bleiben die
  // transactions als orphans im audit-log.
  transactions Transaction[]

  // Track 4 #60 (Section L): Kudos-records von anderen piloten für diesen
  // PIREP. Cascade-delete via PirepKudos.pirep — wenn PIREP gelöscht wird,
  // gehen die kudos mit. Unique-constraint auf (pirepId, userId) verhindert
  // doppel-kudos vom gleichen user.
  kudos PirepKudos[]

  // Track 5 #3 (PIREP-Annotations): timeline-comments von approvers
  // (instructor/airline-admin/admin) an konkreten frames im replay-trail.
  // Cascade-delete via PirepAnnotation.pirep — orphan-annotations sind
  // sinnlos sobald der PIREP weg ist.
  annotations PirepAnnotation[]

  // Track 5 #14 (Section C): Public comments unter dem PIREP. Anders
  // als PirepAnnotation (frame-bound, approver-only feedback) sind
  // comments allgemeine discussion threads — jeder authentifizierte
  // pilot kann kommentieren, body ist plaintext, kein frame-binding.
  // Cascade-delete via PirepComment.pirep.
  comments PirepComment[]

  // Track 5 #15 (Section C): Photo-posts an einem PIREP. URL-based
  // (kein file-upload V1) — author pastet einen image-link von einem
  // externen host (imgur/discord-cdn/etc) plus optional caption.
  // Cascade-delete via PirepPhoto.pirep.
  photos PirepPhoto[]

  // Track 5 #26 (Section F): Wenn dieser PIREP eine roster-assignment
  // erfüllt, link back damit beim PIREP-approve die assignment auf
  // COMPLETED gesetzt werden kann. 1:0..1 (genau eine assignment pro
  // PIREP — falls der pilot freiwillig zusätzlich was geflogen ist,
  // ist's einfach NULL). Optionale relation; SetNull damit der PIREP
  // überlebt wenn die assignment gelöscht wird.
  rosterAssignment RosterAssignment?

  @@index([userId, submittedAt])
  @@index([airlineId, status])
  @@index([approvedById])
  // Welle 13: index für "finde alle approved-pireps die noch nicht
  // economy-processed sind" (fall recovery-job + admin-re-eval-list).
  @@index([status, revenueProcessed])
}

model Award {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconUrl     String?
  criteria    Json?
  createdAt   DateTime @default(now())

  userAwards UserAward[]
}

model UserAward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  awardId   String
  award     Award    @relation(fields: [awardId], references: [id])
  awardedAt DateTime @default(now())

  @@unique([userId, awardId])
}

model Scenery {
  id          String   @id @default(cuid())
  airlineId   String?
  airline     Airline? @relation(fields: [airlineId], references: [id])
  name        String
  airportIcao String?
  provider    String?
  url         String?
  free        Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Track 4 #17 (Track 1 Polish): "Habe ich"-toggle. Eine scenery kann
  // von beliebig vielen usern als "owned" markiert werden — UserScenery
  // ist die join-tabelle. Cascade-on-delete via UserScenery.scenery
  // relation: scenery-löschung räumt die ownership-records mit auf.
  userSceneries UserScenery[]
}

/// Track 4 #17 (Track 1 #3 polish): "Habe ich diese Scenery installiert"-
/// flag pro user. Pilot kann im /sceneries-catalog auf jeden eintrag
/// klicken um zu markieren dass er die scenery besitzt — dann werden die
/// cards mit einem ✓-badge versehen und es gibt einen filter "Nur welche
/// die ich habe / nicht habe / alle".
///
/// MVP-scope: nur das toggle-flag. Keine "wishlist", keine notes, keine
/// purchase-tracking. Wenn das später relevant wird (z.B. für eine
/// "deine fleet von add-ons"-stats-page), erweitern wir das model
/// additiv.
///
/// ownedSince: zeitstempel wann der user gemarked hat. Erlaubt eine
/// "Zuletzt hinzugefügt"-sortierung in einer späteren personal-overview-
/// page. Kein zusätzlicher index nötig — pro user ist das set klein
/// (~dutzende sceneries).
///
/// notes: optional, für später ("v3.2 installiert" etc.). MVP nutzt das
/// noch nicht — schema-präsenz spart eine zukünftige migration.
model UserScenery {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sceneryId  String
  scenery    Scenery  @relation(fields: [sceneryId], references: [id], onDelete: Cascade)
  ownedSince DateTime @default(now())
  notes      String?

  @@unique([userId, sceneryId])
  @@index([userId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  airlineId String?
  airline   Airline? @relation(fields: [airlineId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([airlineId, userId, key])
}

model DiscordRoleMapping {
  id             String   @id @default(cuid())
  airlineId      String
  airline        Airline  @relation(fields: [airlineId], references: [id])
  rankId         String?
  rank           Rank?    @relation(fields: [rankId], references: [id])
  discordRoleId  String
  discordGuildId String
  createdAt      DateTime @default(now())

  @@unique([airlineId, discordRoleId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Booking {
  id        String  @id @default(cuid())
  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  // Required + onDelete: Restrict (default). Booking ohne Route ist Nonsense-State.
  // Hard-Delete einer Route erfordert vorheriges Cancel/Expire aller referenzierenden Bookings
  // — bewusste Operational Hygiene, nicht Bug.
  routeId String
  route   Route  @relation(fields: [routeId], references: [id])

  state BookingState @default(Created)

  // ─── Multi-leg tour support (option #12) ───────────────────────────
  // legCount: how many legs this booking represents end-to-end.
  // Default 1 = standard single-leg booking, identical legacy behaviour.
  // legCount > 1 = multi-leg tour: same Booking is reused as the
  // anchor for N consecutive PIREPs. Admin sets this at booking-create
  // time (no UI in v1 — must be set via direct DB update or future
  // admin-UI). Once set, immutable.
  //
  // legsCompleted: counter incremented by the auto-PIREP path each
  // time a PIREP files against this booking. When legsCompleted ==
  // legCount the booking flips to Completed; until then it sits in
  // InProgress (or Created/SimBriefDispatched if no PIREP yet).
  // Manual /pireps/new flow never decrements — orphan PIREPs that
  // get rejected are admin's problem to reconcile.
  //
  // Why two ints rather than computing legsCompleted on the fly from
  // pirep-count: the auto-PIREP transaction already updates the
  // booking row (state-flip), so adding `legsCompleted: { increment: 1 }`
  // to the same update keeps the work in one statement. Computing
  // via count(pireps) on each lookup would scale poorly once a
  // booking accumulates legs over weeks.
  legCount      Int @default(1)
  legsCompleted Int @default(0)

  // Welle 4: Flight-Type-Klassifizierung für die booking. Default SCHEDULED
  // (additive — alle existing bookings sind scheduled-typed). FREE-bookings
  // werden über separate flow erzeugt (route ist dann ein "synthetic"
  // free-flight-route per session). Per-PIREP wird bei file-time gespiegelt.
  flightType FlightType @default(SCHEDULED)

  // Hint für UI/Filter, kein Hard-Lock — actual Network kommt vom PIREP/LiveSession
  intendedNetwork NetworkType?

  // Geplante Abflugzeit (UTC). Optional — wenn null, dispatcht User ohne
  // schedule (SimBrief defaultet auf "next available departure"). Wenn
  // gesetzt, propagieren wir es als deph/depm/date in den Pattern α + Z
  // Dispatch-URLs damit SimBrief mit der richtigen METAR/TAF und Tageszeit
  // plant. v1: immutable nach booking-creation. Edit-flow käme mit dem
  // Booking-Edit-Pattern Phase 2.
  scheduledDeparture DateTime?

  dispatchedAt DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime // app-level: createdAt + 7d in v1
  cancelledAt        DateTime?
  cancellationReason String?

  pirep           Pirep?
  flightPlanCache FlightPlanCache?

  // Welle 7: 1:0..1 zur ScheduledFlight. Set wenn die booking via
  // scheduled-flight-pickup erstellt wurde (vs. ad-hoc free-pull-route-
  // booking aus der bisherigen route-liste). NULL für legacy- und
  // free-bookings. SetNull-cascade: wenn ScheduledFlight gelöscht
  // wird (sollte nicht passieren), bleibt die Booking erhalten.
  scheduledFlight ScheduledFlight?

  // Welle E / E4 — Cockpit-rooms anchored to this booking. Array-
  // relation because in rare cases (room re-opened after close, or
  // multi-leg booking with separate rooms per leg) more than one
  // room may reference the same booking. SetNull-cascade on the
  // Room side keeps history if booking is deleted.
  cockpitRooms CockpitRoom[] @relation("CockpitRoomBooking")

  @@index([userId, state])
  @@index([airlineId, state])
  @@index([routeId])
  @@index([expiresAt])
}

// Pattern α Cache-Architecture — per-Booking ownership.
// Each Booking has at most ONE FlightPlanCache (1:0..1 via @unique bookingId).
// Lifecycle-Vorbereitung: bei PIREP-File transferiert sich der Cache vom
// Booking zum Pirep (Phase 2 Implementation). bookingId wird auf null gesetzt,
// pirepId wird gesetzt. Cache überlebt damit Booking-Stornierung wenn ein
// PIREP existiert.
//
// Multi-Tenancy: airlineId bleibt explicit field (nicht via Booking-Join
// derived) für direct queries + index-effizientes Filtering.
//
// SimBrief weather TTL — 6h hardcoded weil physikalisch, nicht airline-policy.
model FlightPlanCache {
  id        String   @id @default(cuid())
  airlineId String
  airline   Airline  @relation(fields: [airlineId], references: [id])
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pirepId   String?  @unique
  pirep     Pirep?   @relation(fields: [pirepId], references: [id], onDelete: SetNull)

  ofpId        String
  rawResponse  Json
  routeString  String? @db.Text
  fuelKg       Int?
  blockTimeMin Int?

  // Track-4 #68 — OFP-Diff: snapshot der vorherigen version, immer wenn
  // der cache neu geschrieben wird (refresh Pattern α / Z), werden die
  // aktuellen werte zuerst in diese previous*-felder kopiert. Erlaubt
  // pilot zu sehen wie sich SimBrief's plan zwischen zwei generationen
  // verändert hat (z.B. fuel +120kg wegen anderer wind-konditionen,
  // block-time +5min wegen reroute durch SID/STAR-änderung).
  //
  // NULL = nie refresht (erste cache-version, no previous to compare).
  // previousOfpId == ofpId would mean "no real refresh happened" — wir
  // unterdrücken den diff dann UI-seitig.
  previousOfpId        String?
  previousFuelKg       Int?
  previousBlockTimeMin Int?
  previousRouteString  String?   @db.Text
  previousGeneratedAt  DateTime?

  generatedAt DateTime @default(now())
  expiresAt   DateTime

  @@index([airlineId])
  @@index([expiresAt])
}

// Invite-Tokens für User-Onboarding zu einer Airline. Admin generiert ein
// Invite, schickt den Link manuell (Discord-DM, Email) an den potenziellen
// Pilot. Beim Klick:
//   1. Wenn nicht eingeloggt → Discord-OAuth-Login mit callbackUrl=/invite/[token]
//   2. Nach Login: validate token (existiert, nicht expired, nicht used)
//   3. User klickt "Annehmen" → User.airlineId + (optional) User.roleId gesetzt
//   4. Invite.usedAt + usedById gesetzt → Token nicht mehr nutzbar
//
// Lifecycle:
//   - createdAt + 7d default expiry (kann override werden)
//   - usedAt = null → pending; usedAt != null → used (terminal)
//   - admin kann pending-invite revoken via setExpiresAt(now)
//
// Security:
//   - token = cuid(), 25-char unguessable, unique-indexed
//   - email-field optional, only as hint für admin (welcher pilot war
//     gemeint?), wird NICHT validiert beim accept (wir trust den
//     Discord-OAuth-Identity vom session)
//   - Token-Replay: usedAt-Check ist die einzige Defense — first-accept-wins
model Invite {
  id    String @id @default(cuid())
  token String @unique // URL-safe random token (cuid format)

  // Pre-fill / Hint — der Admin trägt ein wer eingeladen wurde, aber das
  // wird beim accept NICHT als gate genutzt. User-Identity kommt aus
  // dem authenticated NextAuth-session.
  email String?

  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id])

  // Wenn null → User wird nur airline-zugewiesen, role muss admin später
  // manuell setzen (oder der User behält null-role und ist ein "pending pilot").
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  expiresAt DateTime
  usedAt    DateTime? // null = pending; != null = used or revoked

  // Wer hat das Invite erstellt
  createdById String
  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id])

  // Wer hat das Invite eingelöst (null wenn pending)
  usedById String?
  usedBy   User?   @relation("InviteUser", fields: [usedById], references: [id])

  createdAt DateTime @default(now())

  @@index([airlineId, usedAt])
  @@index([token])
  @@index([expiresAt])
}

// ============================================================================
// SYSTEM-CURATED CATALOGS — Airport, AircraftType
//
// Phase 1 Architektur:
// - Airline-admins können nicht direkt anlegen — sie reichen einen Request ein.
// - System-admin sieht queue (/admin/requests), approves oder rejects.
// - Approve mit `asVerified=true` → catalog-entry mit verified-badge.
// - Approve mit `asVerified=false` → unverified entry (UI warning + edit-flag).
// - Subsequent verify-action: system-admin kann unverified entry später
//   verified machen (Airport.verified true setzen) wenn daten geprüft.
// - Airline-admins können trotzdem unverified entries nutzen — sie sehen
//   nur das warning-badge im picker.
//
// Audit-Trail: Catalog-entry → proposedFromRequest → request.requestedBy
// (proposer) + request.reviewer (approver). verifiedBy ist separater field
// für späteren verify-step (kann anderer system-admin sein als approver).
// ============================================================================

// AircraftType — system-curated aircraft type designations (B738, A20N, etc.).
// Initial seed: ~150 ICAO doc-8643 entries (manuell kurated TS array, alle
// verified=true). Spätere additions kommen via AircraftTypeRequest-flow.
//
// Beziehung zu Aircraft: Aircraft.aircraftTypeId optional FK. Während Phase 1
// koexistieren Aircraft.type:String und Aircraft.aircraftTypeId:String — neue
// resolver-logik bevorzugt aircraftTypeId, fällt zurück auf type-string-match
// gegen AircraftType.icaoType. Phase 2 backfill setzt aircraftTypeId für alle
// existing airframes; Phase 3 deprecated Aircraft.type field.
//
// Fleet[] relation deferred zu Phase 2 — derzeit Fleet.type:String, refactor
// auf FK braucht eigenes migration window.
// AircraftTypeRating[] deferred zu Phase 5 (Pilot-Type-Ratings feature).
model AircraftType {
  id                    String               @id @default(cuid())
  icaoType              String               @unique // ICAO doc-8643 designator: "B738", "A20N", "A359"
  name                  String // "Boeing 737-800", "Airbus A320neo"
  manufacturer          String // "Boeing", "Airbus", "Embraer"
  category              String // "narrow_body" | "wide_body" | "regional" | "cargo" | "ga"
  rangeNm               Int // Maximum range in nautical miles
  capacityPax           Int // Typical 2-class passenger capacity
  cruiseSpeedKt         Int // Cruise speed in knots
  fuelBurnKgH           Int // Approximate fuel burn kg/hour
  imageUrl              String? // Optional reference image (CC-licensed or owned)
  active                Boolean              @default(true)
  verified              Boolean              @default(false)
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?                @relation("AircraftTypeVerifier", fields: [verifiedById], references: [id])
  proposedFromRequestId String?              @unique
  proposedFromRequest   AircraftTypeRequest? @relation("AircraftTypeFromRequest", fields: [proposedFromRequestId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  aircraft Aircraft[]
}

// AirportRequest — proposal von airline-admin für catalog-erweiterung.
// State-machine: Submitted → UnderReview → (Approved | Rejected).
// Rate-limit: max 10 open (status != terminal) per user (enforced in
// server-action). Bei Approval mit `approvedAsVerified` Boolean wird:
//   1. Airport-row erstellt (proposedFromRequestId = this.id)
//   2. status = Approved, reviewedAt set, reviewer set
//   3. Wenn approvedAsVerified=true → Airport.verified=true, verifiedById=reviewer
//   4. Wenn approvedAsVerified=false → Airport.verified=false (provisional)
model AirportRequest {
  id                 String        @id @default(cuid())
  // Proposed airport data (mirrors Airport schema, except no FK fields)
  icao               String
  iata               String?
  name               String
  city               String?
  country            String
  latitude           Float
  longitude          Float
  elevation          Int?
  // Request meta
  status             RequestStatus @default(Submitted)
  reason             String? // Optional: "needed for new charter route to Greenland"
  // Submitter
  requestedById      String
  requestedBy        User          @relation("AirportRequester", fields: [requestedById], references: [id])
  // Optional airline-context — null wenn user solo (kein airline-admin)
  requestedAirlineId String?
  requestedAirline   Airline?      @relation("AirportRequestAirline", fields: [requestedAirlineId], references: [id])
  submittedAt        DateTime      @default(now())
  // Reviewer
  reviewedById       String?
  reviewer           User?         @relation("AirportReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  rejectionReason    String? // Set wenn status=Rejected
  reviewerNotes      String? // Optional internal notes (not shown to requester)
  // Set wenn status=Approved: war approve-as-verified oder approve-as-unverified?
  approvedAsVerified Boolean?
  // Back-relation 1:1: ein approved request creates max einen Airport
  createdAirport     Airport?      @relation("AirportFromRequest")

  @@index([status, submittedAt])
  @@index([requestedById, submittedAt])
  @@index([icao])
}

// AircraftTypeRequest — analog zu AirportRequest. State-machine identisch.
model AircraftTypeRequest {
  id                  String        @id @default(cuid())
  // Proposed aircraft type data
  icaoType            String
  name                String
  manufacturer        String
  category            String
  rangeNm             Int
  capacityPax         Int
  cruiseSpeedKt       Int
  fuelBurnKgH         Int
  imageUrl            String?
  // Request meta (analog AirportRequest)
  status              RequestStatus @default(Submitted)
  reason              String?
  requestedById       String
  requestedBy         User          @relation("AircraftTypeRequester", fields: [requestedById], references: [id])
  requestedAirlineId  String?
  requestedAirline    Airline?      @relation("AircraftTypeRequestAirline", fields: [requestedAirlineId], references: [id])
  submittedAt         DateTime      @default(now())
  reviewedById        String?
  reviewer            User?         @relation("AircraftTypeReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  rejectionReason     String?
  reviewerNotes       String?
  approvedAsVerified  Boolean?
  createdAircraftType AircraftType? @relation("AircraftTypeFromRequest")

  @@index([status, submittedAt])
  @@index([requestedById, submittedAt])
  @@index([icaoType])
}

// ============================================================================
// AIRPORT DETAIL DATA (Runways, Frequencies, Navaids)
//
// Importiert aus OurAirports.com CSVs (runways.csv, airport-frequencies.csv,
// navaids.csv). Source-of-truth ist `ourAirportsId` (Int) damit re-imports
// idempotent sind — wenn OurAirports einen entry updated, finden wir ihn
// per source-id wieder und updaten in-place statt einen duplikat-row zu
// erstellen.
//
// FK-strategie: Über `airportIcao` (String) statt `airportId` (cuid). Das
// CSV bringt `airport_ident` mit, was identisch zu Airport.icao ist (selber
// import-source). Cascade-delete: wenn ein Airport gelöscht wird, gehen
// seine runways/frequencies mit. Navaids haben optional FK weil manche
// navaids "associated" mit einem airport sind (e.g. FRA VOR), andere
// standalone (en-route navaids).
//
// Verifications-policy: Im gegensatz zu Airport.verified gibt es hier kein
// verified-flag — die daten sind aus OurAirports und werden 1:1 übernommen.
// Falls airline-admins eine korrektur brauchen, geht das über einen edit-
// flow auf den Airport selbst (zukünftig), nicht per request-flow auf die
// detail-tabellen.
// ============================================================================

// Runway — physische landebahn an einem airport. Jede runway hat zwei
// "ends" (low end + high end), z.B. RWY 09/27 hat le_ident=09 + he_ident=27.
// Heading in degrees true (degT), nicht magnetic.
model Runway {
  id            String  @id @default(cuid())
  ourAirportsId Int?    @unique
  airportIcao   String
  airport       Airport @relation(fields: [airportIcao], references: [icao], onDelete: Cascade)

  // Physische dimensionen
  lengthFt Int? // Runway length in feet (e.g. 11000 = ~3350m)
  widthFt  Int? // Runway width in feet (e.g. 200 = ~60m)
  surface  String? // ASPH, CONC, GRASS, GRAVEL, WATER, etc — kontrolliertes vocab aus OurAirports
  lighted  Boolean @default(false) // Hat runway lights?
  closed   Boolean @default(false) // Permanent closed runway

  // Low-end (numerisch niedrigere kennung, z.B. "09" für 09/27 paar)
  leIdent       String? // "09", "13L", "32R"
  leLatitude    Float?
  leLongitude   Float?
  leElevationFt Int?
  leHeadingDegT Float? // True heading 0-359
  leDisplacedFt Int? // Displaced threshold offset

  // High-end (z.B. "27" für 09/27 paar)
  heIdent       String?
  heLatitude    Float?
  heLongitude   Float?
  heElevationFt Int?
  heHeadingDegT Float?
  heDisplacedFt Int?

  // Indizes für: per-airport-lookup (häufigster query), filter "alle airports
  // mit closed=false runways" für route-planning, surface-filter (z.B. "nur
  // hartbahnen für jets").
  @@index([airportIcao])
  @@index([surface])
  @@index([closed])
}

// AirportFrequency — radio-frequenzen pro airport (TWR, GND, APP, ATIS, etc).
// Ein airport hat typisch 3-15 frequencies. `type` ist OurAirports-vocab
// (TWR, GND, APP, DEP, ATIS, AWOS, ASOS, CTAF, ARCAL, MULTICOM, UNICOM, etc).
model AirportFrequency {
  id            String  @id @default(cuid())
  ourAirportsId Int?    @unique
  airportIcao   String
  airport       Airport @relation(fields: [airportIcao], references: [icao], onDelete: Cascade)

  type         String // TWR, GND, APP, ATIS, etc
  description  String? // Optional human-readable, z.B. "Tower South"
  frequencyMhz Float // Civilian VHF aviation band 118-137 MHz

  @@index([airportIcao])
  @@index([type])
}

// Navaid — VOR/NDB/DME/ILS/etc stations. Manche sind "associated" mit einem
// airport (e.g. ILS approach für RWY 25R), manche standalone (en-route VOR).
// `ident` ist der callsign der station (3-5 chars, z.B. "FRA" für Frankfurt VOR).
model Navaid {
  id            String @id @default(cuid())
  ourAirportsId Int?   @unique

  ident        String // Callsign, z.B. "FRA", "TGO", "WUR"
  name         String // Voll-name, z.B. "Frankfurt VOR-DME"
  type         String // VOR, VOR-DME, VORTAC, NDB, NDB-DME, DME, TACAN, ILS, GS, MARKER, OM, MM, IM
  frequencyKhz Int? // Frequency in kHz (VOR/ILS sind MHz aber gespeichert *100, NDB ist kHz)
  latitude     Float
  longitude    Float
  elevationFt  Int?
  isoCountry   String // ISO 2-letter

  // Optional DME-component für VOR-DME, VORTAC pairs
  dmeFrequencyKhz Int?
  dmeChannel      String?
  dmeLatitude     Float?
  dmeLongitude    Float?
  dmeElevationFt  Int?

  slavedVariationDeg   Float? // Magnetic variation slaved into the station
  magneticVariationDeg Float?
  usageType            String? // HI (high-altitude airway), LO (low), BOTH, TERM (terminal), RNAV
  power                String? // LOW, MEDIUM, HIGH

  // Optional FK zu Airport (manche navaids sind "owned by" einem airport,
  // andere standalone). Cascade SetNull statt Cascade-Delete, damit ein
  // navaid überlebt wenn der zugeordnete airport mal entfernt wird.
  associatedAirportIcao String?
  associatedAirport     Airport? @relation("NavaidAssociatedAirport", fields: [associatedAirportIcao], references: [icao], onDelete: SetNull)

  @@index([associatedAirportIcao])
  @@index([type])
  @@index([ident])
}

// ============================================================================
// WELLE 4 — HUB-SYSTEM & POSITION-TRACKING
//
// AirlineHub: many-to-one zu Airline mit isPrimary-flag. Eine Airline kann
// 1..N hubs haben. Genau einer ist primary (default-base für neue piloten,
// scheduling-anchor). Multi-tenant: hub-FK ist über airportIcao (string)
// statt cuid, mirrors Runway/AirportFrequency-pattern weil airport.icao
// system-curated und stable ist.
//
// JumpseatTransfer: append-only audit-log für no-flight position-changes.
// Nicht state-machine — eine reihe = ein transfer. Wird beim app-flow
// inserted UND User.currentLocationIcao+Source+At werden im selben
// transaction-block gesetzt. Reason für audit-fragen ("warum ist pilot
// in Asien gelandet wenn sein hub Berlin ist").
// ============================================================================

// AirlineHub — multi-hub-system pro airline. EDDF/EDDM für DLH-virtual,
// EGLL/EGLC für BAW-virtual, etc. Eine Airline hat 1..N hubs, einer ist
// primary (UI-default, scheduling-default-anchor). isPrimary-uniqueness
// per airlineId wird via app-logik enforced (nicht @@unique constraint
// weil postgres partial-unique-indexes nicht direkt in prisma schema
// ausdrückbar sind ohne raw migration).
model AirlineHub {
  id          String   @id @default(cuid())
  airlineId   String
  airline     Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  // FK über icao (string) statt cuid — mirrors Runway/AirportFrequency
  // pattern. airport.icao ist system-curated und stable (verifizierte
  // catalog-entries werden nicht umbenannt).
  airportIcao String
  airport     Airport  @relation(fields: [airportIcao], references: [icao])
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  // (airlineId, airportIcao) muss eindeutig sein — keine duplikate.
  @@unique([airlineId, airportIcao])
  // Index für "wer ist primary-hub von airline X?" (häufigste query)
  @@index([airlineId, isPrimary])
}

// JumpseatTransfer — append-only audit-log. Pilot bewegt sich ohne flug
// von einem icao zu einem anderen (typisch: zurück zum hub nach gestrandet,
// oder admin-driven correction). Eine reihe pro transfer, kein update —
// historisch nachvollziehbar.
//
// Beziehung zur User-position-tracking: Beim transfer-insert wird in der
// gleichen transaction User.currentLocationIcao = toIcao gesetzt,
// currentLocationSource = JUMPSEAT, currentLocationAt = NOW. Der transfer
// ist die "warum" und User.* das "wo jetzt".
//
// Welle 4 hat noch keine cost/restriction-logik (kommt mit economy in
// Welle 12+). Vorerst sind alle transfers kostenfrei und unrestricted.
model JumpseatTransfer {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  // Source-airport — über icao (string), mirrors Runway pattern.
  fromIcao    String
  fromAirport Airport        @relation("JumpseatFrom", fields: [fromIcao], references: [icao])
  // Target-airport — analog.
  toIcao      String
  toAirport   Airport        @relation("JumpseatTo", fields: [toIcao], references: [icao])
  reason      JumpseatReason
  // Optional notes — admin-transfer-grund o.ä. Wenn NULL = pilot-self-
  // service-transfer (RETURN_TO_HUB, HUB_TO_HUB).
  notes       String?
  createdAt   DateTime       @default(now())

  // Häufigste query: "alle transfers von user X, neueste zuerst" (für
  // jumpseat-history-UI auf pilot-profile).
  @@index([userId, createdAt])
  // Sekundär: "alle transfers nach airport X" (admin-debug).
  @@index([toIcao, createdAt])
}

// ============================================================================
// WELLE 7 — SCHEDULE GENERATOR
//
// Zwei-schichten-architektur:
//
//   ScheduleTemplate    →    ScheduledFlight    →    Booking    →    Pirep
//   (recurring rule)         (concrete instance)     (pilot)        (filed)
//
// 1. ScheduleTemplate: admin definiert wiederkehrende muster ("Mo+Mi+Fr 14:30 UTC
//    auf route LH123, A320 als preferred airframe"). Templates haben einen
//    validity-window (validFrom..validUntil) und einen active-flag für
//    soft-disable.
//
// 2. Generator-helper (@/lib/schedule, kommt 7A-2) materialisiert templates
//    zu konkreten ScheduledFlight-instanzen über einen date-range. Idempotent:
//    läuft re-runs ohne duplikate (skipt schon-existierende slots an gleichem
//    departureTime + templateId).
//
// 3. Pilot pickt einen Planned-slot aus seiner schedule-view → wir erstellen
//    eine Booking und linken sie atomar via ScheduledFlight.bookingId. Slot
//    flippt auf Booked.
//
// 4. Booking wird durch den existierenden booking-flow gefahren (SimBrief
//    dispatch, PIREP file, approval). Bei PIREP-approval setzen wir den
//    ScheduledFlight auf Completed.
//
// CHARTER-flights: ein ScheduledFlight ohne templateId = einmal-flug der
// nicht aus einem recurring-pattern stammt. Admin erstellt manuell, pilot
// pickt wie eine reguläre scheduled-instanz. FlightType.CHARTER wird beim
// booking gesetzt (statt SCHEDULED).
//
// Was 7A NICHT macht: hard-conflicts auf preferredAircraft (A320 ist um
// 14:30 schon auf LH456 → blockiere LH789). Conflict-detection als UI-
// warning ja, hard-block kommt mit fleet-rotation-logik später.
// ============================================================================

// ScheduleTemplate — wiederkehrendes flug-muster pro route. Admin-only-CRUD
// via /airline/schedule (kommt 7B-1). Generator-helper kann instanzen für
// ein date-window materialisieren.
model ScheduleTemplate {
  id        String  @id @default(cuid())
  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  routeId   String
  route     Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  // Optional human-friendly label, z.B. "Daily MUC-FRA Morning Shuttle".
  // Falls NULL, rendert UI route.flightNumber + departureTime als fallback.
  label String?

  // Wochentage an denen dieses template ausgeführt wird. ISO-8601: 1=Monday,
  // 7=Sunday. Postgres Int[]-array — direkter array-contains query möglich
  // ("alle templates die montags laufen"). Validation in app-layer:
  // Werte müssen in {1..7} liegen, mind. 1 element.
  daysOfWeek Int[]

  // Departure-time als minuten-seit-mitternacht UTC (0..1439). Bewusst Int
  // statt String "HH:mm": sortierbar (ORDER BY departureMinuteUtc), arith-
  // metisch (z.B. "alle flüge zwischen 06:00-12:00 UTC" als single range-
  // query), keine timezone-ambiguität. Display-helper rendert zu "HH:mm Z".
  // Wahl von UTC über local-time-of-airport: vermeidet DST-surprises wenn
  // Europa shiftet aber Asia nicht, und matcht wie SimBrief/VATSIM/IVAO
  // über zeit denken.
  departureMinuteUtc Int

  // Validity-window. Generator erstellt instanzen NUR für dates in
  // [validFrom, validUntil ?? +infinity]. Use-cases: seasonal routes
  // (sommer-only), graceful-retire (validUntil setzen statt template-
  // löschen, behält historische instances/bookings intakt), promo-
  // schedules (limited-time offers).
  validFrom  DateTime
  validUntil DateTime?

  // Optional preferred airframe. NULL = generator setzt keinen airframe an
  // den instanzen, pilot picked beim booking. Set = generator inheritet
  // den preferredAircraftId an die generierten ScheduledFlight-rows.
  // Conflict-detection (airframe doppelt verplant) ist 7A nur informational
  // im UI; hard-block ist out-of-scope. SetNull bei aircraft-delete damit
  // template überlebt.
  preferredAircraftId String?
  preferredAircraft   Aircraft? @relation("ScheduleTemplatePreferredAircraft", fields: [preferredAircraftId], references: [id], onDelete: SetNull)

  // Soft-disable. Generator skipt active=false templates auch wenn date in
  // validity-window. Existing instanzen bleiben bestehen (sie sind ja schon
  // generated). Re-aktivieren = einfach active=true setzen.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledFlights ScheduledFlight[]

  // Häufige queries:
  // - "alle aktiven templates meiner airline" (admin overview)
  // - "alle templates für route X" (route-detail-view, falls je gebraucht)
  @@index([airlineId, active])
  @@index([routeId])
}

// ScheduledFlight — konkrete generierte instanz oder ad-hoc charter-slot.
// Lebenszyklus: Planned → Booked → Completed (oder Cancelled).
model ScheduledFlight {
  id        String  @id @default(cuid())
  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  routeId   String
  route     Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  // Optional template-FK. Set für generator-erzeugte instanzen, NULL für
  // ad-hoc charter-flights die admin manuell anlegt. Cascade-on-delete:
  // wenn template gelöscht wird, gehen alle daraus generierten instanzen
  // mit (charter-flights bleiben bestehen weil sie kein template haben).
  templateId String?
  template   ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Voll-aufgelöste UTC-departure. Generator berechnet das aus template.
  // validFrom + recurrence-rule (daysOfWeek + departureMinuteUtc) für jeden
  // tag im generation-window. Charter-flights haben das direkt vom admin
  // gesetzt.
  departureTime DateTime

  // Optional preferred airframe — inherited vom template oder direkt am
  // charter gesetzt. Selbe semantik wie ScheduleTemplate.preferredAircraft:
  // informational in 7A, hard-conflict-detection später.
  preferredAircraftId String?
  preferredAircraft   Aircraft? @relation("ScheduledFlightPreferredAircraft", fields: [preferredAircraftId], references: [id], onDelete: SetNull)

  status ScheduledFlightStatus @default(Planned)

  // 1:0..1 zur Booking. Set wenn ein pilot den slot gepickt hat. SetNull-
  // cascade falls Booking gelöscht wird (sollte normalerweise nicht passieren
  // — Bookings werden cancelled, nicht deleted), damit der slot in einem
  // sauberen state landet.
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Häufige queries:
  // - "alle planned flights von airline X in den nächsten N tagen" (pilot-
  //   facing booking-view + admin grid)
  // - "alle flights zu route X, sortiert by departure" (route-detail)
  // - "alle flights die airframe Y nutzen, sortiert by departure" (conflict-
  //   detection beim template-anlegen)
  @@index([airlineId, status, departureTime])
  @@index([routeId, departureTime])
  @@index([preferredAircraftId, departureTime])
  @@index([departureTime])

  // Track 5 #26 (Section F): Roster-assignments für diesen scheduled-flight.
  // 1:N weil theoretisch ein flight an mehrere pilots geroster-werden kann
  // (z.B. captain + first-officer roster-trennung). Erst-version unterstützt
  // das aber NICHT als feature — siehe @@unique constraint im RosterAssignment
  // model. Cascade-delete via RosterAssignment.scheduledFlight damit cleanup
  // sauber ist wenn ein flight cancelled wird.
  rosterAssignments RosterAssignment[]
}

// ─────────────────────────────────────────────────────────────────────────
// Welle 9: ACARS Phase 2-5
// ─────────────────────────────────────────────────────────────────────────

enum Simulator {
  MSFS
  P3D
  XPLANE
  FSX
}

/// Lifecycle-events vom ACARS-client. Stored as audit-trail and used by
/// 9F auto-PIREP-trigger (BLOCK_ON erstellt PIREP-draft). Other events
/// like INCIDENT (HARD_LANDING/STALL/OVERSPEED) sind future flagging-
/// targets.
enum AcarsEventType {
  PHASE_CHANGE
  TOUCHDOWN
  BLOCK_ON
  BLOCK_OFF
  INCIDENT
  CONNECTION_LOST
  CONNECTION_RESUMED
}

/// Temporäre 15-min-codes die der user in der Web-Settings-page generiert
/// und in der ACARS-app eingibt. Nach redeem wird `consumedAt` gesetzt
/// und der code ist verbraucht — neue requests invalidieren alte
/// unbenutzte codes (force-expire über expiresAt-update). Lifecycle:
///   1. user clicks "Pair Device" → row created, expiresAt = now+15min
///   2. user types code in app → app POSTs /api/acars/pairing/redeem
///   3. server validates (exists, not consumed, not expired), generates
///      acarsToken, sets consumedAt
///   4. row stays als audit-record (kann via cleanup-job gelöscht werden
///      wenn DB-bloat — aber bei realistic-volume vernachlässigbar)
model AcarsPairingCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Format: 9 chars in 3-3-3 segments mit unambiguous-alphabet
  // (ohne 0/O/1/I/L), z.B. "X4F-7K2-9PB". Generation in @/lib/acars/pairing.
  code String @unique

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([code])
  @@index([userId, consumedAt])
}

/// Lifecycle + telemetry-events vom ACARS-client. Stored separat von
/// LiveSessionPosition damit positions-stream high-frequency (1-2s) ist
/// und events low-frequency aber semantisch wichtig sind. Payload ist
/// Json damit verschiedene event-types ihre eigenen schemas einbringen
/// können ohne dass jedes feld eigene column kriegt.
///
/// Payload-conventions (app-layer, kein schema-constraint):
///   - PHASE_CHANGE: { from: string, to: string }
///   - TOUCHDOWN: { verticalSpeedFpm, gForce, flapsPercent, indicatedAirspeed }
///   - BLOCK_ON: { totalFlightTimeMin, totalFuelUsedKg, blockTimeMin }
///   - BLOCK_OFF: { fuelOnBoardKg }
///   - INCIDENT: { kind: 'HARD_LANDING'|'STALL'|'OVERSPEED'|'OVERBANK', severity, value }
///   - CONNECTION_LOST: { lastHeartbeatAt, reason }
///   - CONNECTION_RESUMED: { gapSeconds }
///
/// triggeredPirepId ist nur für BLOCK_ON-events gesetzt die einen draft-
/// PIREP erzeugt haben. 1:1 (jedes event triggert max 1 PIREP, jeder
/// auto-erstellte PIREP hat genau 1 source-event).
model AcarsEvent {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type      AcarsEventType
  timestamp DateTime       @default(now())

  payload Json?

  triggeredPirepId String? @unique
  triggeredPirep   Pirep?  @relation("PirepTriggeringEvent", fields: [triggeredPirepId], references: [id], onDelete: SetNull)

  @@index([sessionId, type, timestamp])
}

// ─────────────────────────────────────────────────────────────────────────
// Welle B — B2 phase 2B: AtcSession (ATC-attribution per LiveSession)
// ─────────────────────────────────────────────────────────────────────────

/// Records that a pilot was tuned to a specific VATSIM ATC controller's
/// frequency during a flight. Populated by the ATC-matcher (lib/acars/
/// atc-matcher.ts) which runs from the heartbeat-handler whenever the
/// LiveSession's com1ActiveMhz matches an online controller's frequency
/// within ±5 kHz tolerance AND the pilot's position is within the
/// facility-type's reasonable coverage range (e.g. <50 nm for TWR, <300
/// nm for CTR).
///
/// One row per (session, station-callsign, contiguous time-window):
/// when the pilot tunes 121.6 EDDF_GND for 3 minutes, then switches to
/// 119.9 EDDF_TWR for 5 minutes, that's TWO rows. If they switch BACK
/// to 121.6 EDDF_GND later, that's a THIRD row — sessions are not
/// resumed across gaps. The "EDDF_GND" station can appear multiple
/// times per flight if the pilot tuned away and back.
///
/// Lifecycle:
///   - Matcher creates a row with endedAt=null when it first sees a
///     pilot-frequency matching an online controller.
///   - On subsequent heartbeats with the same match, it bumps the
///     `endedAt` (or rather, leaves it null and uses lastUpdatedAt
///     as the effective endpoint).
///   - When the pilot tunes away (no match for 2+ heartbeats), the
///     matcher closes the row by setting endedAt to the timestamp of
///     the last matching heartbeat.
///   - When the LiveSession itself goes inactive (BLOCK_ON, stale
///     cleanup), any still-open AtcSession rows are closed with
///     endedAt = LiveSession.lastUpdatedAt.
///
/// The PIREP-page reads these rows via session → AtcSession[] and
/// renders an "ATC Sessions" list ordered by startedAt: "12:42 EDDF_GND
/// 121.6 (5 min)".
///
/// Cascade: session deletion deletes its AtcSession rows. Historical
/// AtcSession data isn't worth preserving when the parent flight record
/// goes away — it's pure context for the flight, not a standalone
/// artifact.
model AtcSession {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// VATSIM controller callsign, e.g. "EDDF_GND", "LANGEN_R", "KJFK_TWR".
  /// Format: {LOCATION}_{POSITION}. Always uppercase. Up to 32 chars to
  /// accommodate edge-case formats like "LON_NW_CTR" or "EDDF_S_GND".
  stationCallsign String @db.VarChar(32)

  /// Position type (GND/TWR/APP/CTR/DEL/FSS) parsed from the callsign
  /// suffix. Denormalized from the suffix for fast filtering / UI
  /// color-coding. Always uppercase, 3-4 chars.
  facilityType String @db.VarChar(8)

  /// Frequency in MHz at the time of the match. Stored as Float (not
  /// Int) for the same 8.33-kHz-spacing reason as LiveSession's radio
  /// columns. We store the controller's frequency, not the pilot's
  /// com1ActiveMhz — the two should be within ±5 kHz at match time but
  /// the controller's exact value is the authoritative one to display
  /// (e.g. "EDDF_GND 121.605" not "121.610" rounded).
  frequencyMhz Float

  /// VATSIM CID of the controller. Used to disambiguate same-callsign
  /// sessions across reconnect (controller logs off then back on with
  /// same EDDF_GND — that's a new row because the cid changed).
  controllerCid Int

  /// Display name of the controller (for the PIREP-UI). VATSIM users
  /// can change this between logons; we capture the value at match time.
  controllerName String @db.VarChar(64)

  /// Timestamp of the heartbeat that first matched this controller for
  /// this session. Wall-clock at the heartbeat-handler — NOT sim-time.
  startedAt DateTime @default(now())

  /// Timestamp of the last heartbeat that matched. NULL while the
  /// session is still actively tuned. Set when the matcher detects
  /// the pilot has tuned away (2+ heartbeats with no match) or when
  /// the parent LiveSession closes.
  endedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-session + ordered fetch is the dominant query (PIREP-page).
  // Add (sessionId, startedAt) so the ORDER BY uses the index directly.
  @@index([sessionId, startedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Welle 13: Economy MVP — Wallet + Transaction
// ─────────────────────────────────────────────────────────────────────────

/// Wallet — VAM$-konto. Owner ist entweder ein User (USER), eine Airline
/// (AIRLINE/AIRLINE_PAYROLL/AIRLINE_MAINTENANCE), oder das system selbst
/// (SYSTEM für treasury/sinks). Welcher der zwei FK-felder gesetzt ist,
/// hängt vom ownerType ab — siehe constraint-explanation unten.
///
/// Currency-design: VAM$ ist die einzige currency im MVP, aber das field
/// existiert für forward-compat (multi-currency-system in Welle 16+
/// stocks/börse, oder regional-currencies). Im MVP wird `currency` immer
/// auf "VAM$" gesetzt, app-layer enforced.
///
/// Balance: Decimal(18, 2) für 16 vorkomma-stellen + 2 nachkomma. Erlaubt
/// werte bis ~10^16 VAM$ — way mehr als realistisch je nötig (selbst
/// hyper-inflation-szenarien). 2 nachkomma-stellen für VAM-cent-präzision.
/// Niemals Float — finanz-arithmetic darf keine binary-floating-point-
/// präzisionsfehler haben (0.1 + 0.2 != 0.3 in IEEE 754).
///
/// CreditLimit: optional. NULL = kein overdraft erlaubt (default für USER
/// und SYSTEM). Set = airline kann temporär ins minus gehen bis zum limit
/// (Welle 15+ aircraft-financing). Im MVP nicht aktiv genutzt aber schema-
/// präsent damit später migration trivial wird.
///
/// Composite-uniqueness via @@unique([ownerType, ownerUserId, ownerAirlineId,
/// walletType]): ein owner kann mehrere wallet-types haben (primary,
/// payroll, maintenance) aber nicht zwei "primary"-wallets. NULL-fields
/// im unique-constraint werden in postgres NICHT als gleich behandelt
/// (NULL != NULL semantik), was hier passt: USER-wallets haben null
/// ownerAirlineId, AIRLINE-wallets haben null ownerUserId — die uniqueness
/// greift effektiv pro owner-typ.
///
/// Owner-FK-constraint (app-layer):
///   - ownerType=USER → ownerUserId REQUIRED, ownerAirlineId NULL
///   - ownerType=AIRLINE/AIRLINE_PAYROLL/AIRLINE_MAINTENANCE → ownerAirlineId REQUIRED, ownerUserId NULL
///   - ownerType=SYSTEM → beide NULL (system-singleton)
/// CHECK-constraint wäre theoretisch möglich via raw SQL migration, aber
/// im MVP enforced der wallet-helper (createWallet) die invariante. Wenn
/// das je problematisch wird, addieren wir die DB-constraint nachträglich.
model Wallet {
  id             String          @id @default(cuid())
  ownerType      WalletOwnerType
  ownerUserId    String?
  ownerUser      User?           @relation("UserWallets", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerAirlineId String?
  ownerAirline   Airline?        @relation("AirlineWallets", fields: [ownerAirlineId], references: [id], onDelete: Cascade)

  // walletType ist string statt enum damit airlines später custom-wallets
  // anlegen können (z.B. "marketing", "fuel-hedging") ohne migration.
  // App-layer kennt die canonical values: "primary" | "payroll" |
  // "maintenance". MVP nutzt nur "primary" für USER + AIRLINE.
  walletType String @default("primary")

  currency String  @default("VAM$")
  balance  Decimal @default(0) @db.Decimal(18, 2)

  // Optional credit-line. NULL = kein overdraft. Wenn set, kann balance
  // temporär bis -creditLimit gehen. App-layer-check im transfer-helper
  // verhindert weitere outflows wenn balance-creditLimit erreicht.
  creditLimit Decimal? @db.Decimal(18, 2)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ein owner-tuple darf nicht denselben walletType doppelt haben.
  @@unique([ownerType, ownerUserId, ownerAirlineId, walletType])
  // Häufige queries: lookup by owner.
  @@index([ownerUserId])
  @@index([ownerAirlineId])
}

/// Transaction — append-only audit-log einer wallet-bewegung. Niemals
/// updated, niemals deleted — corrections passieren via gegenläufige
/// neue transaction (typ=ADJUSTMENT_ADMIN). Begründung: anti-cheat,
/// dispute-resolution, regulatory-traceable history.
///
/// Sign-convention für `amount`:
///   + (positive) = inflow zum wallet (revenue, salary received, transfer in)
///   - (negative) = outflow vom wallet (expense, salary paid, transfer out)
/// `balanceAfter` = snapshot der wallet.balance NACH dieser transaction.
/// Redundant zu (vorherige balance + amount) aber wichtig für audit:
/// erlaubt verifikation dass kein zwischen-stand korrupt ist (sum of
/// balance-deltas vs final wallet.balance).
///
/// `category` ist string statt enum damit app-layer flexibel sub-typen
/// erfinden kann (z.B. "fuel-jet-a", "fuel-avgas") ohne migration. Der
/// canonical type-enum ist `type` (TransactionType), category ist die
/// freier-text-erweiterung. UI gruppiert per type, drill-down per category.
///
/// Optional FKs (pirep, booking) für direct-link audit-views — "alle
/// transactions zu PIREP X" ohne metadata-json-parsing. SetNull-cascade
/// damit transactions als orphan im audit-log überleben wenn quelle
/// gelöscht wird.
///
/// `counterpartyWalletId` ist STRING (nicht FK) für transfers. Begründung:
/// keep transactions atomic-insertable ohne FK-cascade-surprises wenn
/// counterparty-wallet später cascade-deleted wird. App-layer kann via
/// findUnique(id=counterpartyWalletId) das wallet auflösen wenn nötig.
/// Kein FK schützt audit-trail vor löschungen.
///
/// `metadata` Json für flexible context (z.B. "passenger-class-breakdown",
/// "twitch-viewer-name", "marketing-campaign-id"). UI rendert generic
/// key-value-table für unbekannte felder, spezial-renderer für canonical
/// metadata-shapes (siehe wallet-helper docs in 13B).
model Transaction {
  id           String          @id @default(cuid())
  walletId     String
  wallet       Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount       Decimal         @db.Decimal(18, 2)
  balanceAfter Decimal         @db.Decimal(18, 2)
  type         TransactionType
  category     String
  description  String

  // Optional source-context (FKs für convenient queries)
  pirepId   String?
  pirep     Pirep?  @relation(fields: [pirepId], references: [id], onDelete: SetNull)
  bookingId String?

  // Counterparty wallet bei transfers — string (kein FK) bewusst, siehe
  // model-docstring oben.
  counterpartyWalletId String?

  metadata Json?

  createdAt DateTime @default(now())

  // Häufigste query: tx-history per wallet, neueste zuerst.
  @@index([walletId, createdAt])
  // Audit-views: alle transactions zu einem PIREP/booking.
  @@index([pirepId])
  @@index([bookingId])
  // Filter "alle expenses dieser airline" — type ist hier sinnvoll
  // weil enum-werte indexed sortier-stabil sind.
  @@index([walletId, type])
}

// ─────────────────────────────────────────────────────────────────────────
// Welle 13E: Career-System — Licenses, Type-Ratings, Flight-Schools
// ─────────────────────────────────────────────────────────────────────────

/// PilotLicense — eine konkrete license-instanz (PPL, ATPL, etc.) die ein
/// pilot besitzt. Pro user max eine pro type (siehe @@unique([userId, type])).
///
/// Lifecycle:
///   - Issue: admin grant via /airline/pilots/[id] (13E-6) oder enrollment-
///     completion (13E-13/14 nach exam-pass). Status startet ACTIVE.
///   - Validity: einige licenses haben expiresAt (z.B. IR = 1 jahr). Andere
///     sind lifetime (PPL) → expiresAt=null. Cron-job (späterer welle) flippt
///     status auf EXPIRED wenn expiresAt < now().
///   - Renewal: admin oder enrollment-completion setzt neuen expiresAt
///     und status zurück auf ACTIVE.
///   - Revocation: admin-action setzt status auf REVOKED + reason. License-
///     row bleibt für audit-trail (kein delete).
///
/// certificateNumber: human-readable identifier. Format konvention (app-
/// layer, kein constraint): "VAM-{TYPE}-{YYYY}-{6-digit-sequence}".
/// @@unique global damit zwei piloten nicht denselben certificate-number
/// haben können.
///
/// issuingAuthority: string statt enum damit man später regional issuers
/// addieren kann ohne migration. Canonical values: "EASA", "FAA", "TCCA",
/// "VAM-Internal". Default beim grant ist "VAM-Internal".
model PilotLicense {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation("UserLicenses", fields: [userId], references: [id], onDelete: Cascade)
  type              LicenseType
  issuedAt          DateTime
  expiresAt         DateTime?
  issuingAuthority  String        @default("VAM-Internal")
  certificateNumber String        @unique
  status            LicenseStatus @default(ACTIVE)

  // Audit-trail: wer hat die license ausgestellt? NULL für system-issued
  // (seed, auto-grant via flight-school-completion). SetNull cascade
  // damit license-records erhalten bleiben wenn der issuing-admin
  // gelöscht wird.
  issuedById String?
  issuedBy   User?   @relation("LicensesIssued", fields: [issuedById], references: [id], onDelete: SetNull)

  // Optional notes (revocation-reason, suspension-reason, etc).
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pro user max eine license pro type.
  @@unique([userId, type])
  // Häufige queries:
  //   - "alle aktiven licenses dieses users" (canPilotFlyAircraft check)
  //   - "alle licenses dieses types" (admin-stats)
  //   - "alle licenses die bald ablaufen" (renewal-reminders)
  @@index([userId, status])
  @@index([type])
  @@index([expiresAt])
}

/// TypeRating — pilot-qualifikation für einen specific aircraft-type.
/// Anders als licenses (die generische klassen abdecken — SE, ME, IR), sind
/// type-ratings spezifisch für ein muster (A320, B738, B748). Pilot braucht
/// type-rating für jedes commercial-aircraft das er fliegt.
///
/// Lifecycle:
///   - Initial: nach completed type-rating-course + checkride. obtainedAt
///     ist datum, expiresAt = obtainedAt + 12 monate.
///   - Recurrent: alle 12 monate sim-check. Bei pass: expiresAt += 12 monate.
///     Bei fail: expiresAt steht auf altem datum, type-rating wird nach
///     ablauf invalid (canPilotFlyAircraft returnt false).
///   - Currency-tracking: hoursOnType + lastFlownAt für regulatory "90-day
///     recency rule". Wird beim PIREP-approval-flow updated wenn aircraft-
///     type matcht.
///
/// aircraftType: ICAO type-designator-string (A320, B738, B748, A35K).
/// Bewusst NICHT FK auf AircraftType-table weil pilot-type-ratings auch
/// für nicht-katalogisierte planes gelten können. Validation app-layer.
model TypeRating {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aircraftType String // ICAO code: A320, B738, B748, A35K
  obtainedAt   DateTime
  expiresAt    DateTime?
  hoursOnType  Float     @default(0)
  lastFlownAt  DateTime?

  // Audit-trail: wer hat das type-rating ausgestellt?
  issuedById String?
  issuedBy   User?   @relation("TypeRatingsIssued", fields: [issuedById], references: [id], onDelete: SetNull)

  notes String?

  /// Track 4 #91 (Section R): Wenn dieser type-rating durch ein
  /// TypeRatingExam erzeugt wurde, zeigt die back-relation darauf.
  /// Optional weil legacy type-ratings (vor #91) keine exam-history
  /// haben, und manuelle grants auch ohne exam möglich sind.
  fromExam TypeRatingExam?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pro user max ein type-rating pro aircraft-type.
  @@unique([userId, aircraftType])
  @@index([userId])
  @@index([aircraftType])
  @@index([expiresAt])
}

/// Track 4 #91 (Section R) — TypeRatingExam: scheduled type-rating
/// exams. Standalone-model (nicht via FlightSchoolEnrollment) weil
/// type-rating-shootouts oft direkt zwischen airline-examiner und pilot
/// ablaufen ohne formelle flight-school-enrollment dahinter. Existing
/// license-exam-pattern (FlightSchoolEnrollment.practicalExam*) bleibt
/// für SPL/PPL/CPL/ATPL-issuance, dieses model deckt nur type-ratings
/// auf einem aircraft-type ab.
///
/// Lifecycle:
///   SCHEDULED → PASSED          (examiner marks pass → creates TypeRating)
///   SCHEDULED → FAILED          (examiner marks fail → exam closed,
///                                pilot kann neuen scheduled exam haben)
///   SCHEDULED → CANCELLED       (admin/pilot cancels vor durchführung)
///   SCHEDULED → NO_SHOW         (pilot erschien nicht)
///
/// Multi-tenant: airlineId direkt am model damit multi-tenant-queries
/// in actions ohne join-traversal funktionieren. Constraint:
/// pilot + airline + aircraftType muss eindeutig sein PRO active-exam —
/// das verhindert dass admin versehentlich 2x scheduled exams für den
/// selben type anlegt. Bei nicht-active (PASSED/FAILED/CANCELLED/NO_SHOW)
/// gibt's keine constraint, weil mehrere historische exams ok sind.
/// (Wird via app-layer enforced, nicht schema-constraint, weil postgres
/// partial unique-index zwar geht aber prisma's @@unique nicht direkt
/// conditional ist.)
///
/// Bei PASSED: examineraktion erstellt einen TypeRating-record für den
/// pilot mit obtainedAt=completedAt, expiresAt=obtainedAt+12mo (standard
/// recurrent-cycle). Wird via app-layer in der mark-pass-action gemacht
/// damit wir auch die typeRating-FK hier zurücksetzen können (audit-trail
/// "this exam created this rating").
model TypeRatingExam {
  id           String                @id @default(cuid())
  /// Pilot der die prüfung ablegt.
  userId       String
  user         User                  @relation("TypeRatingExamPilot", fields: [userId], references: [id], onDelete: Cascade)
  /// Airline für multi-tenant scoping. Bewusst denormalized statt über
  /// user.airlineId zu joinen — vereinfacht queries und macht ownership
  /// explizit.
  airlineId    String
  airline      Airline               @relation(fields: [airlineId], references: [id])
  /// ICAO type-designator (A320, B738, B748). Validation app-layer
  /// (analog TypeRating.aircraftType).
  aircraftType String
  /// Termin des exams. Future = scheduled, past + status=SCHEDULED =
  /// overdue (admin sollte status updaten).
  scheduledFor DateTime
  /// Optionaler examiner (User mit TRE-license, in der gleichen airline).
  /// Nullable für den fall dass examiner erst später zugewiesen wird.
  examinerId   String?
  examiner     User?                 @relation("TypeRatingExamExaminer", fields: [examinerId], references: [id], onDelete: SetNull)
  status       TypeRatingExamStatus  @default(SCHEDULED)
  /// Notizen vom admin beim scheduling (z.B. "Lufthansa-A320-program,
  /// FFS-time gebucht für Tag X").
  notes        String?
  /// Notizen vom examiner nach durchführung (debrief, areas-to-improve).
  /// Nur relevant bei status != SCHEDULED.
  resultNotes  String?
  /// Wann wurde das exam abgeschlossen (pass/fail/cancelled/no-show).
  /// NULL solange status=SCHEDULED.
  completedAt  DateTime?
  /// Bei PASSED: der erzeugte TypeRating-record. NULL bei allen anderen
  /// status. Onetoone weil ein exam max ein type-rating produziert.
  typeRatingId String?               @unique
  typeRating   TypeRating?           @relation(fields: [typeRatingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Häufige queries:
  //   - "alle upcoming exams meiner airline" (admin-dashboard)
  //   - "alle exams dieses pilots" (pilot-profil)
  //   - "alle exams dieses examiners" (examiner-workload)
  @@index([airlineId, status, scheduledFor])
  @@index([userId])
  @@index([examinerId])
}

/// Track 4 #91 (Section R) — Lifecycle eines TypeRatingExam.
enum TypeRatingExamStatus {
  /// Termin angesetzt, prüfung ausstehend. Default beim create.
  SCHEDULED
  /// Pilot hat bestanden. typeRatingId zeigt auf den erzeugten TypeRating.
  PASSED
  /// Pilot hat nicht bestanden. Kein TypeRating ausgestellt. Pilot kann
  /// neuen exam scheduled bekommen.
  FAILED
  /// Termin wurde vor durchführung abgesagt (admin/pilot/examiner).
  CANCELLED
  /// Pilot ist nicht zum termin erschienen. Audit-trail-zweck.
  NO_SHOW
}

/// Track 4 #93 (Section R) — Mentorship: pairing zwischen senior pilots
/// (mentors) und junior pilots (mentees). Senior pilots mit erfahrung
/// (ATPL/CPL + viele stunden) geben informelle guidance an trainees ohne
/// formelles training-curriculum.
///
/// Architektur:
/// - Standalone-model, kein link zu FlightSchoolEnrollment (das ist
///   structured training; mentorship ist informell und freier)
/// - Status-lifecycle: PROPOSED → ACTIVE → ENDED, oder PROPOSED →
///   REJECTED. Admin kann assign'n (default ACTIVE) ODER mentee/mentor
///   kann selbst proposen (default PROPOSED → die andere seite akzeptiert)
/// - Multi-tenant: airlineId direkt am model (analog TypeRatingExam),
///   beide user müssen in der airline sein
/// - Constraint app-layer: pro mentee max 1 ACTIVE mentorship gleichzeitig.
///   Historische ENDED/REJECTED mentorships bleiben erhalten (audit-trail)
/// - Topics: Postgres-array von freiformulierten strings (z.B. "IFR-flying",
///   "Crew Resource Management") für quick-glance content-focus
///
/// Unterschied zu FlightSchoolEnrollment:
/// - Enrollment: structured curriculum mit theory-stunden, sim, practical-
///   exam, dauer-tracking. Endet mit license-issuance.
/// - Mentorship: informell, freier guidance. Kein curriculum, kein exam.
///   Endet wenn beide seiten zufrieden sind oder das interesse nachlässt.
model Mentorship {
  id        String           @id @default(cuid())
  airlineId String
  airline   Airline          @relation(fields: [airlineId], references: [id])
  /// Mentor — typically senior pilot mit erfahrung (ATPL/CPL + viele h)
  mentorId  String
  mentor    User             @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  /// Mentee — typically junior pilot der guidance sucht
  menteeId  String
  mentee    User             @relation("MentorshipMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  status    MentorshipStatus @default(PROPOSED)
  /// Topics als Postgres-array (z.B. ["IFR-flying", "Long-haul ops"]).
  /// Empty default — admin/pilot kann später nachpflegen.
  topics    String[]         @default([])
  /// Optional notes vom admin (warum dieses pairing) oder mentor/mentee
  /// (was sie sich erhoffen).
  notes     String?
  /// Wann wurde die mentorship gestartet (status=ACTIVE). NULL solange
  /// PROPOSED. Setzt sich beim accept oder direkt beim admin-assign.
  startedAt DateTime?
  /// Wann wurde die mentorship beendet (status=ENDED oder REJECTED).
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Häufige queries:
  //   - "alle active mentorships meiner airline" (admin-dashboard)
  //   - "meine mentees" (mentor-view) / "mein mentor" (mentee-view)
  //   - "history dieser mentee/mentor-combo"
  @@index([airlineId, status])
  @@index([mentorId, status])
  @@index([menteeId, status])
}

/// Track 4 #93 (Section R) — Lifecycle einer Mentorship.
enum MentorshipStatus {
  /// Initial: vorgeschlagen aber noch nicht von beiden seiten bestätigt.
  /// Admin-assign oder peer-request kommt hier rein.
  PROPOSED
  /// Aktive mentorship — beide seiten committed.
  ACTIVE
  /// Beendet (mentor/mentee/admin hat geschlossen). Bleibt für audit-trail.
  ENDED
  /// Vorschlag abgelehnt (vor ACTIVE). Audit-trail-zweck.
  REJECTED
}

/// FlightSchool — training-organisation an einem airport. NPC-betrieben im
/// MVP, später (post-13E) auch player-betreibbar. Bietet specific licenses
/// an, hat eigene fleet von training-aircraft (kommt 13E-11), und pricing.
///
/// Pricing-model (Decimal(10,2) = max 10^8 VAM$, mehr als realistisch):
///   - hourlyRateGround: theory-stunden im klassenraum, billiger.
///   - hourlyRateAir:    actual flight-hours mit instructor, teurer.
///   - hourlyRateSim:    simulator-stunden — typisch zwischen ground und
///                       air. Manche schools haben keinen sim → null setzen.
///
/// rating: community-driven 1-5 sterne. Default 4.0. Wird in 13E-12 vom
/// pilot-side enrollment-flow updated (nach completion fragt UI nach rating).
/// Im MVP ist das nur display, beeinflusst nicht enrollment-priorität.
///
/// offeredLicenses: array von license-types die diese schule anbietet.
/// Postgres-array (nicht relation-table) weil meist 3-5 typen pro schule
/// und composite-queries einfach sind.
///
/// Soft-delete via active=false. Beim deactivate werden existing in-progress
/// enrollments NICHT gecanceled — pilot kann sie weiterführen, aber neue
/// können nicht mehr starten.
model FlightSchool {
  id          String  @id @default(cuid())
  airportIcao String
  airport     Airport @relation(fields: [airportIcao], references: [icao])
  name        String
  rating      Float   @default(4.0)

  // Welche licenses bietet die schule an? Postgres-array von enum-strings.
  offeredLicenses LicenseType[]

  // Pricing in VAM$. Sim ist optional — manche schools haben keinen sim.
  hourlyRateGround Decimal  @db.Decimal(10, 2)
  hourlyRateAir    Decimal  @db.Decimal(10, 2)
  hourlyRateSim    Decimal? @db.Decimal(10, 2)

  // Optional description für /flight-schools/[id] page (markdown unterstützt).
  description String?

  // Optional logo/image-URL — analog zu Airline.logoUrl.
  logoUrl String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments FlightSchoolEnrollment[]

  // Häufige queries:
  //   - "alle schools an airport X" (pilot browse-view)
  //   - "alle aktiven schools sortiert by rating" (default ranking)
  @@index([airportIcao])
  @@index([active, rating])
}

/// FlightSchoolEnrollment — pilot ist in einem training-program an einer
/// flight-school. Tracked hours-progress, exam-attempts, costs.
///
/// Lifecycle (siehe EnrollmentStatus enum-docstring):
///   IN_PROGRESS → EXAM_SCHEDULED → PASSED   (happy path)
///                              ↓
///                             FAILED  (3+ attempts oder pilot-give-up)
///   IN_PROGRESS → WITHDRAWN                (pilot canceled)
///
/// Hours-tracking: Float weil flight-hours decimal sein können (1.5h, 2.25h).
/// Welle 13E-12 server-action updates die werte beim "buy hours"-flow.
///
/// Exam-tracking:
///   - theoryExamPassedAt + theoryExamScore: wenn theory-test bestanden.
///     Score 0-100 (% korrekt), pass-mark 80%. Multiple attempts erlaubt.
///   - practicalExamPirepId: welcher PIREP war die prüfungs-flug. STRING
///     statt FK weil PIREPs cascade-delete wenn user gelöscht — wir wollen
///     enrollment-record erhalten.
///
/// Cost-tracking:
///   - totalCostPaid: kumulativ alle ausgaben (hours, exam-fees, retry-fees).
///     Wird vom wallet-payment-flow (13E-12) inkrementiert. Bei WITHDRAWN
///     ggf. partial refund (app-policy, default 50% wenn vor exam, 0% nach).
///
/// Resulting license:
///   - resultingLicenseId: FK zur PilotLicense die nach PASSED ausgestellt
///     wurde. NULL solange enrollment noch nicht PASSED. Keine relation-
///     definition hier — wir machen das via separate query in der app-layer
///     (findById über resultingLicenseId), weil User schon zwei relations
///     zu PilotLicense hat (UserLicenses, LicensesIssued) und prisma keine
///     ambigous unnamed relations erlaubt.
model FlightSchoolEnrollment {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId    String
  school      FlightSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  licenseType LicenseType

  enrolledAt DateTime @default(now())

  // Hours-tracking
  hoursTheory    Float @default(0)
  hoursPractical Float @default(0)
  hoursSim       Float @default(0)

  status EnrollmentStatus @default(IN_PROGRESS)

  // Theory-exam tracking
  theoryExamPassedAt DateTime?
  theoryExamScore    Float? // 0-100 (%)
  theoryExamAttempts Int       @default(0)

  // Practical-exam tracking
  practicalExamScheduledAt DateTime?
  practicalExamPirepId     String? // STRING (kein FK) — siehe docstring
  practicalExamPassedAt    DateTime?
  practicalExamAttempts    Int       @default(0)

  // Cost-tracking. Decimal(12,2) erlaubt bis 10^10 VAM$ — way genug.
  totalCostPaid Decimal @default(0) @db.Decimal(12, 2)

  // Resulting license (1:1 via @unique). Keine relation-definition — siehe
  // docstring oben. App-layer macht findUnique(id=resultingLicenseId).
  resultingLicenseId String? @unique

  // Wenn enrollment WITHDRAWN: wann + grund.
  withdrawnAt     DateTime?
  withdrawnReason String?

  // Welle 13E-13: Theory-exam attempts (1:n). Ein enrollment kann
  // mehrere attempts haben (retry nach FAILED). Cascade-delete bei
  // enrollment-delete (was selbst per User-cascade getriggered wird).
  theoryAttempts TheoryExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Häufige queries:
  //   - "alle aktiven enrollments dieses users" (pilot dashboard)
  //   - "alle enrollments dieser schule" (admin overview)
  //   - "alle enrollments im EXAM_SCHEDULED-state" (admin pre-exam-prep)
  @@index([userId, status])
  @@index([schoolId, status])
  @@index([status])
}

/// Welle 13E-13: Theorie-prüfung quiz-mechanic.
///
/// TheoryExamCategory — kategorisiert die fragen damit wir bei der
/// random-selection eine balanced verteilung erreichen können (z.B. 5
/// regulations, 5 weather, 5 aerodynamics, 5 systems statt 20× regulations).
///
/// Kategorien orientieren sich an EASA Part-FCL theorie-syllabus:
///   - REGULATIONS:    Air Law, ICAO/EASA, deutsche LuftVO, ATC-procedures
///   - WEATHER:        Meteorology, METAR/TAF, weather-fronts, icing
///   - AERODYNAMICS:   Lift/drag, stall, aircraft-performance, weight&balance
///   - SYSTEMS:        Aircraft-systems, instruments, engines, propellers
///   - NAVIGATION:     VFR/IFR-nav, VOR/NDB/GPS, flight-planning, charts
///   - HUMAN_FACTORS:  Crew Resource Management, physiology, decision-making
///
/// Für PPL/SPL nutzen wir typischerweise REGULATIONS+WEATHER+AERODYNAMICS+
/// SYSTEMS. Für IR/CPL/ATPL kommt NAVIGATION dazu, für ATPL/MCC noch
/// HUMAN_FACTORS. Die selection-policy filtert per licenseType.
enum TheoryExamCategory {
  REGULATIONS
  WEATHER
  AERODYNAMICS
  SYSTEMS
  NAVIGATION
  HUMAN_FACTORS
}

/// TheoryExamQuestion — Multiple-choice frage in der theorie-bank.
///
/// Format: 4 antwort-optionen, exact 1 richtig (correctIndex 0-3). Wir
/// nutzen Strings statt JSON für options weil postgres String[] type-safe
/// ist und keine application-layer-validation braucht.
///
/// Selection-strategy in startTheoryExam:
///   1. Filter: licenseType == enrollment.licenseType, active=true
///   2. Group by category, random-pick balanced count pro category
///   3. Shuffle final list
///
/// Wenn nicht genug fragen pro category vorhanden sind: fall back to
/// "best effort" — wir nehmen alle verfügbaren plus topup von der
/// gesamten bank. Helper wirft NIE wenn die bank zu klein ist; UI
/// zeigt im worst-case einen warning.
///
/// Difficulty (1-5): future-use für adaptive-quiz (noch nicht implementiert
/// in 13E-13). Default 2 = "moderate".
///
/// Idempotency-policy: keine — questions sind admin-created via seed
/// oder später admin-UI. Identische question-texts in der bank sind
/// erlaubt (kann z.B. dieselbe frage mit anderer license-zuordnung sein).
model TheoryExamQuestion {
  id           String             @id @default(cuid())
  licenseType  LicenseType
  category     TheoryExamCategory
  questionText String
  /// 4 antwort-optionen. Exact 4 expected — sonst app-layer-validation-error
  /// in seed/admin. Bewusst String[] statt fixed columns (option1..option4)
  /// um zukünftige varianten (z.B. 5 options, true/false) leichter zu
  /// supporten via app-layer-policy.
  options      String[]
  /// 0-indexed pointer auf options[]. Validation: 0 <= correctIndex <
  /// options.length, durchgesetzt im seed-script + admin-UI.
  correctIndex Int
  /// Wird nach answer-submit angezeigt um lerneffekt zu fördern. Optional
  /// weil seed-questions evtl. ohne erklärung kommen.
  explanation  String?
  /// Reserved für adaptive-difficulty in späterer welle. 1=easy, 5=hard.
  difficulty   Int                @default(2)
  /// Soft-delete: active=false → frage erscheint nicht mehr in selection.
  /// Existing attempts behalten ihre questionIds-references.
  active       Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Häufige query: "alle aktiven fragen für PPL".
  @@index([licenseType, active])
  @@index([licenseType, category, active])
}

/// TheoryExamAttempt — Ein einzelner prüfungs-versuch eines pilots.
///
/// Lifecycle:
///   1. startTheoryExam → INSERT mit questionIds[], submittedAt=null
///   2. UI: pilot beantwortet fragen, optional zwischenspeichern via
///      saveAnswer (incremental update of answers[])
///   3. submitTheoryExam → score berechnet, passed gesetzt, submittedAt
///      gestempelt. Wenn passed=true: enrollment.theoryExamPassedAt+Score
///      gesetzt + status → EXAM_SCHEDULED (= ready für practical).
///
/// Time-limit: nicht erzwungen in 13E-13 (kein server-side timer). Wenn
/// später gewünscht, würden wir startedAt + max-duration prüfen.
///
/// answers[i] korrespondiert zu questionIds[i] same-index. Wert -1 =
/// "skipped/unanswered" (graded als wrong). Werte 0-3 = gewählte option.
/// Length-mismatch zwischen arrays = data-integrity-bug, wird in submit
/// als app-layer-error abgefangen.
///
/// Score: 0-100 (% korrekt). Pass-mark in app-layer (PASS_MARK_PERCENT
/// constant, default 80). Aufnahme-precision: Float weil score = round(
/// correct/total*100, 1) — nicht ganzzahlig wenn z.B. 17/20 = 85.0%.
///
/// Retry-policy: pilot kann beliebig oft retry'en. Jeder neue versuch =
/// neuer attempt-record. enrollment.theoryExamAttempts inkrementiert
/// pro submit (egal ob passed oder failed). Kein cooldown im MVP.
model TheoryExamAttempt {
  id           String                 @id @default(cuid())
  enrollmentId String
  enrollment   FlightSchoolEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  /// Question-ids in der reihenfolge wie sie dem pilot angezeigt werden.
  /// Wird beim start gesetzt + danach immutable (answers-position-stable).
  questionIds String[]

  /// Pro question-position: gewählter option-index (0-3) oder -1 (skip).
  /// Bei start: empty []. Wird via saveAnswer inkrementell gefüllt.
  /// Bei submit: muss length == questionIds.length haben.
  answers Int[] @default([])

  /// 0-100 (%). NULL solange noch nicht submitted.
  scorePercent Float?

  /// True wenn scorePercent >= PASS_MARK_PERCENT. NULL solange nicht submitted.
  passed Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Häufige queries:
  //   - "alle attempts dieses enrollments" (history-anzeige)
  //   - "running attempt dieses enrollments" (resume nach reload)
  @@index([enrollmentId, submittedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Track 1 #7 (Events / Flight-Tours, 9.2.8) — Event-System v1
// ─────────────────────────────────────────────────────────────────────────

/// Welle/Track-1 #7: Was für ein event-typ. Beeinflusst nur display
/// (icon, badge-color, kategorie-filter) — keine business-logic-divergenz.
/// Mehr kinds können später additiv hinzugefügt werden ohne migration-
/// breakage (postgres-enum ALTER ... ADD VALUE).
enum EventKind {
  /// Multi-leg tour mit fester reihenfolge (z.B. \"DLH-Tour Europa\":
  /// FRA→CDG→MAD→FCO→FRA). Legs sind im legs-JSON-array.
  TOUR

  /// Single-flight event mit fester route (z.B. \"Eröffnung der LH482-Strecke\").
  /// legs-array hat genau zwei einträge oder ist leer (route ist im
  /// description-text frei beschrieben).
  SINGLE_FLIGHT

  /// Themen-event ohne starre route (z.B. \"Cargo-Wochenende\" — fliege
  /// einen beliebigen cargo-flug während des zeitfensters).
  THEMED

  /// Group-flight: mehrere piloten fliegen gemeinsam dieselbe strecke.
  /// V1: nur als kategorie-display. V2 könnte gemeinsame slots/timings
  /// erzwingen.
  GROUP_FLIGHT

  /// Saisonal (christmas, summer-break, anniversary etc.). Hauptsächlich
  /// für UI-filter-tab \"Saison-Events\".
  SEASONAL
}

/// Welle/Track-1 #7: Lifecycle eines events. State-machine:
///   DRAFT → PUBLISHED → IN_PROGRESS → COMPLETED
///                ↓
///            CANCELLED  (jederzeit möglich vor COMPLETED)
///
/// IN_PROGRESS und COMPLETED werden nicht durch admin-action getriggert
/// sondern via timestamp-vergleich in queries (startsAt <= now < endsAt
/// → IN_PROGRESS, now >= endsAt → COMPLETED). Das vermeidet eine cron-
/// dependency und macht status \"live computed\" — der DB-status bleibt
/// PUBLISHED bis ein admin manuell auf COMPLETED setzt (z.B. um
/// nachzügler-completion-flags noch zu vergeben).
enum EventStatus {
  /// Admin-WIP. Nicht öffentlich sichtbar. Nur creator + airline-admins
  /// können den event sehen.
  DRAFT

  /// Public im event-catalog. Anmeldungen offen. Discord-embed gepostet.
  PUBLISHED

  /// Admin hat manuell als abgeschlossen markiert (oder zukünftig auch
  /// ein cron-job nach endsAt). Catalog zeigt event noch im \"Vergangene
  /// Events\"-tab.
  COMPLETED

  /// Admin hat abgesagt. Event verschwindet aus public-catalog,
  /// teilnehmer-records bleiben als audit-trail.
  CANCELLED
}

/// Track 1 #7 — Event-Model.
///
/// Repräsentiert eine event-veranstaltung der airline (tour, themed-flight,
/// group-flight etc.). Pilots melden sich via EventParticipant an. Admins
/// erstellen + verwalten events via /admin/events.
///
/// # Scope
///
/// airlineId ist NULLABLE — null bedeutet \"VA-wide event\" (sichtbar für
/// alle airlines auf der instanz). MVP-policy: VA-wide-events können nur
/// von SYSTEM-admins erstellt werden (gate via permission-check in
/// actions). Single-airline-instanz nutzt das eh nicht — alle events sind
/// effektiv airline-scoped.
///
/// # Slug
///
/// Slug ist UNIQUE GLOBAL (nicht per airline) — vereinfacht URL-routing
/// (/events/[slug] ohne airline-prefix). Konflikt-handling bei create:
/// app-layer hängt -2, -3 etc. an wenn slug schon existiert. Slug ist
/// 1x beim publish festgelegt + danach immutable damit links stabil
/// bleiben.
///
/// # bonusReward
///
/// Optionaler zusätzlicher VAM\$-bonus für teilnehmer die das event
/// completen. Kommt ON TOP von normalen flight-revenues (PIREP-payouts).
/// Default 0 = kein bonus, event ist nur \"engagement-meta\". Wird beim
/// markParticipantCompleted-call als REVENUE_EVENT_BONUS-transaction
/// gutgeschrieben (siehe future-work — MVP schreibt einen generic
/// REVENUE_PASSENGER mit category \"event-bonus\" weil wir keinen neuen
/// enum-value für MVP wollen — kann später extrahiert werden).
///
/// # legs-Json
///
/// Frei-formatiges array für tour-events: [{ icao, label, note? }, ...].
/// V1 nur display, kein constraint dass piloten genau diese strecken
/// fliegen müssen. V2 könnte automatic-completion-tracking via
/// PIREP-matching machen (\"PIREP from EDDF→LFPG ✓\").
model Event {
  id          String      @id @default(cuid())
  airlineId   String?
  airline     Airline?    @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  title       String
  slug        String      @unique
  description String      @db.Text
  kind        EventKind   @default(THEMED)
  status      EventStatus @default(DRAFT)

  /// Banner/cover image für event-card + detail-page-header. Optional
  /// (null = neutraler kind-icon-placeholder im UI).
  coverImageUrl String?

  /// Optional bonus-VAM\$ für completers ON TOP von flight-revenues.
  /// Default 0. Decimal(12, 2) konsistent mit anderen money-fields.
  bonusReward Decimal     @default(0) @db.Decimal(12, 2)

  /// Hard-cap auf teilnehmerzahl. Null = unlimited. Wenn cap erreicht,
  /// joinEvent wirft \"event-full\". UI zeigt \"15/25 Teilnehmer\" badge.
  maxParticipants Int?

  /// Event-zeitfenster. startsAt = MUSS, endsAt = optional (für single-
  /// day-events oder open-ended themed-events). UI rendert basierend
  /// auf startsAt vs now: future = \"Beginnt in 3 Tagen\", inside-window =
  /// \"Läuft\", past = \"Beendet\".
  startsAt DateTime
  endsAt   DateTime?

  /// Tour-legs als JSON-array: [{ icao, label?, note? }]. Nur für
  /// kind=TOUR strukturiert genutzt — bei anderen kinds null oder leer.
  /// V1: rein display, keine PIREP-matching-logic.
  legs Json?

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  participants EventParticipant[]
  /// Track 4 #99 (Section S): Comment-thread des events. Cascade-delete.
  comments     EventComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Häufigste queries:
  ///  - \"published events meiner airline, sortiert nach startsAt\" (catalog-listing)
  ///  - \"events meiner airline aller statuses\" (admin-listing)
  ///  - \"event by slug\" (detail-routing — slug ist eh @unique, kein extra index nötig)
  @@index([airlineId, status, startsAt])
  @@index([startsAt])
}

/// Track 1 #7 — EventParticipant.
///
/// Anmeldungs-record. Ein pilot kann sich für ein event ein-mal anmelden
/// (@@unique([eventId, userId])). Beim leave-action wird der record
/// hard-gelöscht (kein soft-delete) — verzichtbar weil keine zeitliche
/// historie der signups gebraucht wird.
///
/// completed-flag wird vom admin via markParticipantCompleted gesetzt
/// (typischerweise nach event-ende manuell). V2 könnte das per PIREP-
/// matching automatisieren (\"hat dieser pilot die tour-legs alle
/// geflogen?\").
model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("EventParticipations", fields: [userId], references: [id], onDelete: Cascade)

  joinedAt    DateTime  @default(now())
  completed   Boolean   @default(false)
  completedAt DateTime?

  /// Audit-trail wer den completed-flag gesetzt hat (admin-id). Null bei
  /// auto-completion (V2). SetNull beim admin-delete damit historische
  /// records ihre kette nicht verlieren.
  completedById String?
  completedBy   User?   @relation("EventParticipantsCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, completed])
}

// ─────────────────────────────────────────────────────────────────────────
// Track 4 #99 (Section S) — Event-Comments
// ─────────────────────────────────────────────────────────────────────────

/// Track 4 #99 (Section S) — EventComment.
///
/// Diskussions-thread auf event-detail-pages. Pilots können fragen
/// stellen ("welche flugzeug-config wollen wir?"), briefings posten
/// (admin), oder post-event-feedback geben.
///
/// # Scope
///
/// Comments gehören zu einem event (cascade-delete via event). Wenn
/// event gelöscht wird: comments verschwinden mit. Saubere semantik —
/// comments ohne event sind sinnlos.
///
/// # Author
///
/// userId pflicht, kein anonym-mode. SetNull beim user-delete würde
/// "user gelöscht" sub-display erfordern; statt dessen cascade-delete
/// damit der comment mit dem account verschwindet. Kompromiss: wenn
/// historische diskussionen wichtig wären müssten wir den user soft-
/// deleten (out-of-scope für V1).
///
/// # Moderation
///
/// V1 hat keine moderation-flow. Admin kann jeden comment löschen
/// (deleteCommentAction prüft admin-role ODER author-ownership).
/// Pilots können nur eigene comments löschen. V2 könnte report-button
/// + admin-queue haben.
///
/// # Threading
///
/// V1 flat — keine reply-to-comment. Pilots erwähnen sich via @name
/// im body (free-text, kein parsing). Threading wäre eigene welle.
model EventComment {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("EventCommentsAuthored", fields: [userId], references: [id], onDelete: Cascade)

  /// Free-text comment body. Max 2000 chars im app-layer-validation.
  body String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Häufigste queries:
  ///   - "alle comments zu event X, chronologisch" (event-detail-page)
  ///   - "alle comments von user Y" (profile, future)
  @@index([eventId, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Track 4 #101 (Section T) — Admin-Audit-Log
// ─────────────────────────────────────────────────────────────────────────

/// Track 4 #101 (Section T) — AdminAuditLog.
///
/// Append-only audit trail von admin-actions. Jede sicherheitsrelevante
/// oder daten-modifizierende admin-action schreibt einen entry: who, when,
/// what, target.
///
/// # Scope
///
/// Bewusst NICHT alle CRUD-actions — nur die mit privilegier-impact
/// (role-zuweisungen, account-suspensions, event-publish, award-grant,
/// destructive-deletes). Granularer schemata sind eigene welle.
///
/// # Append-only
///
/// Keine update/delete-API. Records werden ausschließlich INSERTed
/// (via logAdminAction()-helper). Sogar bei testdaten-cleanup
/// bleibt history als forensic-trail erhalten — wenn cleanup-needed,
/// expliziter DB-truncate.
///
/// # Target-shape
///
/// targetType + targetId als opaque-strings (z.B. "User"/"cmxyz...",
/// "Event"/"cm123..."). Kein FK weil viele relations möglich sind und
/// FK-cascades den audit-trail zerstören würden (z.B. user-delete würde
/// audit-rows wegputzen — das wollen wir GERADE NICHT).
///
/// # metadata Json
///
/// Optional JSON-payload mit action-specific kontext (z.B. für
/// "user.role.changed": { from: "pilot", to: "admin" }). Free-shape,
/// app-layer-defined per action-type.
model AdminAuditLog {
  id           String   @id @default(cuid())

  /// Wer hat die action getriggert. Pflicht — wir loggen nur authentifizierte
  /// admin-actions. SetNull beim user-delete damit audit-rows die action-
  /// history nicht verlieren.
  actorId      String?
  actor        User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// Welle F / F1 — Airline-Scoping für audit-log. NULL für system-weite
  /// actions die NICHT zu einer airline gehören (z.B. global role-CRUD,
  /// flight-school CRUD). Set wenn die action eine bestimmte airline
  /// betrifft — dann ist die zeile sichtbar für airline-admins im
  /// scoped /airline/admin/audit-log view.
  ///
  /// Trennung der zwei views:
  ///   - /admin/audit (system-admin only): alle rows, kein scoping
  ///   - /airline/admin/audit-log (airline-admin): airlineId = own
  ///
  /// SetNull beim airline-delete: bei airline-shutdown bleiben die
  /// rows als globale history erhalten (forensic-trail). Die airline-
  /// admin-page filtert dann diese rows weg (airlineId IS NULL), aber
  /// system-admins sehen sie weiterhin.
  airlineId    String?
  airline      Airline? @relation("AdminAuditAirline", fields: [airlineId], references: [id], onDelete: SetNull)

  /// Action-type als string (kein enum — schnellere iteration ohne
  /// migration bei neuen action-types). Konvention: dot-separated
  /// "noun.verb" z.B. "user.role.changed", "event.published",
  /// "award.granted", "pirep.approved".
  action       String

  /// Optional target-info. "User"/"Event"/"Award"/"Pirep" etc. + ID.
  /// Kein FK (siehe model-comment).
  targetType   String?
  targetId     String?

  /// Optional action-specific kontext als JSON.
  metadata     Json?

  /// Optional request-meta für forensics: IP, user-agent. Beide nullable
  /// weil sie nicht überall zuverlässig verfügbar sind (z.B. server-side
  /// in next.js braucht request-header-zugriff).
  ipAddress    String?
  userAgent    String?  @db.Text

  createdAt    DateTime @default(now())

  /// Häufige queries:
  ///   - alle actions chronologisch (admin-dashboard /admin/audit)
  ///   - alle actions eines bestimmten actors
  ///   - alle actions auf einem target (z.B. wer hat user X moderiert?)
  ///   - alle actions einer airline (Welle F / F1 — airline-scoped view)
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([airlineId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Track 4 #103 (Section T) — Client-Error-Log
// ─────────────────────────────────────────────────────────────────────────

/// Track 4 #103 (Section T) — ClientErrorLog.
///
/// Errors die im browser auftreten (React render-errors, unhandled
/// promise-rejections, global window.onerror) werden via POST /api/errors
/// an den server geschickt und hier persistiert. Admin-page unter
/// /admin/errors zeigt die liste mit filter + drill-down.
///
/// # Persistence statt in-memory
///
/// Im gegensatz zum slow-query-monitor (#102) der in-memory läuft, ist
/// das hier DB-persistent. Client-errors treten unregelmäßig auf und
/// sollten investigations überleben (process-restarts, deployments).
/// Datenmenge ist klein — ein durchschnittlicher webapp-deployment sieht
/// vielleicht 0-50 client-errors pro tag.
///
/// # Retention
///
/// Im V1 kein auto-prune. Wenn die tabelle in 6 monaten 50k rows hat,
/// können wir einen daily-cron job adden der entries > 30d alt löscht.
/// Out-of-scope für jetzt.
///
/// # Rate-limiting
///
/// API-endpoint (POST /api/errors) hat einen simple per-IP-rate-limit
/// (10/min) damit ein crashloop-bug nicht die DB flutet. Limit-trigger
/// returnen 429 und werden NICHT persistiert.
///
/// # PII
///
/// URL und stack-trace könnten sensitive paths enthalten (z.B.
/// /pireps/[id]/edit?token=...). Admin-only access via requireAdmin.
/// Kein automatisches scrubbing — wer logs einsieht akzeptiert dass
/// URL-pfade und error-messages drinstehen.
model ClientErrorLog {
  id           String   @id @default(cuid())

  /// Wer hat den error verursacht. Optional weil unauth-user-pages
  /// auch errors triggern können. SetNull bei user-delete (forensik
  /// soll erhalten bleiben, nur user-link löst sich auf).
  userId       String?
  user         User?    @relation("ClientErrorUser", fields: [userId], references: [id], onDelete: SetNull)

  /// Wo trat der error auf. Volle URL inkl. query-string. Pfad-prefix
  /// (z.B. "/pireps/[id]") via app-side normalisierung optional —
  /// hier roh gespeichert.
  url          String   @db.Text

  /// Error.message — typischerweise einzeilig. Bei rendered-react-errors
  /// "Cannot read property 'x' of undefined", bei unhandled rejections
  /// die promise-reject-reason.
  message      String   @db.Text

  /// Volle stack-trace falls vorhanden. Browser-stacks sind oft minified
  /// in prod — source-map-resolution ist out-of-scope-V1.
  stack        String?  @db.Text

  /// Browser-user-agent für reproducibility (chrome/firefox version,
  /// mobile/desktop).
  userAgent    String?  @db.Text

  /// Wann hat der CLIENT den error gesehen (browser-clock).
  occurredAt   DateTime

  /// Wann hat der SERVER ihn ingestiert (server-clock). Diff > 1min
  /// deutet auf offline-buffering oder gestauten client.
  createdAt    DateTime @default(now())

  /// Free-shape kontext: error.name, react-componentStack,
  /// query-params, custom meta vom error-boundary.
  context      Json?

  /// Häufige queries:
  ///   - chronologisch alle errors (admin /admin/errors)
  ///   - alle errors eines user (debug-account)
  ///   - alle errors auf einer URL (page X bricht häufig). Postgres btree
  ///     hat 8KB-key-limit, app-side URLs sind weit drunter — kein
  ///     prefix-length nötig wie bei MySQL.
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([url, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Track 4 #98 (Section S) — Event-Templates
// ─────────────────────────────────────────────────────────────────────────

/// Track 4 #98 (Section S) — EventTemplate.
///
/// Wiederverwendbare event-vorlage. Admin definiert einmal das "muster"
/// (z.B. "Friday Night Group-Flight" mit standard-description, bonus,
/// max-participants, kind) und kann dann mit einem klick neue events
/// daraus spawnen — startsAt/endsAt werden per-instance gesetzt, alle
/// anderen felder vom template kopiert.
///
/// # Scope
///
/// Template gehört zu einer airline. Cascade-delete via airline:
/// airline-löschung räumt templates mit auf (sind nicht wertvoller
/// als die airline selbst).
///
/// # Verhältnis zu Event
///
/// Template ist NICHT ein FK-parent von Event — events sind unabhängig
/// sobald gespawnt. Wenn admin das template später editiert, ändert
/// das KEINE bestehenden events. Das ist die "snapshot-at-spawn"-
/// semantik analog zu BookingTemplate (Track 4 #67).
///
/// # useCount
///
/// Optional analytics-counter, bei jedem successful spawnEventFromTemplate
/// incremented. Hilft dem admin zu sehen welche templates oft genutzt
/// werden vs. dead-weight. Resettable via update-action.
///
/// # legs als JSON
///
/// Identisches format wie Event.legs: [{ icao, label?, note? }]. Bei
/// kind=TOUR sinnvoll, bei anderen kinds optional/null. Beim spawn
/// wird das JSON 1:1 in das neue Event übernommen.
model EventTemplate {
  id          String    @id @default(cuid())
  airlineId   String
  airline     Airline   @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  /// Template-name (admin-facing label, z.B. "Friday Night Group-Flight").
  /// NICHT der event-titel — der wird beim spawn gesetzt (kann vom
  /// template-titel inheritet werden oder admin tippt was anderes).
  name        String

  /// Default-event-titel der beim spawn pre-filled wird. Admin kann
  /// per-instance abändern.
  title       String
  description String    @db.Text
  kind        EventKind @default(THEMED)

  /// Default bonus-VAM\$ (kann beim spawn überschrieben werden).
  /// Decimal(12, 2) konsistent mit Event.bonusReward.
  bonusReward Decimal   @default(0) @db.Decimal(12, 2)

  /// Default max-participants. Null = unlimited.
  maxParticipants Int?

  /// Tour-legs als JSON-array (gleiche shape wie Event.legs).
  legs Json?

  /// Analytics: anzahl der ge-spawned-events aus diesem template.
  useCount Int @default(0)

  createdById String
  createdBy   User   @relation("EventTemplateCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Häufige queries:
  //   - "alle templates meiner airline" (admin-list)
  //   - "template by id" (spawn-action)
  @@index([airlineId])
}

// ─────────────────────────────────────────────────────────────────────────
// Track 3 #11.2.5 v1-Full Item 8/10 — Notification-Center (vision §9.3.10)
// ─────────────────────────────────────────────────────────────────────────

/// AdminNotification — admin-authored in-app message für piloten.
///
/// # Recipient-modi (drei varianten)
///
/// 1. **Per-user**: recipientId set → genau ein pilot bekommt die nachricht.
///    Use-cases: warnings, personal-feedback, rejected-PIREP-clarification.
///
/// 2. **Broadcast (global)**: recipientId NULL → alle user sehen die
///    nachricht. Use-cases: maintenance-windows, neue-feature-announcements,
///    plattform-weite events. v1 hat KEINEN per-airline-broadcast — wenn
///    admin einer airline-spezifisch broadcasten will, muss er es per-user
///    tun oder global. Per-airline-broadcast = v2-ticket weil das einen
///    zusätzlichen audience-resolver braucht.
///
/// # Read-tracking
///
/// readAt: NULL = ungelesen, set = gelesen + zeitstempel. Pilot-side UI
/// (separates ticket) markiert beim öffnen des notification-drawers alle
/// als gelesen.
///
/// Bei BROADCAST-notifications (recipientId=null) ist readAt nicht
/// per-user — der admin sieht's globally als "gesendet" und der pilot-
/// drawer zeigt sie immer als info. v2 könnte per-user-read-state via
/// separate join-tabelle einführen wenn das wichtig wird (z.B. badge-
/// count "5 ungelesen broadcasts").
///
/// # Kind-feld
///
/// Frei-formatiges string-feld (nicht enum) damit neue notification-typen
/// ohne migration funktionieren. Canonical-werte (UI rendert mit color/
/// icon):
///   - "info" (default, blau-grau)
///   - "warning" (gelb, achtung)
///   - "success" (grün, geschafft!)
///   - "event" (lila, neuer event publiziert)
/// Unbekannte werte fallen auf "info"-style zurück.
///
/// # Pilot-side rendering
///
/// V1: nur das ADMIN-widget zum SENDEN existiert. Pilot-side rendering
/// (badge im sidebar-header + drawer) ist separates ticket. Schema und
/// server-action sind hier soweit dass das pilot-widget einfach
/// `prisma.adminNotification.findMany({ where: { OR: [{ recipientId: userId },
/// { recipientId: null }] } })` machen kann.
model AdminNotification {
  id          String  @id @default(cuid())
  authorId    String
  author      User    @relation("AdminNotificationAuthor", fields: [authorId], references: [id])
  recipientId String?
  recipient   User?   @relation("AdminNotificationRecipient", fields: [recipientId], references: [id])

  title String
  body  String @db.Text
  kind  String @default("info")

  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Häufigste queries:
  //   - Pilot-side drawer: "alle notifications für mich + alle broadcasts"
  //     → OR-where auf recipientId=userId + recipientId=null. Index auf
  //     recipientId+readAt deckt den per-user-teil schnell ab.
  //   - Admin-widget recent-sent feed: "alle notifications die ich kürzlich
  //     gesendet habe" → orderBy createdAt desc, where authorId=adminId.
  //     Index auf authorId+createdAt unterstützt das.
  //   - Generic "neueste notifications" für broadcasts → createdAt-only-index.
  @@index([recipientId, readAt])
  @@index([authorId, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Track 4 #60 (Section L) — PIREP Kudos
// ─────────────────────────────────────────────────────────────────────────

/// PirepKudos — leichtgewichtiges 👏-anerkennungs-feature für PIREPs.
///
/// Pilot A liest PIREP von Pilot B (z.B. besonders glatte landung, lange
/// strecke, schwieriges wetter) und klickt einen kudos-button. Wir
/// speichern ein record und zeigen den count + own-state am button.
///
/// # Constraints
///
/// - `@@unique([pirepId, userId])` verhindert doppel-kudos vom gleichen user
///   (toggle-pattern: zweiter klick = unkudo via delete statt zweiter insert).
/// - Cascade-delete via beiden FKs: wenn PIREP gelöscht wird, gehen kudos
///   mit. Wenn user gelöscht wird, gehen seine vergebenen kudos mit.
///
/// # Was wir NICHT machen
///
/// - Kein self-kudo-verbot im schema — das wird in der server-action enforced
///   (cheaper than DB-CHECK-constraint und gibt bessere error-message).
/// - Kein \"kudos-type\" oder \"reaction-emoji\" — bewusst minimal. Wenn später
///   mehr nuance gewünscht ist (👏/✈️/🔥), wird das additiv via neuem field.
/// - Keine notification an den PIREP-owner — vorerst silent. UI-toast wäre
///   ein follow-up (eigenes ticket).
model PirepKudos {
  id        String   @id @default(cuid())
  pirepId   String
  pirep     Pirep    @relation(fields: [pirepId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([pirepId, userId])
  // Häufigste queries:
  //   - "hat user X diesem PIREP einen kudo gegeben?" → unique-index reicht
  //   - "wieviele kudos hat dieser PIREP?" → covered by unique-prefix index
  //   - "alle kudos die user X vergeben hat" (profile/activity-feed)
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Track 5 #3 — PIREP-Annotations
// ─────────────────────────────────────────────────────────────────────────

/// PirepAnnotation — instructor/admin-feedback an konkreten frames im
/// replay-trail eines PIREPs.
///
/// Use-case: Ein instructor schaut einen PIREP an, navigiert zum landing-
/// frame im replay, und schreibt einen comment "hier zu hohe sinkrate,
/// flare zu spät begonnen". Der pilot sieht den comment in der PIREP-
/// detail-page und kann im replay direkt zu dem frame springen.
///
/// # Wer darf was
///
/// - **Write**: nur approver-roles (admin/airline-admin/instructor) in der
///   gleichen airline wie der PIREP. Pilot selber kann KEINE annotations
///   schreiben — sonst würde der feedback-loop verwässert ("ich kommentiere
///   meinen eigenen flug" macht in einer instructor-feedback-feature
///   keinen sinn).
///
/// - **Edit/Delete**: nur der author OR admin der airline. Andere
///   instructors können nicht den feedback eines kollegen verändern.
///
/// - **Read**: alle die den PIREP sehen können (eigen + approver same-
///   airline).
///
/// # Schema-design
///
/// `frameIndex` (Int): position im LiveSessionPosition-array. NICHT eine
/// FK zu LiveSessionPosition.id weil:
///   1. Position-rows haben kein stabiles "frame-index"-feld am DB-level —
///      es ist nur die order-by-recordedAt-position im fetch-result.
///   2. Bei manchen sessions können positions nachträglich resampled werden
///      (z.B. wenn ACARS-rate sich ändert), und eine FK würde dangling.
/// Stattdessen speichern wir den frame-index als plain int. Bei display
/// resolved der client den frame zur entsprechenden position.
///
/// `body` (String): annotation-text. App-layer-enforced max 1000 chars
/// (kein DB-constraint weil Prisma keine string-length-constraints am
/// schema-level kennt — über server-action validiert).
///
/// Soft-delete vs hard-delete: hard-delete. Annotations sind feedback-
/// notes, kein audit-record. Wenn der instructor sich vertan hat und
/// löscht, soll's weg sein. Audit-log (Track 4 #101) erfasst die
/// löschung separat.
///
/// # Indices
///
/// - `(pirepId, frameIndex)`: häufigste query — "alle annotations für
///   diesen PIREP, sortiert nach timeline-position". Direkt covered.
/// - `(authorId, createdAt)`: "alle annotations die instructor X
///   geschrieben hat" für profile/instructor-activity-feed (nicht V1
///   aber forward-compat).
model PirepAnnotation {
  id         String   @id @default(cuid())
  pirepId    String
  pirep      Pirep    @relation(fields: [pirepId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("PirepAnnotationAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  frameIndex Int
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pirepId, frameIndex])
  @@index([authorId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Track 4 #67 (Section M) — Booking-Templates
// ─────────────────────────────────────────────────────────────────────────

/// BookingTemplate — pilot-persönliche vorlage für häufig gebuchte
/// flug-konfigurationen.
///
/// Use-case: Pilot bucht regelmäßig denselben flug (z.B. tägliche
/// MUC-FRA-shuttle auf VATSIM). Statt jedesmal route + network + legCount
/// neu auszuwählen, kann er einmal eine vorlage speichern und beim nächsten
/// /bookings/new mit einem klick neu instanzieren.
///
/// # Scope
///
/// User-scoped (nicht airline-shared). Jeder pilot hat seine eigenen
/// templates. Schema-feld airlineId ist trotzdem da damit wir queries
/// einfach scopen können (cross-airline-show-up wäre möglich aber bewusst
/// vermieden weil semantik unklar wäre).
///
/// Cascade-delete via beiden FKs:
///   - Pilot-löschung räumt seine templates auf
///   - Airline-löschung räumt alle templates der airline auf
///   - Route-löschung räumt templates die diese route nutzen auf (sonst
///     hätten wir dangling-templates die nicht mehr funktionieren)
///
/// # Felder
///
/// `label` (1..50 chars, app-layer-enforced): kurze human-readable name,
/// z.B. \"Daily MUC-FRA Morning\" oder \"Cargo-Run nach LFPG\". Wird in
/// dropdown + management-UI angezeigt.
///
/// `intendedNetwork`: optional, mirrors Booking.intendedNetwork. Wenn
/// gesetzt, wird beim instanziieren übernommen. NULL = pilot wählt
/// network bei jeder instanz neu.
///
/// `legCount`: mirrors Booking.legCount. Default 1 = single-flight.
/// 2..10 für multi-leg-tours.
///
/// # Was wir NICHT speichern
///
/// - scheduledDeparture: wäre sinnlos (vorlagen sind zeit-relativ, nicht
///   zeit-absolut). Pilot setzt das beim instanziieren neu.
/// - preferredAircraft: aircraft kommt eh aus der route. Wenn pilot
///   spezifisches airframe will, kann er das auf der booking-detail-page
///   ändern (kommt mit späterem option). Für jetzt: route-default.
///
/// # Pro-pilot limit
///
/// App-layer-enforced max 20 templates pro pilot (verhindert spam, hält
/// dropdown übersichtlich). Wenn jemand das hard-limit erreicht, kann
/// er alte unbenutzte templates löschen.
model BookingTemplate {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  airlineId       String
  airline         Airline      @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  label           String
  routeId         String
  route           Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  intendedNetwork NetworkType?
  legCount        Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Häufigste queries:
  //   - \"alle templates dieses pilots, neueste zuerst\" (dropdown)
  //   - \"alle templates dieser airline\" (admin/debug, ggf. später)
  @@index([userId, createdAt])
  @@index([airlineId])
}

/// Track 5 #10 (Section B): Flight Streaks & Goals.
///
/// Pilot kann sich selbst ziele setzen (z.B. "5 Flüge pro Woche" oder
/// "20 Stunden pro Monat") und das system trackt streak-counts für
/// aufeinanderfolgende perioden in denen das ziel erfüllt war.
///
/// # Streak-Mechanik
///
/// Nach jeder PIREP-approval läuft evaluatePilotGoals(userId):
///   1. Check pro goal: wieviele PIREPs/stunden hat der pilot in der
///      AKTUELLEN periode (z.B. diese kalender-woche oder dieser monat)?
///   2. Wenn target erreicht und periode != lastEvaluatedPeriod:
///      currentStreak += 1, bestStreak = max(bestStreak, currentStreak)
///   3. Wenn eine periode komplett versäumt wurde (z.B. user war 2
///      wochen weg und kommt zurück): currentStreak = 0
///
/// Period-boundaries:
///   - Weekly: ISO week (Mo-So), UTC-basiert
///   - Monthly: kalender-monat 1.-letzter, UTC
///
/// V1 ist UTC-only. V2 könnte user.timezone berücksichtigen damit
/// pilots in Asien nicht 8h früher als Europäer in eine neue periode
/// rutschen.
///
/// # Kind enum
///
/// Verschiedene ziel-arten ähnlich zum criteria-DSL von #7, aber
/// period-scoped statt lifetime-cumulative:
///   - WeeklyFlights / MonthlyFlights: count von approved PIREPs
///   - WeeklyHours / MonthlyHours: sum(flightTimeMin) / 60
///
/// V1 ist diese 4 kinds. Erweiterbar: WeeklyDistance, MonthlyDistance,
/// etc. — additive zukünftig ohne migration weil enum-add ist additive.
///
/// # Unique constraint
///
/// Ein user darf pro kind nur EIN goal haben. Verhindert dass ein pilot
/// zwei "5 Flüge/Woche"-goals anlegt die beide getrackt würden. Wenn er
/// den target ändern will: edit das existing goal (server-action).
model PilotGoal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   PilotGoalKind
  target Int

  /// Aktueller streak-counter. Wird inkrementiert wenn die aktuelle
  /// periode das target erreicht hat UND die periode neu ist seit dem
  /// letzten increment. Reset auf 0 wenn eine periode komplett versäumt
  /// wurde (kein PIREP submitted in der periode, target nicht erreicht).
  currentStreak Int @default(0)

  /// Höchster streak den dieser pilot je auf diesem goal hatte.
  /// Monoton steigend — nie heruntergesetzt. Für "deine beste serie war
  /// 8 wochen am stück"-anzeige.
  bestStreak Int @default(0)

  /// Identifier der periode in der zuletzt evaluiert wurde, in form
  /// "2026-W19" (weekly) oder "2026-05" (monthly). Wird beim erfolg-
  /// reichen increment auf die current-period gesetzt. Verhindert
  /// double-increment innerhalb derselben periode (z.B. wenn der pilot
  /// 7 PIREPs in einer woche fliegt bei target=5 → streak += 1 EINMAL,
  /// nicht 3x).
  lastIncrementedPeriod String?

  /// Letzter evaluator-lauf (zum debug/audit). Wird bei jedem
  /// evaluatePilotGoals-call refreshed, unabhängig von success/streak-
  /// change.
  lastEvaluatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ein user kann pro kind nur ein goal setzen.
  @@unique([userId, kind])

  // "Alle goals von user X" ist der einzige relevante query-pfad.
  @@index([userId])
}

enum PilotGoalKind {
  WeeklyFlights
  WeeklyHours
  MonthlyFlights
  MonthlyHours
}

/// Track 5 #13 (Section C): Follow-System.
///
/// Asymmetric follows (twitter-style). Ein user kann beliebige andere
/// user folgen, kein consent vom followee nötig. Privacy-gate: nur
/// users mit isProfilePublic=true können gefolgt werden (enforced
/// server-action-side, nicht im schema — additive migration would
/// erfordern null-checks bei JEDEM follow, was teurer ist als ein
/// `findUnique({where: {id, isProfilePublic: true}})` im action).
///
/// # Edges
///
///   - followerId = der user der folgt (outgoing)
///   - followeeId = der user dem gefolgt wird (incoming)
///
/// Beide via cascade-delete auf User → wenn ein user gelöscht wird,
/// verschwinden alle seine in-/outgoing follow-edges.
///
/// # Self-follow
///
/// @@unique([followerId, followeeId]) verhindert nicht self-follow
/// (technisch wäre (X, X) ja unique). Self-follow-block ist in der
/// server-action (followUser throw'n bei follower===followee). Wenn
/// jemand den check umgeht und einen self-follow erstellt, ist das
/// harmlos — es leakt nichts, es passt nur nicht in das mentale model
/// und würde die follower-count um 1 zu hoch zeigen.
///
/// # Mutual follow detection
///
/// Zwei separate edges: User A → B + User B → A. Mutual-follow ist
/// dann eine boolean (existiert beide). Nicht im schema modelliert,
/// computed im helper.
///
/// # Indizes
///
///   - @@unique([followerId, followeeId]) — fast idempotent-follow + lookup
///     "folgt A dem B?"
///   - @@index([followeeId, createdAt(desc)]) — "wer folgt user X, neueste
///     zuerst" für die /p/[id]/followers liste
///   - @@index([followerId, createdAt(desc)]) — "wem folgt user X, neueste
///     zuerst" für die /p/[id]/following liste
model Follow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User     @relation("FollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followeeId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
}

/// Welle K / K2 — Pilot-Blog post status.
///
/// Draft: privater entwurf, nur für den autor sichtbar.
/// Published: öffentlich auf /blog + /blog/[slug] sichtbar.
enum BlogPostStatus {
  Draft
  Published
}

/// Welle K / K2 — Pilot-Blog. Long-form-content den pilots posten
/// können (flight stories, tipps, route-reviews).
///
/// # Visibility-modell
///
/// Status Draft → nur autor kann sehen/editieren.
/// Status Published → public auf /blog + /blog/[slug].
/// Kein per-airline-scope V1 — single global blog für alle pilots
/// der platform. V2 könnte airline-scoped blogs als feature für
/// premium-airlines sein.
///
/// # Slug
///
/// Auto-generiert aus title via slugify mit collision-suffix.
/// Unique-constraint enforced. Slug ist immutable nach erstem
/// publish (sonst SEO-broken).
///
/// # Body-format
///
/// V1: plaintext mit line-break-preservation (whitespace-pre-wrap
/// im UI). Keine markdown-rendering — keeps deps minimal + reduziert
/// XSS-surface. V2 könnte sanitized markdown via micromark sein.
///
/// # View-counter
///
/// Increment on /blog/[slug] page-load. V1: simple Int+1 via update;
/// race-conditions tolerieren wir (zwei concurrent reads → counter
/// landet bei +1 statt +2, kein semantisches problem).
model BlogPost {
  id          String          @id @default(cuid())
  slug        String          @unique @db.VarChar(220)
  title       String          @db.VarChar(200)
  excerpt     String?         @db.VarChar(500)
  body        String          @db.Text
  status      BlogPostStatus  @default(Draft)

  authorId    String
  author      User            @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  publishedAt DateTime?

  viewCount   Int             @default(0)

  // Feed-query: alle published posts neueste-zuerst
  @@index([status, publishedAt(sort: Desc)])
  // Author-dashboard: alle posts eines users, neueste-zuerst, by status
  @@index([authorId, status, createdAt(sort: Desc)])
}

/// Track 5 #14 (Section C): PIREP Discussion Comments.
///
/// Free-form discussion threads unter einem PIREP. Jeder authentifizierte
/// pilot kann kommentieren — kein approval-context, kein frame-binding,
/// pure conversation.
///
/// # Difference to other PIREP-interaction-tabs
///
///   - PirepKudos: boolean reaction (👍). Eine pro user/pirep.
///   - PirepAnnotation: frame-bound feedback von APPROVERS (instructor/
///     airline-admin/admin) im replay-trail.
///   - PirepComment: general-purpose discussion. Jeder logged-in user
///     kann posten, body ist plaintext, nicht an einen frame gebunden.
///
/// # Body constraints (enforced server-action-side)
///
///   - Max 2000 chars
///   - Plaintext (sanitization wie User.bio: trim + strip control-chars
///     + collapse blank lines)
///   - Kein markdown-rendering V1 (sicherheit + scope)
///
/// # Edit-window
///
///   - Author kann eigene comments für 15 min editieren/löschen
///   - Danach locked (V2: admin-override für moderation)
///   - editedAt-feld trackt "(bearbeitet)"-marker im UI
///
/// # Cascade-delete
///
///   - PirepComment.pirep CASCADE — wenn PIREP gelöscht, comments weg
///   - PirepComment.author CASCADE — wenn author gelöscht, comments weg
///     (KEIN anonymize-to-null, selber pattern wie PirepAnnotation —
///     orphan-comments sind semantisch nutzlos)
///
/// # Indizes
///
///   - @@index([pirepId, createdAt]) — primary query "alle comments
///     dieses PIREPs, älteste zuerst" (chrono-order für thread-reading)
///   - @@index([authorId, createdAt]) — "alle comments dieses users",
///     z.b. für moderation/admin V2 oder profile-recent-activity
model PirepComment {
  id        String    @id @default(cuid())
  pirepId   String
  pirep     Pirep     @relation(fields: [pirepId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("PirepCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String    @db.Text
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([pirepId, createdAt])
  @@index([authorId, createdAt])
}

/// Track 5 #15 (Section C): PIREP Photo Posts.
///
/// URL-based photo attachments an PIREPs. V1 ist intentionally simple:
/// kein file-upload, kein S3/R2, kein image-validation. Author pastet
/// einen direct-image-URL (typischerweise von imgur, discord-cdn,
/// pasteboard, dropbox-direct-link) und das System rendert das als
/// <img> tag in der gallery-section.
///
/// # Why URL-based statt file-upload?
///
/// File-upload würde S3/R2-bucket-setup, signed-uploads, image-
/// validation (magic-bytes), thumbnail-generation, CDN-edge-caching,
/// virus-scan etc. erfordern → mehrere stunden engineering. URL-based
/// nimmt 20 LOC und liefert 80% des wertes. Der trade-off:
///   - User muss image woanders hosten (acceptable für aviation-fans
///     die eh diskord/imgur nutzen)
///   - Falls der external host die URL killt, image kaputt
///   - Kein content-moderation auf bild-level
///
/// V2 könnte beide modi unterstützen (URL ODER upload via R2). Aber
/// der schema-trick: das URL-feld ist agnostisch. V2 würde ein neues
/// optional uploadedFile-feld dazu nehmen, OHNE die bestehenden URL-
/// records zu brechen.
///
/// # Constraints (server-side enforced)
///
///   - URL: max 1000 chars, MUST start with https://
///   - Caption: max 500 chars (optional), plaintext sanitized
///   - Max 12 photos pro PIREP (V1 hard-cap, V2 könnte erhöht werden)
///
/// # Permissions
///
///   - Post: jeder logged-in user der den PIREP sehen kann
///   - Delete: owner kann eigene löschen jederzeit, airline-admin/admin
///     können alle in eigener airline löschen (moderation)
///
/// # Cascade-delete
///
///   - PirepPhoto.pirep CASCADE — PIREP weg → photos weg
///   - PirepPhoto.author CASCADE — author weg → seine photos weg
///
/// # Indizes
///
///   - @@index([pirepId, createdAt]) — primary gallery-query, älteste
///     zuerst (chrono-order)
model PirepPhoto {
  id        String   @id @default(cuid())
  pirepId   String
  pirep     Pirep    @relation(fields: [pirepId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("PirepPhotoAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now())

  // Welle K / K3 — Photo-of-the-week curation.
  // Admin sets featuredAt=now() when picking a "photo of the week";
  // featuredById tracks WHO featured it (audit trail). NULL = not
  // currently featured. Multiple photos can have featuredAt set at
  // different times — UI sorts featuredAt desc and shows the most
  // recent on /photo-of-the-week + a history-grid of older features.
  featuredAt    DateTime?
  featuredById  String?
  featuredBy    User?    @relation("PirepPhotoFeaturedBy", fields: [featuredById], references: [id], onDelete: SetNull)

  @@index([pirepId, createdAt])
  @@index([authorId, createdAt])
  // Welle K / K3 — index für /photo-of-the-week feed (sort by featuredAt desc,
  // only rows where featuredAt is not null are practically interesting but
  // postgres handles that fine without a partial index for our volume).
  @@index([featuredAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────
// Welle E / E4 — Multi-pilot cockpit-rooms
// ─────────────────────────────────────────────────────────────────────
//
// A CockpitRoom is a session-bound coordination surface where two or
// more pilots fly the same flight together (captain + first officer,
// long-haul reliefs, training scenarios). v1 is server-side only:
// schema + REST endpoints. Client integration (the ACARS tray's
// heartbeat-piggyback channel for shared state) is a separate phase
// — this commit lays the data foundation.
//
// # Design choices
//
// Room is owned by ONE pilot (ownerId), typically the captain who
// "opened the cockpit". Other pilots join as members with a role.
// One pilot can only be a member of one OPEN room at a time — server
// enforces this via the conditional unique index on
// CockpitMember(pilotId, status='ACTIVE').
//
// flightId is optional + nullable on purpose. v1 supports two modes:
//
//   1. Anchored to a specific Booking (`flightId = Booking.id`) — the
//      room is "for this scheduled flight; only pilots booked on it
//      should join". Future server-side checks can enforce this.
//   2. Free-form ad-hoc room (`flightId = null`) — training sessions,
//      casual co-flying, or rooms opened before a booking exists.
//
// We deliberately do NOT FK to LiveSession.id here, because the room
// often exists before any LiveSession is created (captain opens the
// room at pre-flight, FO joins, both then click Verbinden separately
// and each gets their own LiveSession). Tying the room to a single
// LiveSession would force one of the two to be "primary" which
// muddles the relationship.
//
// # Status lifecycle
//
// OPEN — accepting joins, room is the rendezvous-point for the flight.
// CLOSED — owner closed the room or auto-closed after last member left.
//          Historical record kept for audit/replay; new joins rejected.
//
// We don't add IN_PROGRESS or LANDED states — those live on the
// individual LiveSessions / Bookings. The room is purely a
// coordination object; the actual flight-state stays on existing models.
//
// # Cascade behavior
//
// Room.owner → User: Cascade. If the owning pilot is deleted (account
// deletion), the room goes with them. Members lose access cleanly.
//
// CockpitMember.room → Room: Cascade. Room deleted → memberships gone.
// CockpitMember.pilot → User: Cascade. Pilot deleted → memberships gone.
//
// # Indexes
//
// Room: (ownerId, status) — list "rooms I own" filtered by open/closed.
//       (flightId) — find the room for a booking (sparse index, many
//                    rooms have null flightId).
//       (status, createdAt desc) — list open rooms (admin/discovery UI).
//
// Member: (roomId) — member list for a room.
//         (pilotId, status) — find a pilot's active membership in O(1)
//                             for the join-validation check.
//
// We don't index updatedAt — no query orders by it.

enum CockpitRoomStatus {
  OPEN
  CLOSED
}

/// CockpitRole is intentionally narrow for v1. Most multi-crew sims
/// recognize these three positions; broader fleet-specific roles
/// (engineer, navigator) can be added later as enum members without
/// migration pain (Prisma allows enum additions in-place).
///
/// CAPTAIN is the owner's default role. There can be multiple CAPTAINs
/// in a room (rare — training scenarios where the instructor and
/// trainee both fly left-seat in sequence) so we don't enforce
/// "exactly one captain". The owner is identified by Room.ownerId,
/// not by role.
enum CockpitRole {
  CAPTAIN
  FIRST_OFFICER
  RELIEF
  OBSERVER
}

/// CockpitMember.status separates "currently in the room" from
/// "historically was in the room". A pilot can leave a room and
/// re-join (leftAt set, then a new ACTIVE row created with a fresh
/// joinedAt) — we keep the LEFT row as a breadcrumb rather than
/// deleting it, useful for the room's history view.
enum CockpitMemberStatus {
  ACTIVE
  LEFT
}

model CockpitRoom {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("CockpitRoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Optional FK to the Booking this room coordinates. Nullable for
  /// ad-hoc rooms (training, casual co-flying). When set, future
  /// server-side checks can require members to be on the booking's
  /// pilot list — out of scope for v1, but the FK is here so the
  /// constraint is cheap to add later.
  flightId String?
  flight   Booking? @relation("CockpitRoomBooking", fields: [flightId], references: [id], onDelete: SetNull)

  /// Display name shown in pilot-facing UIs. Optional — defaults to
  /// "Cockpit: {ownerName}" client-side when null. Capped at 80 chars
  /// (varchar) so the field stays index-friendly and renders cleanly
  /// in narrow mobile cards.
  title String? @db.VarChar(80)

  status      CockpitRoomStatus @default(OPEN)
  members     CockpitMember[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  /// Set when status transitions to CLOSED. NULL while OPEN. Useful
  /// for "show closed rooms from the last 24h" admin queries without
  /// scanning updatedAt (which churns on every member join/leave).
  closedAt DateTime?

  @@index([ownerId, status])
  @@index([flightId])
  @@index([status, createdAt(sort: Desc)])
}

model CockpitMember {
  id     String      @id @default(cuid())
  roomId String
  room   CockpitRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  pilotId String
  pilot   User   @relation("CockpitMemberPilot", fields: [pilotId], references: [id], onDelete: Cascade)

  role     CockpitRole         @default(FIRST_OFFICER)
  status   CockpitMemberStatus @default(ACTIVE)
  joinedAt DateTime            @default(now())
  /// Set when status transitions to LEFT. NULL while ACTIVE. Same
  /// pattern as CockpitRoom.closedAt — historical timestamp without
  /// re-using updatedAt (which we don't expose for members anyway).
  leftAt DateTime?

  @@index([roomId])
  @@index([pilotId, status])
}

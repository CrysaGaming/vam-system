generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FlightState {
  Planned
  Departed
  Airborne
  Landed
  Cancelled
}

enum NetworkType {
  VATSIM
  IVAO
  Offline
}

enum PirepStatus {
  Submitted
  Approved
  Rejected
}

enum DataSource {
  VATSIM_API
  IVAO_API
  ACARS_CLIENT
  MANUAL
  REPLAY
}

enum BookingState {
  Created
  SimBriefDispatched
  Completed
  Cancelled
  Expired
}

// Welle 4: Flight-Type-Klassifizierung. Default SCHEDULED für alle existing
// PIREPs/Bookings (additive migration). FREE = pilot fliegt frei ohne
// route-restriction (free-flight tab). POSITIONING = ferry/repositioning
// flug zwischen hubs (typisch leer, no revenue). TRAINING = sim-checkride,
// type-rating-flight, exam (kommt mit Welle 13 career-system). CHARTER =
// einmal-flug außerhalb scheduled-network (kommt mit Welle 7 schedule-gen).
enum FlightType {
  SCHEDULED
  CHARTER
  POSITIONING
  TRAINING
  FREE
}

// Welle 4: Quelle des Position-Updates für User.currentLocationIcao.
// Tracking: woher wissen wir wo der pilot grade ist? MANUAL = airline-admin
// hat manuell gesetzt (z.B. seed). PIREP = letzter approved-PIREP arrival.
// ACARS = ACARS-client heartbeat (kommt Welle 9). VATSIM/IVAO = network-
// session position-snap (live-tracking aus bot). JUMPSEAT = pilot ist via
// jumpseat-transfer umgezogen (no-flight, audit-trail in JumpseatTransfer).
// Source-precedence wird in der app-logik definiert (ACARS > VATSIM/IVAO
// live > PIREP > JUMPSEAT > MANUAL als fallback).
enum LocationSource {
  MANUAL
  PIREP
  ACARS
  VATSIM
  IVAO
  JUMPSEAT
}

// Welle 4: Grund für Jumpseat-Transfer. Audit-trail damit airline-admin
// nachvollziehen kann warum ein pilot umgezogen ist ohne-flug. RETURN_TO_HUB
// = häufigster fall (pilot ist nach flug irgendwo gestrandet, will zurück
// zum hub). HUB_TO_HUB = multi-hub-airline, pilot wechselt zwischen FRA/MUC.
// POSITIONING = admin-driven, flotten-positionierung (z.B. neuer pilot wird
// an seinen base-airport verschoben). ADMIN_TRANSFER = generic admin-action
// (z.B. correction nach falscher PIREP-arrival).
enum JumpseatReason {
  RETURN_TO_HUB
  HUB_TO_HUB
  POSITIONING
  ADMIN_TRANSFER
}

// Welle 5: Aircraft-Lifecycle-States. Replaces (und ergänzt) das einfache
// Aircraft.active boolean. Mit dem booking-flow + maintenance-management
// brauchen wir mehr granularität als nur on/off:
//
// - ACTIVE: voll verfügbar, buchbar, fliegt
// - MAINTENANCE: aktuell in der werkstatt — nicht buchbar, aber inventory-
//   sichtbar. Roleplay-flag, ist nicht (yet) mit cost/time-system verknüpft.
//   Manueller status, airline-admin setzt + un-setzt.
// - STORED: long-term parking (z.B. winter-storage, fleet-rotation pause).
//   Nicht buchbar, aber leichter zu reaktivieren als RETIRED. Andere
//   semantik für UI-filter ("show stored aircraft" vs "show retired").
// - RETIRED: dauerhaft außer dienst. Nicht buchbar, aber historische
//   PIREPs/routes referenzieren das aircraft weiter (FK-integrity). Zeigt
//   in der liste mit "retired"-badge + opacity. Reaktivierung via admin-
//   action möglich, aber typisch ein "soft-delete-with-history" replacement
//   für hard-delete.
//
// Migration-strategie: das alte Aircraft.active boolean bleibt ZUNÄCHST
// erhalten (additive), wird beim app-layer mit `status==ACTIVE` synchron
// gehalten. Welle 5 phase 2 deprecated `active`, dann ist status der
// single-source-of-truth.
enum AircraftStatus {
  ACTIVE
  MAINTENANCE
  STORED
  RETIRED
}

// Welle 6B (commit 6B-2): Employment-Status für piloten. Ergänzt rankId/roleId
// um eine orthogonale dimension: ist dieser pilot operativ aktiv? Kann airline
// ihn für scheduled-flights einplanen?
//
// - ACTIVE: normal, fliegt regulär. Default für alle existing user (additive
//   migration), für alle neuen user via @default(ACTIVE).
// - LEAVE: vorübergehend nicht verfügbar. Urlaub, sabbatical, prüfungs-
//   vorbereitung, krankschreibung. Pilot bleibt member der airline, behält
//   rank, aber wird in personnel-reports/leaderboards nicht als "aktiver
//   roster" mitgezählt. Roleplay-flag, kein hard-gate auf bookings (pilot
//   kann immer noch fliegen wenn er will — die status-info ist nur für
//   roster-planung).
// - INACTIVE: long-term nicht aktiv. Discord-acc verloren, hat lange nicht
//   geflogen, will pause aber nicht ganz raus. Auch kein hard-gate aber
//   stärkerer signal an admins für cleanup-decisions ("entferne nach 90d
//   inactive?").
//
// Bewusst nur 3 states (nicht TERMINATED/SUSPENDED/etc.) — termination
// wird durch removeMemberFromAirline gehandhabt (User.airlineId=null), nicht
// als status. Suspended/disciplinary ist out-of-scope für VA-context.
//
// Migration-strategie: additive, alle existing users bekommen ACTIVE als
// default. Kein backfill-script nötig (default greift auf existing rows).
enum EmploymentStatus {
  ACTIVE
  LEAVE
  INACTIVE
}

// State-machine für AirportRequest und AircraftTypeRequest. Mirrors PIREP-
// pattern (Submitted → Approved/Rejected) mit Erweiterung UnderReview.
// Approval ist binär hier, aber via `approvedAsVerified` Boolean auf den
// Request-models in zwei Tiers: verified (system-admin hat daten geprüft)
// vs unverified (provisional, mit warning-badge im UI).
enum RequestStatus {
  Submitted
  UnderReview
  Approved
  Rejected
}

// Welle 7: State einer konkreten ScheduledFlight-instanz. Orthogonal zur
// FlightState (Pirep-runtime) und PirepStatus (approval-workflow):
//
// - Planned: generator hat slot erstellt, noch unbooked. Sichtbar in pilot-
//   booking-UI als "available scheduled flight". Häufigster initial-state.
// - Booked: ein pilot hat den slot via createBookingFromScheduledFlight
//   gepickt. ScheduledFlight.bookingId ist set, Booking.state ist Created
//   (oder weiter im booking-lifecycle). Slot ist nicht mehr verfügbar für
//   andere piloten.
// - Completed: PIREP wurde gefiled UND approved. Terminal-state — slot ist
//   "history". Wird aus pilot-UI rausgefiltert, bleibt in admin-grid für
//   reporting/leaderboards sichtbar.
// - Cancelled: admin oder pilot hat den slot abgesagt. Terminal aber nicht-
//   completed. Wenn pilot canceled → Booking.state=Cancelled triggert
//   ScheduledFlight back zu... hmm, eigentlich Cancelled (slot ist tot —
//   admin kann manuell neuen für gleichen zeit-slot generieren wenn ge-
//   wünscht). Bewusst NICHT zurück zu Planned, weil das booking-cancellation
//   eines piloten nicht impliziert dass der slot wieder offen sein soll —
//   der admin entscheidet das per re-generation.
//
// Bewusst KEIN "InProgress"/"Departed"/"Airborne" — das ist die domäne von
// FlightState am Pirep, nicht des schedule-records. Hier interessiert nur:
// ist dieser slot offen, hat ihn jemand, ist er fertig, oder ist er tot?
enum ScheduledFlightStatus {
  Planned
  Booked
  Completed
  Cancelled
}

model Airline {
  id       String  @id @default(cuid())
  icao     String  @unique
  iata     String? @unique
  name     String
  callsign String?
  logoUrl  String?

  // Welle 8: Branding-fields für public airline-pages (/a/[icao]).
  // Alle nullable — airline ist auch ohne branding-content nutzbar.
  // Hex-color-format (#RRGGBB) wird app-layer-validated, nicht im schema.
  tagline        String?
  description    String?
  websiteUrl     String?
  primaryColor   String?
  secondaryColor String?
  // Opt-out: airline ist per default public sichtbar unter /a/[icao] und
  // im /airlines directory. Admin kann auf false setzen für staging-airlines
  // oder private-roleplay-groups (UI sichtbar nur für eingeloggte members).
  publicVisible  Boolean @default(true)

  // SimBrief Override-Hierarchie Ebene 1 (lowest precedence). Per-airline
  // defaults für SimBrief-Dispatch (cont_fuel_pct, units, OFP-Layout, etc).
  // Schema: apps/web/lib/simbrief/overlay.ts SimBriefOverlaySchema. Wird
  // beim Dispatch durch Fleet/Aircraft/Route-overlays übersteuert (höhere
  // Specificity gewinnt).
  simBriefOverlay Json?

  // Welle 4: Economy-Foundation-Flag. False-default — wenn eine Airline
  // economy/cargo/passenger-revenue features aktiviert (kommt Welle 12+),
  // wird das hier auf true gesetzt. Steuert UI-Sichtbarkeit von Cargo-/
  // Passenger-Booking-Tabs, Revenue-Reports, etc. Per-airline opt-in
  // damit reine roleplay-airlines kein "money game" UI sehen.
  economyEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  ranks            Rank[]
  aircraft         Aircraft[]
  fleets           Fleet[]
  routes           Route[]
  pireps           Pirep[]
  sceneries        Scenery[]
  featureFlags     FeatureFlag[]
  roleMappings     DiscordRoleMapping[]
  bookings         Booking[]
  flightPlanCaches FlightPlanCache[]
  invites          Invite[]

  // Welle 4: Multi-Hub-System. Eine Airline kann 1..N hubs haben (FRA+MUC
  // style). Genau ein hub hat isPrimary=true (CHECK-constraint via partial
  // unique-index in app-logik enforced). Pilot.baseIcao kann jeden hub-icao
  // referenzieren, default = primary-hub. Hubs sind die orte an denen
  // jumpseat-transfers günstig/free sind und scheduling beginnt.
  hubs AirlineHub[]

  // Welle 7: Schedule-System. Templates definieren wiederkehrende muster
  // (Mo+Mi+Fr 14:30 UTC), scheduledFlights sind die generierten konkreten
  // instanzen. Cascade-on-delete via the relation definition (Airline-
  // löschung räumt schedule-data mit auf).
  scheduleTemplates ScheduleTemplate[]
  scheduledFlights  ScheduledFlight[]

  // System-Catalog Request-Flow — eine Airline kann mehrere Requests
  // einreichen. Optional FK auf Request damit auch user-ohne-airline
  // (z.B. solo-pilot vor airline-zuweisung) requests stellen können.
  airportRequests      AirportRequest[]      @relation("AirportRequestAirline")
  aircraftTypeRequests AircraftTypeRequest[] @relation("AircraftTypeRequestAirline")
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  name      String?
  discordId String? @unique

  vatsimCid            Int?      @unique
  vatsimVerifiedAt     DateTime?
  vatsimAccessToken    String?   @db.Text
  vatsimRefreshToken   String?   @db.Text
  vatsimTokenExpiresAt DateTime?

  ivaoVid            Int?      @unique
  ivaoVerifiedAt     DateTime?
  ivaoAccessToken    String?   @db.Text
  ivaoRefreshToken   String?   @db.Text
  ivaoTokenExpiresAt DateTime?

  // SimBrief-Account-Identifier für API-Dispatch. Wenn null, dispatcht User
  // via Browser-Fallback (prefilled URL).
  simBriefUsername String?

  overlayToken String? @unique

  overlayLayout       String @default("bar") // "bar" | "card"
  overlayCardPosition String @default("top-right")
  overlayPhaseColors  Json? // optional override

  // Welle 10 commit 10D: Custom-Branding für streamer-overlay. Alle drei
  // optional — wenn null/missing, fallback auf default cyan/green theme.
  // Validation passiert app-layer:
  //   - overlayLogoUrl: muss valide https-URL sein, max 500 chars,
  //     darf nur auf bilder verweisen (image/png|jpeg|webp|svg). Server-
  //     action checkt content-type bevor sie speichert.
  //   - overlayPrimaryColor / overlayAccentColor: hex-strings #RGB oder
  //     #RRGGBB, regex-validated.
  // Logo wird vom client direkt geladen (browser-side fetch), kein
  // proxying durch unsere domain — keep public-overlay frei von
  // image-bandwidth-overhead. CSP des overlay-pages erlaubt img-src *
  // damit beliebige logo-hosts funktionieren (imgur, github, eigene
  // CDNs etc.).
  overlayLogoUrl       String?
  overlayPrimaryColor  String?
  overlayAccentColor   String?

  image            String?
  totalFlightHours Float    @default(0)
  totalFlights     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  airlineId       String?
  airline         Airline?  @relation(fields: [airlineId], references: [id])
  // Wann der user der airline beigetreten ist. Wird vom auth.ts
  // createUser-event auf NOW() gesetzt sobald airlineId zugewiesen
  // wird. Bei späterem invite-accept-flow analog. NULL für user die
  // (noch) keiner airline angehören oder vor 2026-05-02 erstellt
  // wurden — die migration backfilled NICHT, weil createdAt für
  // bestehende users der echte beitritts-zeitpunkt war (auto-join
  // bei registrierung).
  joinedAirlineAt DateTime?
  rankId          String?
  rank            Rank?     @relation(fields: [rankId], references: [id])
  roleId          String?
  role            Role?     @relation(fields: [roleId], references: [id])

  liveSessions   LiveSession[]
  pireps         Pirep[]
  approvedPireps Pirep[]       @relation("PirepApprover")
  awards         UserAward[]
  featureFlags   FeatureFlag[]
  accounts       Account[]
  sessions       Session[]
  emailVerified  DateTime?
  bookings       Booking[]

  invitesCreated Invite[] @relation("InviteCreator")
  invitesUsed    Invite[] @relation("InviteUser")

  // Welle 4: Pilot-Position-Tracking & Hub-Assignment.
  //
  // baseIcao = hub des piloten innerhalb der airline (FRA, MUC). Default
  // beim airline-join = airline.primaryHub.icao. Pilot kann später wechseln
  // (admin-action). String-only (kein FK), spiegelt Aircraft.homeIcao-pattern.
  // Validation in app-layer: muss matching airline.hubs entry haben.
  //
  // currentLocationIcao = wo der pilot grade ist. Updated nach PIREP-approval
  // auf arrival.icao, oder nach jumpseat-transfer auf target. NULL = nie
  // geflogen (neuer pilot — UI zeigt "ready at base" als fallback).
  //
  // currentLocationSource = audit-trail woher der position-update kam
  // (siehe LocationSource enum-docstring). Default MANUAL für seed-data.
  //
  // currentLocationAt = wann letzter update. Mit Source kombinierbar für
  // staleness-detection (z.B. "VATSIM-position älter als 24h → fall back
  // to last PIREP arrival").
  baseIcao              String?
  currentLocationIcao   String?
  currentLocationSource LocationSource @default(MANUAL)
  currentLocationAt     DateTime?

  // Welle 4: Economy-Foundation-Flag. Per-pilot opt-in (default false) —
  // selbst wenn airline.economyEnabled=true, kann pilot persönlich auf
  // "purist mode" bleiben (no money UI). Beide flags müssen true sein
  // damit ein pilot economy-features sieht.
  economyEnabled Boolean @default(false)

  // Welle 6B (commit 6B-2): Employment-Status — ist dieser pilot operativ
  // aktiv? Default ACTIVE für alle (additive migration). Siehe enum-
  // docstring oben für die semantik der drei states. Status-changes
  // erfolgen via /airline/pilots personnel-management UI (Welle 6B-4).
  // Bewusst kein separater `employmentStatusUpdatedAt` field — wenn audit-
  // tracking gebraucht wird, kommt das mit einem dediziertem PersonnelEvent
  // log-table (out-of-scope für 6B). updatedAt am User-record reicht erstmal.
  employmentStatus EmploymentStatus @default(ACTIVE)

  // Welle 9: ACARS-Client-Pairing. Token wird einmalig beim pairing
  // generiert (siehe AcarsPairingCode redeem-flow), bleibt valid bis
  // der user manuell disconnected oder neu paired (rotation überschreibt).
  // Bearer-token im /api/acars/heartbeat header. NULL = nicht paired.
  // acarsLastSeen wird bei jedem heartbeat upgedated — UI nutzt das für
  // online/offline-state ("paired aber nicht aktiv" vs "live").
  acarsToken       String?     @unique
  acarsPairedAt    DateTime?
  acarsLastSeen    DateTime?
  // User-wahl welches network der ACARS-client per default annoncen soll.
  // VATSIM/IVAO sind erst sinnvoll wenn user die jeweilige account-
  // verknüpfung gemacht hat (vatsimCid / ivaoVid gesetzt) — sonst ist
  // Offline der einzige sinnvolle wert. Validation app-layer, kein
  // schema-constraint.
  preferredNetwork NetworkType @default(Offline)

  // Welle 4: Audit-trail für jumpseat-transfers (no-flight position-changes).
  jumpseatTransfers JumpseatTransfer[]

  // Welle 9: ACARS pairing-codes (1:N for code-history, but only one
  // code is unconsumed-and-unexpired at a time per requestPairingCode
  // logic — older unconsumed codes are force-expired by the request).
  acarsPairingCodes AcarsPairingCode[]

  // System-Catalog Request-Flow — Audit-Trail Beziehungen.
  // Ein User kann gleichzeitig Submitter (airline-admin) und Reviewer
  // (system-admin) sein wenn er beide Rollen hat. Verifier ist immer
  // system-admin (gate via Role.permissions check).
  airportRequests       AirportRequest[]      @relation("AirportRequester")
  airportReviews        AirportRequest[]      @relation("AirportReviewer")
  verifiedAirports      Airport[]             @relation("AirportVerifier")
  aircraftTypeRequests  AircraftTypeRequest[] @relation("AircraftTypeRequester")
  aircraftTypeReviews   AircraftTypeRequest[] @relation("AircraftTypeReviewer")
  verifiedAircraftTypes AircraftType[]        @relation("AircraftTypeVerifier")
}

model LiveSession {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  network    NetworkType
  externalId Int
  callsign   String

  // ACARS Phase 1: Trennung Network (wo) vs DataSource (wer liefert)
  dataSource         DataSource @default(VATSIM_API)
  acarsClientVersion String?
  lastAcarsHeartbeat DateTime?

  // Welle 9 (ACARS Phase 2-5): Extended telemetry from ACARS-client.
  // Alle nullable additive — VATSIM/IVAO-tracker fill nur die basics
  // weiter, nur ACARS_CLIENT füllt diese. UI muss null-tolerant sein.
  flightNumber   String?
  aircraftTitle  String? // ACARS only, e.g. "Asobo A320 Lufthansa"
  acarsSimulator Simulator?

  // Position-extension (über die basics altitude/groundSpeed/heading hinaus)
  altitudeAglFt     Int?
  indicatedAirspeed Int?
  trueAirspeed      Int?
  mach              Float?
  verticalSpeedFpm  Int?
  pitch             Float?
  bank              Float?

  // Engine — averaged over engines (client computes; server doesn't average)
  engineN1Avg Float?
  engineN2Avg Float?
  fuelFlowPph Int?
  fuelTotalKg Int?

  // State — surface + control settings
  flapsPercent     Int?
  gearDown         Boolean?
  spoilersDeployed Boolean?
  parkingBrake     Boolean?
  autopilotMaster  Boolean?

  // Forces + environment + phase
  gForce        Float?
  windSpeedKts  Int?
  windDirection Int?
  oatCelsius    Int?
  currentPhase  String? // 'PreFlight'|'Pushback'|'Taxi'|'Takeoff'|'Climb'|'Cruise'|'Descent'|'Approach'|'Landing'|'TaxiIn'|'BlockOn'

  // Anti-cheat: simRate >1.0 bedeutet sim-time-acceleration; totalPause-
  // Seconds aggregiert pause-zeit über die session. Beides wird in
  // PIREP-validation berücksichtigt (out-of-scope für 9A schema, das
  // ist 9F territory).
  simRate           Float?
  totalPauseSeconds Int    @default(0)

  aircraftType         String?
  aircraftRegistration String?

  departureIcao  String?
  arrivalIcao    String?
  alternateIcao  String?
  cruiseAltitude Int?
  flightRules    String?
  flightRoute    String? @db.Text
  flightRemarks  String? @db.Text

  latitude    Float
  longitude   Float
  altitude    Int
  groundSpeed Int
  heading     Int
  transponder String?
  onGround    Boolean @default(false)

  connectedAt   DateTime
  lastUpdatedAt DateTime
  isActive      Boolean  @default(true)

  positions LiveSessionPosition[]
  events    AcarsEvent[]

  @@unique([network, externalId])
  @@index([userId, isActive])
  @@index([network, isActive])
  @@index([lastUpdatedAt])
}

model LiveSessionPosition {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  latitude    Float
  longitude   Float
  altitude    Int
  groundSpeed Int
  heading     Int
  onGround    Boolean

  // Welle 9 (ACARS Phase 2-5): per-frame telemetry extensions for
  // PIREP-replay and chart-rendering. All nullable — VATSIM/IVAO
  // tracker writes only the basics above.
  altitudeAglFt     Int?
  indicatedAirspeed Int?
  verticalSpeedFpm  Int?
  pitch             Float?
  bank              Float?
  flapsPercent      Int?
  gearDown          Boolean?
  phase             String?

  recordedAt DateTime @default(now())

  @@index([sessionId, recordedAt])
}

model Rank {
  id             String   @id @default(cuid())
  airlineId      String
  airline        Airline  @relation(fields: [airlineId], references: [id])
  name           String
  minFlightHours Float    @default(0)
  order          Int
  createdAt      DateTime @default(now())

  users        User[]
  roleMappings DiscordRoleMapping[]

  @@unique([airlineId, name])
  @@index([airlineId, order])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())

  users   User[]
  invites Invite[]
}

model Aircraft {
  id             String         @id @default(cuid())
  airlineId      String
  airline        Airline        @relation(fields: [airlineId], references: [id])
  registration   String         @unique
  type           String
  // FK zu System-curated AircraftType-Catalog. Nullable für 1-Release-
  // Migration: existing airframes haben nur `type: String`, neue Logik
  // resolves via aircraftTypeId mit Fallback auf type-string-match.
  // Backfill-Script in Phase 1 matched bestehende `type` strings gegen
  // AircraftType.icaoType seed.
  aircraftTypeId String?
  aircraftType   AircraftType?  @relation(fields: [aircraftTypeId], references: [id])
  homeIcao       String?
  // Welle 5: Aircraft-Lifecycle-Status. Default ACTIVE für additive
  // migration — alle existing airframes mit active=true bekommen
  // status=ACTIVE, alle mit active=false bekommen status=RETIRED (im
  // backfill-step der migration). Siehe AircraftStatus-enum-docstring
  // für die semantik der einzelnen states.
  status         AircraftStatus @default(ACTIVE)
  // Legacy boolean — bleibt für app-compatibility erhalten, wird im
  // app-layer synchron mit status gehalten (status==ACTIVE → active=true).
  // Phase 2 (Welle 6+) deprecated dieses field nach UI-rollout.
  active         Boolean        @default(true)

  // Welle 5: Aircraft-Position-Tracking. Mirrors User.currentLocation*-
  // pattern (Welle 4). Wird beim PIREP-approval auf arrival.icao gesetzt
  // wenn der PIREP an dieses aircraft gebunden ist (Pirep.aircraftId).
  // Wenn null = aircraft ist an seinem homeIcao (default-fallback in der
  // UI). currentLocationAt für staleness-checks.
  //
  // Bewusst KEIN currentLocationSource hier (anders als User) — aircraft-
  // movements kommen aktuell NUR aus PIREPs. Bei späterer ferry-flight-
  // logik (Welle 7+) würde das wieder relevant.
  currentLocationIcao String?
  currentLocationAt   DateTime?

  // SimBrief Override-Hierarchie Ebene 3 (per individual airframe).
  // z.B. "this specific D-AIBL has reduced MTOW because of MEL". Über-
  // steuert Airline + Fleet defaults.
  simBriefOverlay Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  routes Route[]
  pireps Pirep[]

  // Welle 7: Schedule-System back-relations. Beide named-relations weil
  // sowohl ScheduleTemplate als auch ScheduledFlight ein optionales
  // preferredAircraftId-FK haben (informational, keine hard-block in 7A).
  scheduleTemplatePreferences ScheduleTemplate[] @relation("ScheduleTemplatePreferredAircraft")
  scheduledFlightPreferences  ScheduledFlight[]  @relation("ScheduledFlightPreferredAircraft")

  // Welle 5: Indexes für die /airline/aircraft filter-UI.
  // - (airlineId, status): "alle aktiven aircraft meiner airline" (häufigster query)
  // - (airlineId, homeIcao): "aircraft basiert in EDDF" (hub-specific list)
  // - (currentLocationIcao): "welche aircraft sind grade in EDDF?" (booking-availability)
  @@index([airlineId, status])
  @@index([airlineId, homeIcao])
  @@index([currentLocationIcao])
}

// SimBrief Override-Hierarchie Ebene 2 — Fleet-defaults per (airline, type).
//
// Ein Fleet-row ist (airlineId, type) — z.B. (DLH, "A320") — und hält
// Defaults die für ALLE Aircraft dieses Typs in dieser Airline gelten,
// es sei denn ein einzelnes Aircraft oder ein einzelner Route überschreibt
// das Feld.
//
// Aircraft.fleetId wurde bewusst NICHT eingefügt — die Verbindung passiert
// über (airline.id, aircraft.type) lookup im resolveSimBriefOverlay-Helper.
// Vorteil: keine Migration für existierende Aircraft, keine FK-cascade-
// surprises beim Aircraft.type-rename, Fleet bleibt optional pro Type.
//
// Wenn kein Fleet-row für eine (airlineId, type) Kombination existiert,
// fällt der Helper transparent auf Airline-default zurück — d.h. Fleet
// ist eine optionale Zwischenschicht, kein Pflicht-Feld.
model Fleet {
  id              String   @id @default(cuid())
  airlineId       String
  airline         Airline  @relation(fields: [airlineId], references: [id])
  type            String // ICAO type designator, e.g. "A320", "B738"
  simBriefOverlay Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([airlineId, type])
}

model Airport {
  id        String  @id @default(cuid())
  icao      String  @unique
  iata      String?
  name      String
  city      String?
  country   String
  latitude  Float
  longitude Float
  elevation Int?

  // OurAirports.com taxonomy fields. Eingeführt mit dem ~85k-airport-bulk-
  // import. `type` ist eine kontrollierte enum (large_airport | medium_airport
  // | small_airport | heliport | seaplane_base | balloonport | closed) — als
  // String statt enum, damit OurAirports neue typen einführen kann ohne migration.
  // `continent` ist 2-letter ISO continent code (NA/EU/AS/AF/OC/SA/AN).
  // `scheduledService` = ob der airport regelmäßigen kommerziellen flug-
  // verkehr hat — wichtigster filter für virtual-airline-kontext, weil die
  // meisten heliports/balloonports/closed nicht für VAM-routes interessant sind.
  // Alle nullable damit existing rows (vor migration) nicht brechen.
  type             String?
  continent        String?
  scheduledService Boolean @default(false)
  gpsCode          String?
  wikipediaLink    String?

  // System-curated catalog: airline-admins können einzelne airports nicht
  // direkt anlegen; sie reichen einen AirportRequest ein, system-admin
  // approved/rejects. `verified` = system-admin hat die daten geprüft;
  // `false` = provisional (UI zeigt warning-badge). `active=false` ist
  // soft-delete (z.B. flughafen geschlossen) ohne FK-cascades zu brechen.
  active                Boolean         @default(true)
  verified              Boolean         @default(false)
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?           @relation("AirportVerifier", fields: [verifiedById], references: [id])
  // Nullable + unique: 1:1 zu AirportRequest. Null wenn airport direkt von
  // system-admin angelegt wurde (kein request-flow); set wenn aus approve-
  // request-creation. Audit-trail über die request-relation.
  proposedFromRequestId String?         @unique
  proposedFromRequest   AirportRequest? @relation("AirportFromRequest", fields: [proposedFromRequestId], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  routesFrom Route[] @relation("RouteDeparture")
  routesTo   Route[] @relation("RouteArrival")
  pirepsFrom Pirep[] @relation("PirepDeparture")
  pirepsTo   Pirep[] @relation("PirepArrival")

  // Detail-tabellen aus OurAirports.com — runways/frequencies/navaids als
  // separate models statt JSON-blobs damit sie indexierbar/durchsuchbar
  // sind (z.B. "alle airports mit ILS auf einer 3000m+ runway"). Cascade
  // delete: wenn ein airport gelöscht wird, gehen seine runways/freqs mit.
  // Navaids haben optional FK weil manche standalone-stations sind.
  runways     Runway[]
  frequencies AirportFrequency[]
  navaids     Navaid[]           @relation("NavaidAssociatedAirport")

  // Welle 4: Multi-Hub-System — back-relations für AirlineHub. Eine Airline
  // kann diesen airport als hub nutzen (e.g. EDDF ist hub für mehrere VAs).
  airlineHubs AirlineHub[]

  // Welle 4: Jumpseat-Audit-Trail — back-relations für JumpseatTransfer.
  // Named relations weil zwei FK-felder auf icao verweisen (from/to).
  jumpseatsFrom JumpseatTransfer[] @relation("JumpseatFrom")
  jumpseatsTo   JumpseatTransfer[] @relation("JumpseatTo")

  // Indexes für die /airports filter-UI: type/continent/country erlauben
  // schnelle multi-faceted queries auf 85k entries; scheduledService trennt
  // commercial- von hobby-airports.
  @@index([type])
  @@index([continent])
  @@index([country])
  @@index([scheduledService])
}

model Route {
  id               String    @id @default(cuid())
  airlineId        String
  airline          Airline   @relation(fields: [airlineId], references: [id])
  flightNumber     String
  departureId      String
  departure        Airport   @relation("RouteDeparture", fields: [departureId], references: [id])
  arrivalId        String
  arrival          Airport   @relation("RouteArrival", fields: [arrivalId], references: [id])
  aircraftId       String?
  aircraft         Aircraft? @relation(fields: [aircraftId], references: [id])
  // Required aircraft type für die route, ICAO-designator (B738, A20N, A359).
  // Bewusst String statt FK zu AircraftType-catalog: airline-admins sollen
  // im CSV-import nicht durch den AircraftTypeRequest-flow gezwungen werden
  // wenn ein type fehlt. UI kann optional gegen catalog matchen für badge/
  // verlinkung, aber persistence akzeptiert auch unkatalogisierte typen.
  // Pilot-flexibilität: route definiert _kompatiblen_ type, nicht specific
  // airframe — pilot kann jede livery fliegen die zum type passt (siehe
  // ADR Routes-Phase-1).
  aircraftTypeIcao String?
  estimatedMinutes Int
  distanceNm       Int
  active           Boolean   @default(true)
  // SimBrief Override-Hierarchie Ebene 4 (highest precedence). Per-route
  // overrides — z.B. "the cargo run to LFPG carries 0 pax + extra fuel".
  // Übersteuert alle anderen Ebenen.
  simBriefOverlay  Json?
  createdAt        DateTime  @default(now())

  pireps   Pirep[]
  bookings Booking[]

  // Welle 7: Schedule-System back-relations. Routes können mehrere
  // ScheduleTemplate-rows referenzieren (z.B. selber flightNumber zu
  // verschiedenen tageszeiten) und entsprechend viele ScheduledFlight-
  // instanzen produzieren. Cascade beim Route-delete: zugehörige
  // templates+instances werden mit aufgeräumt (Routes ohne schedules
  // sind weiter möglich).
  scheduleTemplates ScheduleTemplate[]
  scheduledFlights  ScheduledFlight[]

  @@unique([airlineId, flightNumber])
  @@index([departureId])
  @@index([arrivalId])
}

model Pirep {
  id          String      @id @default(cuid())
  airlineId   String
  airline     Airline     @relation(fields: [airlineId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  routeId     String?
  route       Route?      @relation(fields: [routeId], references: [id])
  aircraftId  String?
  aircraft    Aircraft?   @relation(fields: [aircraftId], references: [id])
  departureId String
  departure   Airport     @relation("PirepDeparture", fields: [departureId], references: [id])
  arrivalId   String
  arrival     Airport     @relation("PirepArrival", fields: [arrivalId], references: [id])
  state       FlightState @default(Planned)
  network     NetworkType @default(Offline)
  status      PirepStatus @default(Submitted)

  // Welle 4: Flight-Type. Default SCHEDULED, mirrors Booking.flightType bei
  // booking-linked PIREPs. Standalone-PIREPs (ohne booking, z.B. legacy-
  // import) defaulten ebenfalls auf SCHEDULED. FREE-flight-PIREPs setzen
  // das auf FREE bei file-time. Wird in stats/leaderboards für filter
  // "scheduled hours only" vs "all flight time" benutzt.
  flightType FlightType @default(SCHEDULED)

  // Welle 4: Economy-Foundation. Optional ints für passenger/cargo loads.
  // NULL = "nicht erfasst" (default für Welle 4-PIREPs ohne economy aktiv).
  // Werden ab Welle 12 (economy-launch) automatisch beim file-time gesetzt
  // wenn airline.economyEnabled. Manuelle eingabe schon ab Welle 4 möglich
  // wenn user.economyEnabled (für early-adopters/private-economy-mode).
  passengerCount Int?
  cargoKg        Int?

  flightTimeMin   Int?
  fuelUsedKg      Int?
  landingRateFpm  Int?
  remarks         String?
  submittedAt     DateTime         @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  approvedById    String?
  approver        User?            @relation("PirepApprover", fields: [approvedById], references: [id])
  // 1:1 — eine Booking hat max. einen abschließenden PIREP. DB-level Uniqueness
  // schützt vor Doppel-Submit-Race-Conditions; bei v2 Multi-Leg wird ein eigenes
  // Booking-Parent/Leg-Children-Pattern entstehen, nicht 1:n hier.
  bookingId       String?          @unique
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  flightPlanCache FlightPlanCache?

  // Welle 9 (ACARS Phase 2-5): wenn dieser PIREP von einem auto-trigger
  // (BLOCK_ON event vom ACARS-client) erzeugt wurde, points back to
  // the source-event for audit-trail. NULL für manuelle PIREPs (default).
  triggeringEvent AcarsEvent? @relation("PirepTriggeringEvent")

  @@index([userId, submittedAt])
  @@index([airlineId, status])
  @@index([approvedById])
}

model Award {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconUrl     String?
  criteria    Json?
  createdAt   DateTime @default(now())

  userAwards UserAward[]
}

model UserAward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  awardId   String
  award     Award    @relation(fields: [awardId], references: [id])
  awardedAt DateTime @default(now())

  @@unique([userId, awardId])
}

model Scenery {
  id          String   @id @default(cuid())
  airlineId   String?
  airline     Airline? @relation(fields: [airlineId], references: [id])
  name        String
  airportIcao String?
  provider    String?
  url         String?
  free        Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model FeatureFlag {
  id        String   @id @default(cuid())
  airlineId String?
  airline   Airline? @relation(fields: [airlineId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([airlineId, userId, key])
}

model DiscordRoleMapping {
  id             String   @id @default(cuid())
  airlineId      String
  airline        Airline  @relation(fields: [airlineId], references: [id])
  rankId         String?
  rank           Rank?    @relation(fields: [rankId], references: [id])
  discordRoleId  String
  discordGuildId String
  createdAt      DateTime @default(now())

  @@unique([airlineId, discordRoleId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Booking {
  id        String  @id @default(cuid())
  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  // Required + onDelete: Restrict (default). Booking ohne Route ist Nonsense-State.
  // Hard-Delete einer Route erfordert vorheriges Cancel/Expire aller referenzierenden Bookings
  // — bewusste Operational Hygiene, nicht Bug.
  routeId String
  route   Route  @relation(fields: [routeId], references: [id])

  state BookingState @default(Created)

  // Welle 4: Flight-Type-Klassifizierung für die booking. Default SCHEDULED
  // (additive — alle existing bookings sind scheduled-typed). FREE-bookings
  // werden über separate flow erzeugt (route ist dann ein "synthetic"
  // free-flight-route per session). Per-PIREP wird bei file-time gespiegelt.
  flightType FlightType @default(SCHEDULED)

  // Hint für UI/Filter, kein Hard-Lock — actual Network kommt vom PIREP/LiveSession
  intendedNetwork NetworkType?

  // Geplante Abflugzeit (UTC). Optional — wenn null, dispatcht User ohne
  // schedule (SimBrief defaultet auf "next available departure"). Wenn
  // gesetzt, propagieren wir es als deph/depm/date in den Pattern α + Z
  // Dispatch-URLs damit SimBrief mit der richtigen METAR/TAF und Tageszeit
  // plant. v1: immutable nach booking-creation. Edit-flow käme mit dem
  // Booking-Edit-Pattern Phase 2.
  scheduledDeparture DateTime?

  dispatchedAt DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime // app-level: createdAt + 7d in v1
  cancelledAt        DateTime?
  cancellationReason String?

  pirep           Pirep?
  flightPlanCache FlightPlanCache?

  // Welle 7: 1:0..1 zur ScheduledFlight. Set wenn die booking via
  // scheduled-flight-pickup erstellt wurde (vs. ad-hoc free-pull-route-
  // booking aus der bisherigen route-liste). NULL für legacy- und
  // free-bookings. SetNull-cascade: wenn ScheduledFlight gelöscht
  // wird (sollte nicht passieren), bleibt die Booking erhalten.
  scheduledFlight ScheduledFlight?

  @@index([userId, state])
  @@index([airlineId, state])
  @@index([routeId])
  @@index([expiresAt])
}

// Pattern α Cache-Architecture — per-Booking ownership.
// Each Booking has at most ONE FlightPlanCache (1:0..1 via @unique bookingId).
// Lifecycle-Vorbereitung: bei PIREP-File transferiert sich der Cache vom
// Booking zum Pirep (Phase 2 Implementation). bookingId wird auf null gesetzt,
// pirepId wird gesetzt. Cache überlebt damit Booking-Stornierung wenn ein
// PIREP existiert.
//
// Multi-Tenancy: airlineId bleibt explicit field (nicht via Booking-Join
// derived) für direct queries + index-effizientes Filtering.
//
// SimBrief weather TTL — 6h hardcoded weil physikalisch, nicht airline-policy.
model FlightPlanCache {
  id        String   @id @default(cuid())
  airlineId String
  airline   Airline  @relation(fields: [airlineId], references: [id])
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pirepId   String?  @unique
  pirep     Pirep?   @relation(fields: [pirepId], references: [id], onDelete: SetNull)

  ofpId        String
  rawResponse  Json
  routeString  String? @db.Text
  fuelKg       Int?
  blockTimeMin Int?

  generatedAt DateTime @default(now())
  expiresAt   DateTime

  @@index([airlineId])
  @@index([expiresAt])
}

// Invite-Tokens für User-Onboarding zu einer Airline. Admin generiert ein
// Invite, schickt den Link manuell (Discord-DM, Email) an den potenziellen
// Pilot. Beim Klick:
//   1. Wenn nicht eingeloggt → Discord-OAuth-Login mit callbackUrl=/invite/[token]
//   2. Nach Login: validate token (existiert, nicht expired, nicht used)
//   3. User klickt "Annehmen" → User.airlineId + (optional) User.roleId gesetzt
//   4. Invite.usedAt + usedById gesetzt → Token nicht mehr nutzbar
//
// Lifecycle:
//   - createdAt + 7d default expiry (kann override werden)
//   - usedAt = null → pending; usedAt != null → used (terminal)
//   - admin kann pending-invite revoken via setExpiresAt(now)
//
// Security:
//   - token = cuid(), 25-char unguessable, unique-indexed
//   - email-field optional, only as hint für admin (welcher pilot war
//     gemeint?), wird NICHT validiert beim accept (wir trust den
//     Discord-OAuth-Identity vom session)
//   - Token-Replay: usedAt-Check ist die einzige Defense — first-accept-wins
model Invite {
  id    String @id @default(cuid())
  token String @unique // URL-safe random token (cuid format)

  // Pre-fill / Hint — der Admin trägt ein wer eingeladen wurde, aber das
  // wird beim accept NICHT als gate genutzt. User-Identity kommt aus
  // dem authenticated NextAuth-session.
  email String?

  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id])

  // Wenn null → User wird nur airline-zugewiesen, role muss admin später
  // manuell setzen (oder der User behält null-role und ist ein "pending pilot").
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  expiresAt DateTime
  usedAt    DateTime? // null = pending; != null = used or revoked

  // Wer hat das Invite erstellt
  createdById String
  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id])

  // Wer hat das Invite eingelöst (null wenn pending)
  usedById String?
  usedBy   User?   @relation("InviteUser", fields: [usedById], references: [id])

  createdAt DateTime @default(now())

  @@index([airlineId, usedAt])
  @@index([token])
  @@index([expiresAt])
}

// ============================================================================
// SYSTEM-CURATED CATALOGS — Airport, AircraftType
//
// Phase 1 Architektur:
// - Airline-admins können nicht direkt anlegen — sie reichen einen Request ein.
// - System-admin sieht queue (/admin/requests), approves oder rejects.
// - Approve mit `asVerified=true` → catalog-entry mit verified-badge.
// - Approve mit `asVerified=false` → unverified entry (UI warning + edit-flag).
// - Subsequent verify-action: system-admin kann unverified entry später
//   verified machen (Airport.verified true setzen) wenn daten geprüft.
// - Airline-admins können trotzdem unverified entries nutzen — sie sehen
//   nur das warning-badge im picker.
//
// Audit-Trail: Catalog-entry → proposedFromRequest → request.requestedBy
// (proposer) + request.reviewer (approver). verifiedBy ist separater field
// für späteren verify-step (kann anderer system-admin sein als approver).
// ============================================================================

// AircraftType — system-curated aircraft type designations (B738, A20N, etc.).
// Initial seed: ~150 ICAO doc-8643 entries (manuell kurated TS array, alle
// verified=true). Spätere additions kommen via AircraftTypeRequest-flow.
//
// Beziehung zu Aircraft: Aircraft.aircraftTypeId optional FK. Während Phase 1
// koexistieren Aircraft.type:String und Aircraft.aircraftTypeId:String — neue
// resolver-logik bevorzugt aircraftTypeId, fällt zurück auf type-string-match
// gegen AircraftType.icaoType. Phase 2 backfill setzt aircraftTypeId für alle
// existing airframes; Phase 3 deprecated Aircraft.type field.
//
// Fleet[] relation deferred zu Phase 2 — derzeit Fleet.type:String, refactor
// auf FK braucht eigenes migration window.
// AircraftTypeRating[] deferred zu Phase 5 (Pilot-Type-Ratings feature).
model AircraftType {
  id                    String               @id @default(cuid())
  icaoType              String               @unique // ICAO doc-8643 designator: "B738", "A20N", "A359"
  name                  String // "Boeing 737-800", "Airbus A320neo"
  manufacturer          String // "Boeing", "Airbus", "Embraer"
  category              String // "narrow_body" | "wide_body" | "regional" | "cargo" | "ga"
  rangeNm               Int // Maximum range in nautical miles
  capacityPax           Int // Typical 2-class passenger capacity
  cruiseSpeedKt         Int // Cruise speed in knots
  fuelBurnKgH           Int // Approximate fuel burn kg/hour
  imageUrl              String? // Optional reference image (CC-licensed or owned)
  active                Boolean              @default(true)
  verified              Boolean              @default(false)
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?                @relation("AircraftTypeVerifier", fields: [verifiedById], references: [id])
  proposedFromRequestId String?              @unique
  proposedFromRequest   AircraftTypeRequest? @relation("AircraftTypeFromRequest", fields: [proposedFromRequestId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  aircraft Aircraft[]
}

// AirportRequest — proposal von airline-admin für catalog-erweiterung.
// State-machine: Submitted → UnderReview → (Approved | Rejected).
// Rate-limit: max 10 open (status != terminal) per user (enforced in
// server-action). Bei Approval mit `approvedAsVerified` Boolean wird:
//   1. Airport-row erstellt (proposedFromRequestId = this.id)
//   2. status = Approved, reviewedAt set, reviewer set
//   3. Wenn approvedAsVerified=true → Airport.verified=true, verifiedById=reviewer
//   4. Wenn approvedAsVerified=false → Airport.verified=false (provisional)
model AirportRequest {
  id                 String        @id @default(cuid())
  // Proposed airport data (mirrors Airport schema, except no FK fields)
  icao               String
  iata               String?
  name               String
  city               String?
  country            String
  latitude           Float
  longitude          Float
  elevation          Int?
  // Request meta
  status             RequestStatus @default(Submitted)
  reason             String? // Optional: "needed for new charter route to Greenland"
  // Submitter
  requestedById      String
  requestedBy        User          @relation("AirportRequester", fields: [requestedById], references: [id])
  // Optional airline-context — null wenn user solo (kein airline-admin)
  requestedAirlineId String?
  requestedAirline   Airline?      @relation("AirportRequestAirline", fields: [requestedAirlineId], references: [id])
  submittedAt        DateTime      @default(now())
  // Reviewer
  reviewedById       String?
  reviewer           User?         @relation("AirportReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  rejectionReason    String? // Set wenn status=Rejected
  reviewerNotes      String? // Optional internal notes (not shown to requester)
  // Set wenn status=Approved: war approve-as-verified oder approve-as-unverified?
  approvedAsVerified Boolean?
  // Back-relation 1:1: ein approved request creates max einen Airport
  createdAirport     Airport?      @relation("AirportFromRequest")

  @@index([status, submittedAt])
  @@index([requestedById, submittedAt])
  @@index([icao])
}

// AircraftTypeRequest — analog zu AirportRequest. State-machine identisch.
model AircraftTypeRequest {
  id                  String        @id @default(cuid())
  // Proposed aircraft type data
  icaoType            String
  name                String
  manufacturer        String
  category            String
  rangeNm             Int
  capacityPax         Int
  cruiseSpeedKt       Int
  fuelBurnKgH         Int
  imageUrl            String?
  // Request meta (analog AirportRequest)
  status              RequestStatus @default(Submitted)
  reason              String?
  requestedById       String
  requestedBy         User          @relation("AircraftTypeRequester", fields: [requestedById], references: [id])
  requestedAirlineId  String?
  requestedAirline    Airline?      @relation("AircraftTypeRequestAirline", fields: [requestedAirlineId], references: [id])
  submittedAt         DateTime      @default(now())
  reviewedById        String?
  reviewer            User?         @relation("AircraftTypeReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  rejectionReason     String?
  reviewerNotes       String?
  approvedAsVerified  Boolean?
  createdAircraftType AircraftType? @relation("AircraftTypeFromRequest")

  @@index([status, submittedAt])
  @@index([requestedById, submittedAt])
  @@index([icaoType])
}

// ============================================================================
// AIRPORT DETAIL DATA (Runways, Frequencies, Navaids)
//
// Importiert aus OurAirports.com CSVs (runways.csv, airport-frequencies.csv,
// navaids.csv). Source-of-truth ist `ourAirportsId` (Int) damit re-imports
// idempotent sind — wenn OurAirports einen entry updated, finden wir ihn
// per source-id wieder und updaten in-place statt einen duplikat-row zu
// erstellen.
//
// FK-strategie: Über `airportIcao` (String) statt `airportId` (cuid). Das
// CSV bringt `airport_ident` mit, was identisch zu Airport.icao ist (selber
// import-source). Cascade-delete: wenn ein Airport gelöscht wird, gehen
// seine runways/frequencies mit. Navaids haben optional FK weil manche
// navaids "associated" mit einem airport sind (e.g. FRA VOR), andere
// standalone (en-route navaids).
//
// Verifications-policy: Im gegensatz zu Airport.verified gibt es hier kein
// verified-flag — die daten sind aus OurAirports und werden 1:1 übernommen.
// Falls airline-admins eine korrektur brauchen, geht das über einen edit-
// flow auf den Airport selbst (zukünftig), nicht per request-flow auf die
// detail-tabellen.
// ============================================================================

// Runway — physische landebahn an einem airport. Jede runway hat zwei
// "ends" (low end + high end), z.B. RWY 09/27 hat le_ident=09 + he_ident=27.
// Heading in degrees true (degT), nicht magnetic.
model Runway {
  id            String  @id @default(cuid())
  ourAirportsId Int?    @unique
  airportIcao   String
  airport       Airport @relation(fields: [airportIcao], references: [icao], onDelete: Cascade)

  // Physische dimensionen
  lengthFt Int? // Runway length in feet (e.g. 11000 = ~3350m)
  widthFt  Int? // Runway width in feet (e.g. 200 = ~60m)
  surface  String? // ASPH, CONC, GRASS, GRAVEL, WATER, etc — kontrolliertes vocab aus OurAirports
  lighted  Boolean @default(false) // Hat runway lights?
  closed   Boolean @default(false) // Permanent closed runway

  // Low-end (numerisch niedrigere kennung, z.B. "09" für 09/27 paar)
  leIdent       String? // "09", "13L", "32R"
  leLatitude    Float?
  leLongitude   Float?
  leElevationFt Int?
  leHeadingDegT Float? // True heading 0-359
  leDisplacedFt Int? // Displaced threshold offset

  // High-end (z.B. "27" für 09/27 paar)
  heIdent       String?
  heLatitude    Float?
  heLongitude   Float?
  heElevationFt Int?
  heHeadingDegT Float?
  heDisplacedFt Int?

  // Indizes für: per-airport-lookup (häufigster query), filter "alle airports
  // mit closed=false runways" für route-planning, surface-filter (z.B. "nur
  // hartbahnen für jets").
  @@index([airportIcao])
  @@index([surface])
  @@index([closed])
}

// AirportFrequency — radio-frequenzen pro airport (TWR, GND, APP, ATIS, etc).
// Ein airport hat typisch 3-15 frequencies. `type` ist OurAirports-vocab
// (TWR, GND, APP, DEP, ATIS, AWOS, ASOS, CTAF, ARCAL, MULTICOM, UNICOM, etc).
model AirportFrequency {
  id            String  @id @default(cuid())
  ourAirportsId Int?    @unique
  airportIcao   String
  airport       Airport @relation(fields: [airportIcao], references: [icao], onDelete: Cascade)

  type         String // TWR, GND, APP, ATIS, etc
  description  String? // Optional human-readable, z.B. "Tower South"
  frequencyMhz Float // Civilian VHF aviation band 118-137 MHz

  @@index([airportIcao])
  @@index([type])
}

// Navaid — VOR/NDB/DME/ILS/etc stations. Manche sind "associated" mit einem
// airport (e.g. ILS approach für RWY 25R), manche standalone (en-route VOR).
// `ident` ist der callsign der station (3-5 chars, z.B. "FRA" für Frankfurt VOR).
model Navaid {
  id            String @id @default(cuid())
  ourAirportsId Int?   @unique

  ident        String // Callsign, z.B. "FRA", "TGO", "WUR"
  name         String // Voll-name, z.B. "Frankfurt VOR-DME"
  type         String // VOR, VOR-DME, VORTAC, NDB, NDB-DME, DME, TACAN, ILS, GS, MARKER, OM, MM, IM
  frequencyKhz Int? // Frequency in kHz (VOR/ILS sind MHz aber gespeichert *100, NDB ist kHz)
  latitude     Float
  longitude    Float
  elevationFt  Int?
  isoCountry   String // ISO 2-letter

  // Optional DME-component für VOR-DME, VORTAC pairs
  dmeFrequencyKhz Int?
  dmeChannel      String?
  dmeLatitude     Float?
  dmeLongitude    Float?
  dmeElevationFt  Int?

  slavedVariationDeg   Float? // Magnetic variation slaved into the station
  magneticVariationDeg Float?
  usageType            String? // HI (high-altitude airway), LO (low), BOTH, TERM (terminal), RNAV
  power                String? // LOW, MEDIUM, HIGH

  // Optional FK zu Airport (manche navaids sind "owned by" einem airport,
  // andere standalone). Cascade SetNull statt Cascade-Delete, damit ein
  // navaid überlebt wenn der zugeordnete airport mal entfernt wird.
  associatedAirportIcao String?
  associatedAirport     Airport? @relation("NavaidAssociatedAirport", fields: [associatedAirportIcao], references: [icao], onDelete: SetNull)

  @@index([associatedAirportIcao])
  @@index([type])
  @@index([ident])
}

// ============================================================================
// WELLE 4 — HUB-SYSTEM & POSITION-TRACKING
//
// AirlineHub: many-to-one zu Airline mit isPrimary-flag. Eine Airline kann
// 1..N hubs haben. Genau einer ist primary (default-base für neue piloten,
// scheduling-anchor). Multi-tenant: hub-FK ist über airportIcao (string)
// statt cuid, mirrors Runway/AirportFrequency-pattern weil airport.icao
// system-curated und stable ist.
//
// JumpseatTransfer: append-only audit-log für no-flight position-changes.
// Nicht state-machine — eine reihe = ein transfer. Wird beim app-flow
// inserted UND User.currentLocationIcao+Source+At werden im selben
// transaction-block gesetzt. Reason für audit-fragen ("warum ist pilot
// in Asien gelandet wenn sein hub Berlin ist").
// ============================================================================

// AirlineHub — multi-hub-system pro airline. EDDF/EDDM für DLH-virtual,
// EGLL/EGLC für BAW-virtual, etc. Eine Airline hat 1..N hubs, einer ist
// primary (UI-default, scheduling-default-anchor). isPrimary-uniqueness
// per airlineId wird via app-logik enforced (nicht @@unique constraint
// weil postgres partial-unique-indexes nicht direkt in prisma schema
// ausdrückbar sind ohne raw migration).
model AirlineHub {
  id          String   @id @default(cuid())
  airlineId   String
  airline     Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  // FK über icao (string) statt cuid — mirrors Runway/AirportFrequency
  // pattern. airport.icao ist system-curated und stable (verifizierte
  // catalog-entries werden nicht umbenannt).
  airportIcao String
  airport     Airport  @relation(fields: [airportIcao], references: [icao])
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  // (airlineId, airportIcao) muss eindeutig sein — keine duplikate.
  @@unique([airlineId, airportIcao])
  // Index für "wer ist primary-hub von airline X?" (häufigste query)
  @@index([airlineId, isPrimary])
}

// JumpseatTransfer — append-only audit-log. Pilot bewegt sich ohne flug
// von einem icao zu einem anderen (typisch: zurück zum hub nach gestrandet,
// oder admin-driven correction). Eine reihe pro transfer, kein update —
// historisch nachvollziehbar.
//
// Beziehung zur User-position-tracking: Beim transfer-insert wird in der
// gleichen transaction User.currentLocationIcao = toIcao gesetzt,
// currentLocationSource = JUMPSEAT, currentLocationAt = NOW. Der transfer
// ist die "warum" und User.* das "wo jetzt".
//
// Welle 4 hat noch keine cost/restriction-logik (kommt mit economy in
// Welle 12+). Vorerst sind alle transfers kostenfrei und unrestricted.
model JumpseatTransfer {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  // Source-airport — über icao (string), mirrors Runway pattern.
  fromIcao    String
  fromAirport Airport        @relation("JumpseatFrom", fields: [fromIcao], references: [icao])
  // Target-airport — analog.
  toIcao      String
  toAirport   Airport        @relation("JumpseatTo", fields: [toIcao], references: [icao])
  reason      JumpseatReason
  // Optional notes — admin-transfer-grund o.ä. Wenn NULL = pilot-self-
  // service-transfer (RETURN_TO_HUB, HUB_TO_HUB).
  notes       String?
  createdAt   DateTime       @default(now())

  // Häufigste query: "alle transfers von user X, neueste zuerst" (für
  // jumpseat-history-UI auf pilot-profile).
  @@index([userId, createdAt])
  // Sekundär: "alle transfers nach airport X" (admin-debug).
  @@index([toIcao, createdAt])
}

// ============================================================================
// WELLE 7 — SCHEDULE GENERATOR
//
// Zwei-schichten-architektur:
//
//   ScheduleTemplate    →    ScheduledFlight    →    Booking    →    Pirep
//   (recurring rule)         (concrete instance)     (pilot)        (filed)
//
// 1. ScheduleTemplate: admin definiert wiederkehrende muster ("Mo+Mi+Fr 14:30 UTC
//    auf route LH123, A320 als preferred airframe"). Templates haben einen
//    validity-window (validFrom..validUntil) und einen active-flag für
//    soft-disable.
//
// 2. Generator-helper (@/lib/schedule, kommt 7A-2) materialisiert templates
//    zu konkreten ScheduledFlight-instanzen über einen date-range. Idempotent:
//    läuft re-runs ohne duplikate (skipt schon-existierende slots an gleichem
//    departureTime + templateId).
//
// 3. Pilot pickt einen Planned-slot aus seiner schedule-view → wir erstellen
//    eine Booking und linken sie atomar via ScheduledFlight.bookingId. Slot
//    flippt auf Booked.
//
// 4. Booking wird durch den existierenden booking-flow gefahren (SimBrief
//    dispatch, PIREP file, approval). Bei PIREP-approval setzen wir den
//    ScheduledFlight auf Completed.
//
// CHARTER-flights: ein ScheduledFlight ohne templateId = einmal-flug der
// nicht aus einem recurring-pattern stammt. Admin erstellt manuell, pilot
// pickt wie eine reguläre scheduled-instanz. FlightType.CHARTER wird beim
// booking gesetzt (statt SCHEDULED).
//
// Was 7A NICHT macht: hard-conflicts auf preferredAircraft (A320 ist um
// 14:30 schon auf LH456 → blockiere LH789). Conflict-detection als UI-
// warning ja, hard-block kommt mit fleet-rotation-logik später.
// ============================================================================

// ScheduleTemplate — wiederkehrendes flug-muster pro route. Admin-only-CRUD
// via /airline/schedule (kommt 7B-1). Generator-helper kann instanzen für
// ein date-window materialisieren.
model ScheduleTemplate {
  id        String  @id @default(cuid())
  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  routeId   String
  route     Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  // Optional human-friendly label, z.B. "Daily MUC-FRA Morning Shuttle".
  // Falls NULL, rendert UI route.flightNumber + departureTime als fallback.
  label String?

  // Wochentage an denen dieses template ausgeführt wird. ISO-8601: 1=Monday,
  // 7=Sunday. Postgres Int[]-array — direkter array-contains query möglich
  // ("alle templates die montags laufen"). Validation in app-layer:
  // Werte müssen in {1..7} liegen, mind. 1 element.
  daysOfWeek Int[]

  // Departure-time als minuten-seit-mitternacht UTC (0..1439). Bewusst Int
  // statt String "HH:mm": sortierbar (ORDER BY departureMinuteUtc), arith-
  // metisch (z.B. "alle flüge zwischen 06:00-12:00 UTC" als single range-
  // query), keine timezone-ambiguität. Display-helper rendert zu "HH:mm Z".
  // Wahl von UTC über local-time-of-airport: vermeidet DST-surprises wenn
  // Europa shiftet aber Asia nicht, und matcht wie SimBrief/VATSIM/IVAO
  // über zeit denken.
  departureMinuteUtc Int

  // Validity-window. Generator erstellt instanzen NUR für dates in
  // [validFrom, validUntil ?? +infinity]. Use-cases: seasonal routes
  // (sommer-only), graceful-retire (validUntil setzen statt template-
  // löschen, behält historische instances/bookings intakt), promo-
  // schedules (limited-time offers).
  validFrom  DateTime
  validUntil DateTime?

  // Optional preferred airframe. NULL = generator setzt keinen airframe an
  // den instanzen, pilot picked beim booking. Set = generator inheritet
  // den preferredAircraftId an die generierten ScheduledFlight-rows.
  // Conflict-detection (airframe doppelt verplant) ist 7A nur informational
  // im UI; hard-block ist out-of-scope. SetNull bei aircraft-delete damit
  // template überlebt.
  preferredAircraftId String?
  preferredAircraft   Aircraft? @relation("ScheduleTemplatePreferredAircraft", fields: [preferredAircraftId], references: [id], onDelete: SetNull)

  // Soft-disable. Generator skipt active=false templates auch wenn date in
  // validity-window. Existing instanzen bleiben bestehen (sie sind ja schon
  // generated). Re-aktivieren = einfach active=true setzen.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledFlights ScheduledFlight[]

  // Häufige queries:
  // - "alle aktiven templates meiner airline" (admin overview)
  // - "alle templates für route X" (route-detail-view, falls je gebraucht)
  @@index([airlineId, active])
  @@index([routeId])
}

// ScheduledFlight — konkrete generierte instanz oder ad-hoc charter-slot.
// Lebenszyklus: Planned → Booked → Completed (oder Cancelled).
model ScheduledFlight {
  id        String  @id @default(cuid())
  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  routeId   String
  route     Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  // Optional template-FK. Set für generator-erzeugte instanzen, NULL für
  // ad-hoc charter-flights die admin manuell anlegt. Cascade-on-delete:
  // wenn template gelöscht wird, gehen alle daraus generierten instanzen
  // mit (charter-flights bleiben bestehen weil sie kein template haben).
  templateId String?
  template   ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Voll-aufgelöste UTC-departure. Generator berechnet das aus template.
  // validFrom + recurrence-rule (daysOfWeek + departureMinuteUtc) für jeden
  // tag im generation-window. Charter-flights haben das direkt vom admin
  // gesetzt.
  departureTime DateTime

  // Optional preferred airframe — inherited vom template oder direkt am
  // charter gesetzt. Selbe semantik wie ScheduleTemplate.preferredAircraft:
  // informational in 7A, hard-conflict-detection später.
  preferredAircraftId String?
  preferredAircraft   Aircraft? @relation("ScheduledFlightPreferredAircraft", fields: [preferredAircraftId], references: [id], onDelete: SetNull)

  status ScheduledFlightStatus @default(Planned)

  // 1:0..1 zur Booking. Set wenn ein pilot den slot gepickt hat. SetNull-
  // cascade falls Booking gelöscht wird (sollte normalerweise nicht passieren
  // — Bookings werden cancelled, nicht deleted), damit der slot in einem
  // sauberen state landet.
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Häufige queries:
  // - "alle planned flights von airline X in den nächsten N tagen" (pilot-
  //   facing booking-view + admin grid)
  // - "alle flights zu route X, sortiert by departure" (route-detail)
  // - "alle flights die airframe Y nutzen, sortiert by departure" (conflict-
  //   detection beim template-anlegen)
  @@index([airlineId, status, departureTime])
  @@index([routeId, departureTime])
  @@index([preferredAircraftId, departureTime])
  @@index([departureTime])
}

// ─────────────────────────────────────────────────────────────────────────
// Welle 9: ACARS Phase 2-5
// ─────────────────────────────────────────────────────────────────────────

enum Simulator {
  MSFS
  P3D
  XPLANE
  FSX
}

/// Lifecycle-events vom ACARS-client. Stored as audit-trail and used by
/// 9F auto-PIREP-trigger (BLOCK_ON erstellt PIREP-draft). Other events
/// like INCIDENT (HARD_LANDING/STALL/OVERSPEED) sind future flagging-
/// targets.
enum AcarsEventType {
  PHASE_CHANGE
  TOUCHDOWN
  BLOCK_ON
  BLOCK_OFF
  INCIDENT
  CONNECTION_LOST
  CONNECTION_RESUMED
}

/// Temporäre 15-min-codes die der user in der Web-Settings-page generiert
/// und in der ACARS-app eingibt. Nach redeem wird `consumedAt` gesetzt
/// und der code ist verbraucht — neue requests invalidieren alte
/// unbenutzte codes (force-expire über expiresAt-update). Lifecycle:
///   1. user clicks "Pair Device" → row created, expiresAt = now+15min
///   2. user types code in app → app POSTs /api/acars/pairing/redeem
///   3. server validates (exists, not consumed, not expired), generates
///      acarsToken, sets consumedAt
///   4. row stays als audit-record (kann via cleanup-job gelöscht werden
///      wenn DB-bloat — aber bei realistic-volume vernachlässigbar)
model AcarsPairingCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Format: 9 chars in 3-3-3 segments mit unambiguous-alphabet
  // (ohne 0/O/1/I/L), z.B. "X4F-7K2-9PB". Generation in @/lib/acars/pairing.
  code String @unique

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([code])
  @@index([userId, consumedAt])
}

/// Lifecycle + telemetry-events vom ACARS-client. Stored separat von
/// LiveSessionPosition damit positions-stream high-frequency (1-2s) ist
/// und events low-frequency aber semantisch wichtig sind. Payload ist
/// Json damit verschiedene event-types ihre eigenen schemas einbringen
/// können ohne dass jedes feld eigene column kriegt.
///
/// Payload-conventions (app-layer, kein schema-constraint):
///   - PHASE_CHANGE: { from: string, to: string }
///   - TOUCHDOWN: { verticalSpeedFpm, gForce, flapsPercent, indicatedAirspeed }
///   - BLOCK_ON: { totalFlightTimeMin, totalFuelUsedKg, blockTimeMin }
///   - BLOCK_OFF: { fuelOnBoardKg }
///   - INCIDENT: { kind: 'HARD_LANDING'|'STALL'|'OVERSPEED'|'OVERBANK', severity, value }
///   - CONNECTION_LOST: { lastHeartbeatAt, reason }
///   - CONNECTION_RESUMED: { gapSeconds }
///
/// triggeredPirepId ist nur für BLOCK_ON-events gesetzt die einen draft-
/// PIREP erzeugt haben. 1:1 (jedes event triggert max 1 PIREP, jeder
/// auto-erstellte PIREP hat genau 1 source-event).
model AcarsEvent {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type      AcarsEventType
  timestamp DateTime       @default(now())

  payload Json?

  triggeredPirepId String? @unique
  triggeredPirep   Pirep?  @relation("PirepTriggeringEvent", fields: [triggeredPirepId], references: [id], onDelete: SetNull)

  @@index([sessionId, type, timestamp])
}

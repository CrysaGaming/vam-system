# =============================================================================
# VAM System — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in real values.
# All Discord IDs are 18-19 digit Snowflakes from your Discord server.
# =============================================================================

# --- Database (Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/vam_dev?schema=public"
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=vam_dev

# --- Redis (BullMQ + Pub/Sub) ---
REDIS_URL="redis://localhost:6379"

# --- API (NestJS) ---
API_PORT=4000

# --- NextAuth v5 ---
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="your-32-char-secret-here-replace-me"
AUTH_URL="http://localhost:3000"

# --- Email (Resend, optional) ---
# Wenn unkonfiguriert, ist der email-dispatch ein silent no-op
# (in-app notifications funktionieren weiterhin).
# Get an API key at https://resend.com (3000 emails/month free tier).
# Domain-verifizierung empfohlen damit emails nicht via resend.dev versendet
# werden — bis dahin funktioniert der onboarding@resend.dev fallback.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="VAM System <noreply@deine-domain.de>"

# --- Discord OAuth (Web Login) ---
# From: https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID="your-discord-app-client-id"
DISCORD_CLIENT_SECRET="your-discord-app-client-secret"

# --- Discord Bot ---
# From: Developer Portal -> your app -> Bot -> Token (Reset Token)
DISCORD_BOT_TOKEN="your-bot-token-here"

# Server (Guild) ID — Right-click server name -> "Copy Server ID"
# (Requires Discord Developer Mode in User Settings -> Advanced)
DISCORD_GUILD_ID="your-guild-id-here"

# --- Discord Channel IDs ---
# Right-click each channel -> "Copy Channel ID"
DISCORD_CHANNEL_BOT_LOGS="channel-id"
DISCORD_CHANNEL_PIREPS="channel-id"
DISCORD_CHANNEL_RANK_PROMOTIONS="channel-id"
DISCORD_CHANNEL_AWARDS="channel-id"
DISCORD_CHANNEL_ANNOUNCEMENTS="channel-id"
DISCORD_CHANNEL_LIVESTREAMS="channel-id"
DISCORD_CHANNEL_WELCOME="channel-id"

# --- Discord Role IDs ---
# Server Settings -> Roles -> Right-click each role -> "Copy Role ID"
# Staff
DISCORD_ROLE_ADMIN="role-id"
DISCORD_ROLE_HEAD_PILOT="role-id"
DISCORD_ROLE_INSTRUCTOR="role-id"

# Contributors
DISCORD_ROLE_DEVELOPER="role-id"
DISCORD_ROLE_GRAFIKER="role-id"
DISCORD_ROLE_STREAMER="role-id"

# Pilot Ranks (mapped to in-app ranks via apps/bot/src/events/rank-upgraded.ts)
DISCORD_ROLE_CAPTAIN="role-id"
DISCORD_ROLE_FIRST_OFFICER="role-id"
DISCORD_ROLE_TRAINEE="role-id"

# Opt-in Pings
DISCORD_ROLE_EVENT_NOTIFICATIONS="role-id"
DISCORD_ROLE_ANNOUNCEMENTS="role-id"

# --- Bot HTTP Server (Web -> Bot Events) ---
# Bot listens on this port for events from the web app.
# Generate BOT_EVENTS_SECRET in PowerShell with:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
BOT_HTTP_PORT=3001
BOT_EVENTS_SECRET="generate-a-32-byte-base64-secret"
# --- Mapbox (Public Token for Map UI) ---
# From: https://account.mapbox.com/access-tokens/
# Exposed to the client (NEXT_PUBLIC_), so use a URL-restricted public token.
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-public-mapbox-token"

# --- SimBrief API (Pattern Z popup-based dispatch) ---
# Request a Partner-API-Key by emailing contact@simbrief.com.
# Server-side only — NEVER expose to client. Used to compute the md5 hash in
# /api/simbrief/api-code so the key never reaches the browser.
# If unset, Pattern Z dispatch is gracefully disabled and Pattern α
# (full-tab redirect via xml.fetcher.php) remains the available path.
SIMBRIEF_API_KEY=""

# --- AirportDB.io (Pfad-C Fallback Enrichment) ---
# Hobby-service von epranka, basierend auf OurAirports-data. Wird nur als
# fallback genutzt für admin-approved AirportRequests deren ICAO NICHT in
# unserem OurAirports-bulk-import war (z.B. private/military airports).
# Erwartete call-frequenz: 0-5/monat. Get token at https://airportdb.io/.
# Wenn unset → enrichment disabled, neue airports haben keine runway/freq/
# navaid details bis OurAirports ihn nachzieht (täglich aktualisiert).
AIRPORTDB_API_TOKEN=""

# Track 5 #24 (Section E): Web Push VAPID keypair (placeholders).
# Generate echte keys: `pnpm --filter @vam/web exec web-push generate-vapid-keys`
# Wenn leer → push feature gracefully disabled.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:dev@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
